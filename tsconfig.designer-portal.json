{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["astro/client", "node"]
  },
  "include": ["src/designer-portal/**/*.ts", "src/designer-portal/**/*.tsx", "server/designer-portal/**/*.ts", "supabase/functions/designer-portal/**/*.ts"]
}
