---
import Breadcrumb from '../../components/Breadcrumb.astro';
import DesignObject from '../../components/DesignObject.astro';
import ObjectMotionControls from '../../components/ObjectMotionControls.astro';
import { materialStudyKind } from '../../lib/design-study-topic';
import Action from '../../components/Action.astro';
import MaterialFinder from '../../components/MaterialFinder.astro';
import MaterialStudio from '../../components/MaterialStudio.astro';
import Base from '../../layouts/Base.astro';
import { editorialPages, materials, specialismHref, specialisms } from '../../lib/content';
import { breadcrumbNode } from '../../lib/schema';
import Picture from '../../components/Picture.astro';
import makersInstalled from '../../content/makers-installed.json';
import { caseStudies } from '../../lib/content';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Materials', href: '/materials/' },
];
// Published editorial pages under /materials/ (e.g. specified papers we install).
const projectTitle = (href: string) => (href === '/about/' ? 'our About page' : caseStudies.find((c) => `/projects/${c.frontmatter.slug}/` === href)?.frontmatter.title ?? href);
const makerId = (name: string) => `maker-${name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const materialEditorials = editorialPages.map((mod) => mod.frontmatter).filter((fm) => fm.path.startsWith('/materials/'));
---

<Base title={materials.title} description={materials.description} path="/materials/" extraSchema={[breadcrumbNode(crumbs)]}>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{materials.eyebrow}</p>
      <h1>{materials.heading}</h1>
      <p class="lede mt-5">{materials.lede}</p>
      <p class="material-shortlist-note">Saved materials stay on this device. There is no account. If you send an enquiry from this browser, the shortlist is attached.</p>
      <nav class="material-library-nav" aria-label="Explore the material library">
        <a href="#material-finder">Find a family for your room</a>
        <a href="#material-families">Browse the seven families</a>
        <a href="#compare-heading">Compare your shortlist</a>
        <a href="#makers-installed">Makers installed</a>
        <a href="/room-studio/">Wallpaper my room</a>
      </nav>
    </header>
    <section class="material-evidence" aria-labelledby="material-evidence-heading">
      <div>
        <p class="eyebrow">The finish, up close</p>
        <h2 id="material-evidence-heading">Look at the edge.<br />Look at the light.</h2>
        <p>See how real wallcoverings meet a corner, a seam and the joinery. Each detail comes from an installation on our record.</p>
        <Action href="/details/" variant="quiet">Explore the details</Action>
      </div>
      <figure><Picture id="fs-residences-06" sizes="(min-width: 768px) 24rem, 90vw" /><figcaption>Woven grasscloth at an external corner. Four Seasons Private Residences, Ten Trinity Square. Photograph: Mr Wallcover.</figcaption></figure>
    </section>
    <MaterialFinder />
    <section class="material-families" id="material-families" aria-labelledby="material-families-heading">
      <header class="material-section-heading">
        <div><p class="eyebrow">The material library</p><h2 id="material-families-heading">Seven families. Different decisions.</h2></div>
        <ObjectMotionControls label="Illustrative material studies · confirm the actual finish with a sample" />
      </header>
      <ul class="material-family-grid">
        {materials.items.map((item, index) => {
          const service = specialisms.find((entry) => entry.slug === item.specialism);
          return (
            <li class="material-family-card" data-design-hit>
              <header><span class="material-family-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3><a href={`/materials/${item.slug}/`}>{item.name}</a></h3></header>
              <div class:list={['material-family-overview', item.appearance.length > 150 && 'material-family-overview--extended']}>
                <p>{item.appearance}</p>
                <div class="material-family-study"><DesignObject kind={materialStudyKind(item.slug)} /></div>
              </div>
              <div class="material-family-joins"><p class="eyebrow">The joins</p><p>{item.joins}</p></div>
              <div class="material-family-actions">
                <Action variant="secondary" type="button" data-shortlist={item.slug} aria-pressed="false">Save to shortlist</Action>
                {service && <Action variant="quiet" href={specialismHref(service.slug)}>Installation</Action>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
    <section class="material-compare" aria-labelledby="compare-heading">
      <p data-shortlist-status role="status"></p>
      <div class="material-compare-heading"><h2 id="compare-heading" class="m-0 text-[2rem]">Compare the shortlist <span data-shortlist-count>0</span></h2><Action variant="secondary" type="button" data-shortlist-clear>Clear shortlist</Action></div>
      <p data-compare-empty class="lede mt-4">Save two or more families to compare joins, care and where they belong.</p>
      <div class="material-compare-grid">
        {materials.items.map((item) => (
          <article data-compare-row={item.slug} hidden class="border-t border-line pt-4">
            <h3 class="m-0 text-[1.6rem]">{item.name}</h3>
            <p class="m-0 mt-2"><strong>Setting.</strong> {item.setting}</p>
            <p class="m-0 mt-2"><strong>Joins.</strong> {item.joins}</p>
            <p class="m-0 mt-2"><strong>Care.</strong> {item.care}</p>
          </article>
        ))}
      </div>
      <p class="mt-8"><Action variant="primary" href="/contact/?intent=source">Discuss this shortlist</Action></p>
    </section>
    {
      materialEditorials.length > 0 && (
        <section class="mt-16 border-t border-line pt-10" aria-labelledby="makers-heading">
          <p class="eyebrow">Makers</p>
          <h2 id="makers-heading" class="m-0 text-[2rem]">Papers we have installed, by maker.</h2>
          <ul class="m-0 mt-6 grid list-none gap-8 p-0 md:grid-cols-2">
            {materialEditorials.map((fm) => (
              <li class="border-t border-line pt-4">
                <h3 class="m-0 text-[1.8rem]"><a href={fm.path}>{fm.title}</a></h3>
                <p class="mt-3 mb-0 text-stone">{fm.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="mt-16 border-t border-line pt-10" aria-labelledby="installed-heading" id="makers-installed">
      <p class="eyebrow">Makers installed</p>
      <h2 id="installed-heading" class="m-0 text-[2rem]">Makers we have installed, in our own photographs.</h2>
      <p class="mt-4 mb-0 max-w-3xl text-stone">Each maker below is shown with one of our photographs of its product on the wall, linked to the project where the project is public. Private projects are named only by area. A maker named here means Mr Wallcover installed that maker's product; it is not an approval, accreditation or endorsement.</p>
      <ul class="material-makers-grid">
        {makersInstalled.items.map((item) => (
          <li class="border-t border-line pt-4" id={makerId(item.brand)}>
            <Picture id={item.image} sizes="(min-width: 1024px) 18rem, (min-width: 640px) 45vw, 100vw" />
            <h3 class="mt-3 mb-0 text-[1.4rem]">{item.brand}</h3>
            {item.projects.length > 0 ? (
              <p class="mt-1 mb-0 text-stone">Installed at {item.projects.map((href, i) => <>{i > 0 && ' · '}<a href={href}>{projectTitle(href)}</a></>)}.</p>
            ) : (
              <p class="mt-1 mb-0 text-stone">Installed at {item.where}, {item.year}. <a href={item.source} rel="noopener">Our post</a>.</p>
            )}
            {(item as { page?: string }).page && <p class="mt-1 mb-0"><a href={(item as { page?: string }).page}>How we install {item.brand}</a></p>}
          </li>
        ))}
      </ul>
    </section>

  </div>
  <MaterialStudio />
</Base>

<style>
  .material-shortlist-note { max-width: 64ch; margin: 1.25rem 0 0; color: var(--color-stone); }
  .material-library-nav { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-block: 1rem; border-block: 1px solid var(--color-line); margin-top: 2rem; }
  .material-library-nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-ink); font-size: var(--text-button); text-underline-offset: .2em; }
  .material-section-heading { display: grid; align-items: end; gap: 1rem; padding-bottom: 1.5rem; }
  .material-section-heading h2 { margin: 0; max-width: 24ch; font-size: clamp(2rem, 3vw, 2.7rem); }
  .material-families { scroll-margin-top: 8rem; }
  .material-family-grid { display: grid; gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
  .material-family-card { container-type: inline-size; display: flex; flex-direction: column; padding: clamp(1.25rem, 3vw, 2rem); background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-control); min-width: 0; }
  .material-family-card header { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-line); }
  .material-family-number { flex-shrink: 0; color: var(--color-brass); font-size: var(--text-label); letter-spacing: .08em; }
  .material-family-card h3 { margin: 0; font-size: clamp(1.7rem, 2.3vw, 2rem); }
  .material-family-overview { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 1rem; align-items: center; }
  .material-family-overview > p { margin: 1rem 0; color: var(--color-stone); }
  .material-family-study { min-width: 0; width: 100%; max-width: var(--object-card-size); margin: .5rem auto; }
  .material-family-joins { margin-block: .5rem 1.5rem; }
  .material-family-joins > p { margin: 0; }
  .material-family-joins > .eyebrow { margin-bottom: .6rem; }
  .material-family-actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--color-line); }
  .material-compare { padding: clamp(1.25rem, 3vw, 2rem); margin-top: 2.5rem; border: 1px solid var(--color-line); background: var(--color-paper); scroll-margin-top: 8rem; }
  .material-compare > [data-shortlist-status]:empty { display: none; }
  .material-compare-heading { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .material-compare-grid { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .material-compare-grid > article { min-width: 0; }
  .material-makers-grid { display: grid; gap: 2rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .material-makers-grid :global(.media-img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 640px) { .material-makers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .material-section-heading { grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: 3rem; }
    .material-family-grid, .material-compare-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .material-makers-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @container (max-width: 28rem) {
    .material-family-overview--extended { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .material-family-overview--extended > p { margin-bottom: 0; }
    .material-family-overview--extended .material-family-study { max-width: 18rem; margin-block: .75rem; }
  }
  @media (max-width: 374px) { .material-family-overview:not(.material-family-overview--extended) { grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: .6rem; } }
</style>

<script>
  import '../../scripts/shortlist';
</script>
