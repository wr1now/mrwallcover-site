---
import { guides, guideHref } from '../../lib/guides';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Base from '../../layouts/Base.astro';
import { materials, projectHref, projects, specialismHref, specialisms } from '../../lib/content';
import { breadcrumbNode } from '../../lib/schema';
import Picture from '../../components/Picture.astro';
import materialDepthJson from '../../content/material-depth.json';
import makersInstalled from '../../content/makers-installed.json';

export function getStaticPaths() {
  return materials.items.map((material) => ({ params: { slug: material.slug }, props: { material } }));
}

const { material } = Astro.props;
const service = specialisms.find((entry) => entry.slug === material.specialism);
const relatedGuides = guides.filter((guide) => material.decision.relatedGuides.includes(guide.frontmatter.slug));
// On the record (src/content/material-depth.json): the family's own case studies first, then the original three, so no link is lost.
const depth = (materialDepthJson.items as Record<string, { makers: string[]; projects: string[]; paragraphs: string[] }>)[material.slug];
const ownProjects = (depth?.projects ?? []).map((slug) => {
  const project = projects.find((entry) => entry.slug === slug && entry.caseStudy);
  if (!project) throw new Error(`material-depth.json: ${material.slug} names "${slug}", which is not a published case study`);
  return project;
});
const related = [...ownProjects, ...projects.filter((project) => project.caseStudy).slice(0, 3).filter((project) => !ownProjects.includes(project))];
const makers = (depth?.makers ?? []).map((brand) => {
  const item = makersInstalled.items.find((entry) => entry.brand === brand);
  if (!item) throw new Error(`material-depth.json: ${material.slug} names maker "${brand}", which is not in makers-installed.json`);
  return item;
});
/** Split a paragraph into text and [label](href) link segments, as LandingBody does. Content is our own JSON. */
function segments(text: string) {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const m of text.matchAll(/\[([^\]]+)\]\(([^)\s]+)\)/g)) {
    if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
}
const projectTitle = (href: string) => projects.find((entry) => projectHref(entry.slug) === href)?.title ?? (href === '/about/' ? 'About' : href);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Materials', href: '/materials/' },
  { name: material.name, href: `/materials/${material.slug}/` },
];
---

<Base
  title={material.metaTitle ?? `${material.name} | Mr Wallcover`}
  description={(material as { metaDescription?: string }).metaDescription ?? material.appearance}
  path={`/materials/${material.slug}/`}
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page pb-20">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">Material family</p>
      <h1>{material.name}</h1>
      <p class="lede mt-5">{material.appearance}</p>
    </header>
    <div class="reading grid gap-10 md:grid-cols-12">
      <div class="prose md:col-span-7">
        <dl class="material-decision"><dt>Consider it when</dt><dd>{material.decision.considerWhen}</dd><dt>The trade-off</dt><dd>{material.decision.tradeoff}</dd><dt>Before ordering</dt><dd>{material.decision.checkBeforeOrdering}</dd></dl>
        <h2>Joins</h2>
        <p>{material.joins}</p>
        <h2>Where it belongs</h2>
        <p>{material.setting}</p>
        <h2>Handling</h2>
        <p>{material.handling}</p>
        <h2>Care</h2>
        <p>{material.care}</p>
        {depth && <h2>On the record</h2>}
        {depth?.paragraphs.map((paragraph) => <p>{segments(paragraph).map((seg) => (seg.href ? <a href={seg.href}>{seg.text}</a> : seg.text))}</p>)}
        <p>Digital colour is a guide. Order a cutting or a sample before you commit to a room. We can install material you have already bought, or source a family and install it. Either way, the next step is a short note about the room.</p>
      </div>
      <aside class="md:col-span-4 md:col-start-9">
        <button class="btn btn-solid-ink" type="button" data-shortlist={material.slug} aria-pressed="false">Save to shortlist</button>
        <p class="mt-4 text-stone">Saved on this device only.</p>
        <p data-shortlist-status role="status"></p>
        <p class="mt-4"><a class="btn btn-line" href={`/contact/?intent=source`}>Discuss this material</a></p>
        <p class="mt-3"><a class="btn btn-line" href="/contact/?intent=install">I already have it</a></p>
        {service && <p class="mt-3"><a href={specialismHref(service.slug)}>How we install it</a></p>}
        {relatedGuides.length > 0 && <section class="mt-8"><h2 class="text-[1.4rem]">Useful reading</h2><ul>{relatedGuides.map((guide) => <li class="my-3"><a href={guideHref(guide.frontmatter.slug)}>{guide.frontmatter.shortTitle}</a></li>)}</ul></section>}
        <h2 class="mt-8 text-[1.4rem]">Selected work</h2>
        <ul class="m-0 grid list-none gap-2 p-0">
          {related.map((project) => (
            <li><a href={projectHref(project.slug)}>{project.title}</a></li>
          ))}
        </ul>
      </aside>
    </div>
    {
      makers.length > 0 && (
        <section class="mt-16 border-t border-line pt-10" aria-labelledby="family-makers-heading">
          <p class="eyebrow">Makers installed</p>
          <h2 id="family-makers-heading" class="m-0 text-[2rem]">{material.name}: makers we have hung</h2>
          <p class="mt-4 mb-0 max-w-3xl text-stone">Each in our own photograph of its product on the wall. A maker named here means Mr Wallcover installed that maker's product; it is not an approval, accreditation or endorsement.</p>
          <ul class="m-0 mt-8 grid list-none gap-8 p-0 sm:grid-cols-2 lg:grid-cols-4">
            {makers.map((item) => (
              <li class="border-t border-line pt-4">
                <Picture id={item.image} sizes="(min-width: 1024px) 18rem, (min-width: 640px) 45vw, 100vw" />
                <h3 class="mt-3 mb-0 text-[1.4rem]">{item.brand}</h3>
                {item.projects.length > 0 ? (
                  <p class="mt-1 mb-0 text-stone">Installed at {item.projects.map((href, i) => <>{i > 0 && ' · '}<a href={href}>{projectTitle(href)}</a></>)}.</p>
                ) : (
                  <p class="mt-1 mb-0 text-stone">Installed at {item.where}, {item.year}. <a href={item.source} rel="noopener">Our post</a>.</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script>
  import '../../scripts/shortlist';
</script>
