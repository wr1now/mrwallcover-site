---
import { guides, guideHref } from '../../lib/guides';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Base from '../../layouts/Base.astro';
import { materials, media, projectHref, projects, specialismHref, specialisms } from '../../lib/content';
import { breadcrumbNode } from '../../lib/schema';
import Picture from '../../components/Picture.astro';
import Action from '../../components/Action.astro';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import DesignStudy from '../../components/DesignStudy.astro';
import { materialStudyKind } from '../../lib/design-study-topic';
import materialDepthJson from '../../content/material-depth.json';
import makersInstalled from '../../content/makers-installed.json';

export function getStaticPaths() {
  return materials.items.map((material) => ({ params: { slug: material.slug }, props: { material } }));
}

const { material } = Astro.props;
const evidenceImage = material.evidence ? media(material.evidence.id) : undefined;
const service = specialisms.find((entry) => entry.slug === material.specialism);
const relatedGuides = guides.filter((guide) => material.decision.relatedGuides.includes(guide.frontmatter.slug));
// On the record (src/content/material-depth.json): the family's own case studies first, then the original three, so no link is lost.
const depth = (materialDepthJson.items as Record<string, { makers: string[]; projects: string[]; paragraphs: string[] }>)[material.slug];
const ownProjects = (depth?.projects ?? []).map((slug) => {
  const project = projects.find((entry) => entry.slug === slug && entry.caseStudy);
  if (!project) throw new Error(`material-depth.json: ${material.slug} names "${slug}", which is not a published case study`);
  return project;
});
const related = [...ownProjects, ...projects.filter((project) => project.caseStudy).slice(0, 3).filter((project) => !ownProjects.includes(project))];
const makers = (depth?.makers ?? []).map((brand) => {
  const item = makersInstalled.items.find((entry) => entry.brand === brand);
  if (!item) throw new Error(`material-depth.json: ${material.slug} names maker "${brand}", which is not in makers-installed.json`);
  return item;
});
/** Split a paragraph into text and [label](href) link segments, as LandingBody does. Content is our own JSON. */
function segments(text: string) {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const m of text.matchAll(/\[([^\]]+)\]\(([^)\s]+)\)/g)) {
    if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
}
const projectTitle = (href: string) => projects.find((entry) => projectHref(entry.slug) === href)?.title ?? (href === '/about/' ? 'About' : href);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Materials', href: '/materials/' },
  { name: material.name, href: `/materials/${material.slug}/` },
];
---

<Base
  title={material.metaTitle ?? `${material.name} | Mr Wallcover`}
  description={(material as { metaDescription?: string }).metaDescription ?? material.appearance}
  path={`/materials/${material.slug}/`}
  image={evidenceImage?.src}
  imageAlt={evidenceImage?.alt}
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page pb-20">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">Material family</p>
      <h1>{material.name}</h1>
      <p class="lede mt-5">{material.appearance}</p>
    </header>
    <section class:list={['material-study', material.evidence && 'material-study--illustrated']} aria-label={`${material.name}: a closer look`}>
      {material.evidence && <EvidenceFigure {...material.evidence} ratio="landscape" sizes="(min-width: 1024px) 32rem, (min-width: 768px) 45vw, calc(100vw - 2.5rem)" />}
      <div class="material-study-decisions">
        <p class="eyebrow">Before you choose</p>
        <dl class="material-decision"><dt>Consider it when</dt><dd>{material.decision.considerWhen}</dd><dt>The trade-off</dt><dd>{material.decision.tradeoff}</dd><dt>Before ordering</dt><dd>{material.decision.checkBeforeOrdering}</dd></dl>
      </div>
    </section>
    <div class="material-practical-layout reading">
      <div class="material-practical-content">
        <div class="material-practical-facts">
          <section><p class="eyebrow">01 · The finish</p><h2>Joins</h2><p>{material.joins}</p></section>
          <section><p class="eyebrow">02 · The setting</p><h2>Where it belongs</h2><p>{material.setting}</p></section>
          <section><p class="eyebrow">03 · Installation</p><h2>Handling</h2><p>{material.handling}</p></section>
          <section><p class="eyebrow">04 · Living with it</p><h2>Care</h2><p>{material.care}</p></section>
        </div>
        <p class="material-sample-note">Digital colour is a guide. Order a cutting or a sample before you commit to a room. We can install material you have already bought, or source a family and install it. Either way, the next step is a short note about the room.</p>
      </div>
      <aside class="material-enquiry-rail" aria-label="Save or discuss this material">
        <DesignStudy kind={materialStudyKind(material.slug)} caption="Illustrative material study · confirm the actual finish with a sample" />
        <div class="material-enquiry-actions">
          <Action variant="secondary" type="button" data-shortlist={material.slug} aria-pressed="false">Save to shortlist</Action>
          <p class="material-save-note">Saved on this device only.</p>
          <p data-shortlist-status role="status"></p>
          <Action variant="primary" href="/contact/?intent=source">Discuss this material</Action>
          <Action variant="secondary" href="/contact/?intent=install">I already have it</Action>
          {service && <p class="material-install-link"><a href={specialismHref(service.slug)}>How we install it</a></p>}
        </div>
      </aside>
    </div>
    {depth && <section class="material-record" aria-labelledby="material-record-heading">
      <header><p class="eyebrow">Installation experience</p><h2 id="material-record-heading">On the record</h2></header>
      <div class="prose">{depth.paragraphs.map((paragraph) => <p>{segments(paragraph).map((seg) => (seg.href ? <a href={seg.href}>{seg.text}</a> : seg.text))}</p>)}</div>
    </section>}
    <nav class="material-further" aria-label="Related material reading and projects">
      {relatedGuides.length > 0 && <section><p class="eyebrow">Plan the detail</p><h2>Useful reading</h2><ul>{relatedGuides.map((guide) => <li><a href={guideHref(guide.frontmatter.slug)}>{guide.frontmatter.shortTitle}</a></li>)}</ul></section>}
      <section><p class="eyebrow">From our portfolio</p><h2>Selected work</h2><ul>{related.map((project) => <li><a href={projectHref(project.slug)}>{project.title}</a></li>)}</ul></section>
    </nav>
    {
      makers.length > 0 && (
        <section class="mt-16 border-t border-line pt-10" aria-labelledby="family-makers-heading">
          <p class="eyebrow">Makers installed</p>
          <h2 id="family-makers-heading" class="m-0 text-[2rem]">{material.name}: makers we have hung</h2>
          <p class="mt-4 mb-0 max-w-3xl text-stone">Each in our own photograph of its product on the wall. A maker named here means Mr Wallcover installed that maker's product; it is not an approval, accreditation or endorsement.</p>
          <ul class="material-maker-records">
            {makers.map((item) => (
              <li class="border-t border-line pt-4">
                <Picture id={item.image} sizes="(min-width: 1024px) 18rem, (min-width: 640px) 45vw, 100vw" />
                <h3 class="mt-3 mb-0 text-[1.4rem]">{item.brand}</h3>
                {item.projects.length > 0 ? (
                  <p class="mt-1 mb-0 text-stone">Installed at {item.projects.map((href, i) => <>{i > 0 && ' · '}<a href={href}>{projectTitle(href)}</a></>)}.</p>
                ) : (
                  <p class="mt-1 mb-0 text-stone">Installed at {item.where}, {item.year}. <a href={item.source} rel="noopener">Our post</a>.</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .material-study { margin-bottom: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--color-line); }
  .material-study--illustrated { display: grid; gap: 2rem; align-items: start; }
  .material-study-decisions { min-width: 0; padding: clamp(1.25rem, 3vw, 2rem); background: var(--color-paper); border: 1px solid var(--color-line); }
  .material-study-decisions .material-decision { margin: 0; padding: 0; border: 0; }
  .material-decision dt { padding-top: 1.1rem; margin-top: 1.1rem; border-top: 1px solid var(--color-line); color: var(--color-brass); }
  .material-decision dd { margin: .5rem 0 0; }
  .material-practical-layout { display: grid; gap: 2.5rem; align-items: start; }
  .material-practical-content { min-width: 0; }
  .material-practical-facts { display: grid; gap: 1.5rem 2.5rem; }
  .material-practical-facts section { min-width: 0; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .material-practical-facts section > .eyebrow { margin: 0 0 .75rem; }
  .material-practical-facts h2 { margin: 0 0 1rem; font-size: clamp(1.85rem, 2.5vw, 2.2rem); }
  .material-practical-facts section > p:last-child { margin: 0; max-width: 56ch; }
  .material-sample-note { max-width: var(--layout-reading, 44rem); margin: 2rem 0 0; padding: 1.5rem; border-left: 2px solid var(--color-brass); background: var(--color-paper); }
  .material-enquiry-rail { min-width: 0; border: 1px solid var(--color-line); background: var(--color-paper); padding: 1rem clamp(1.25rem, 2vw, 1.75rem) 1.75rem; }
  .material-enquiry-rail :global(.design-study) { margin: 0 auto 1rem; }
  .material-enquiry-actions { display: flex; flex-direction: column; gap: .75rem; align-items: stretch; border-top: 1px solid var(--color-line); padding-top: 1.25rem; }
  .material-enquiry-actions :global(.mw-action) { justify-content: center; }
  .material-save-note { margin: -.2rem 0 .5rem; color: var(--color-stone); font-size: var(--text-meta); }
  .material-enquiry-actions [data-shortlist-status] { margin: 0; }
  .material-enquiry-actions [data-shortlist-status]:empty { display: none; }
  .material-install-link { margin: .3rem 0 0; }
  .material-record { display: grid; gap: 1.5rem; margin-top: clamp(3rem, 6vw, 5rem); padding-block: 2.5rem; border-top: 1px solid var(--color-line); }
  .material-record h2 { margin: 0; font-size: clamp(2rem, 3vw, 2.7rem); }
  .material-record .prose > p:first-child { margin-top: 0; }
  .material-further { display: grid; gap: 2rem; padding-block: 2.5rem; border-block: 1px solid var(--color-line); }
  .material-further h2 { margin: 0 0 1rem; font-size: 2rem; }
  .material-further ul { margin: 0; padding: 0; list-style: none; }
  .material-further li { border-top: 1px solid var(--color-line); }
  .material-further li a { display: flex; align-items: center; min-height: 48px; padding-block: .7rem; text-underline-offset: .2em; }
  .material-maker-records { display: grid; gap: 2rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .material-maker-records :global(.media-img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 640px) { .material-practical-facts, .material-maker-records, .material-further { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 768px) { .material-study--illustrated { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); } }
  @media (min-width: 1024px) {
    .material-practical-layout { grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); }
    .material-practical-facts { grid-template-columns: 1fr; gap: 1.5rem; }
    .material-record { grid-template-columns: minmax(0, .8fr) minmax(0, 1.35fr); gap: clamp(2rem, 5vw, 5rem); }
    .material-maker-records { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

<script>
  import '../../scripts/shortlist';
</script>
