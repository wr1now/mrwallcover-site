---
import EnquiryForm from '../components/EnquiryForm.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Action from '../components/Action.astro';
import EvidenceFigure from '../components/EvidenceFigure.astro';
import TechnicalDiagram from '../components/TechnicalDiagram.astro';
import DesignStudy from '../components/DesignStudy.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { aftercare, media } from '../lib/content';
import BuyerFaq from '../components/BuyerFaq.astro';
import { buyerFaqFor } from '../lib/ai-layer-data';
import { breadcrumbNode, buyerFaqNode, serviceNodes } from '../lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Aftercare', href: '/aftercare/' },
];

const blocks = [aftercare.inspection, aftercare.seams, aftercare.callout, aftercare.humidity];
const careIcons: Record<string, IconName> = {'Silk':'swatch', 'Grasscloth and natural weaves':'layers', 'Fabric walling':'layers', 'Vinyl and contract wallcoverings':'roll', 'Hand-painted papers':'drawing', 'Murals':'drawing', 'Acoustic wallcoverings and panels':'layers'};
// The visible questions below and the FAQPage node are read from the same list.
const faq = buyerFaqFor('/aftercare/');
const detailImage = media('fs-residences-06');
---

<Base
  title={aftercare.title}
  description={aftercare.description}
  path="/aftercare/"
  image={detailImage.src}
  imageAlt={detailImage.alt}
  extraSchema={[
    ...serviceNodes([
      {
        title: 'Wallcovering aftercare',
        paragraphs: [aftercare.lede],
      },
    ]),
    breadcrumbNode(crumbs),
    ...(faq.length ? [buyerFaqNode(faq)] : []),
  ]}
>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{aftercare.eyebrow}</p>
      <h1>{aftercare.heading}</h1>
      <p class="lede mt-5">{aftercare.lede}</p>
      <div class="mt-6 flex flex-wrap gap-3"><Action href="#support">Request aftercare</Action><Action variant="secondary" href="#guarantee-band">Read the workmanship guarantee</Action></div>
    </header>
    <div class="aftercare-evidence">
      <EvidenceFigure id="fs-residences-06" caption="A woven wallcovering turning an external corner at the Four Seasons residences, Ten Trinity Square. A finished edge is part of the detail checked at handover and at the return visit." credit="Mr Wallcover project photograph." href="/projects/four-seasons-ten-trinity-square/" linkLabel="See the Four Seasons project" sizes="(min-width: 768px) 36rem, calc(100vw - 2.5rem)" />
      <div>
        <DesignStudy kind="junction" caption="Illustrative detail. The return visit includes the finished edges and the wallcovering's turn around a corner." />
        <details class="inspection-schematic"><summary>View the inspection points</summary><TechnicalDiagram kind="inspection" caption="The return visit looks at seams, edges, corners and covered joinery. A visible natural seam and a seam that has lifted are different things." /></details>
      </div>
    </div>
  </div>

  {
    blocks.map((block) => (
      <section class="border-t border-line">
        <div class="container-page grid gap-6 py-12 md:grid-cols-12 md:py-16">
          <h2 class="m-0 text-[clamp(2rem,3vw,2.8rem)] md:col-span-4">{block.title}</h2>
          <div class="prose md:col-span-7 md:col-start-6">
            {block.paragraphs.map((paragraph) => (
              <p class="m-0">{paragraph}</p>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="border-t border-line bg-paper" aria-labelledby="care-heading">
    <div class="container-page py-14 md:py-20">
      <h2 id="care-heading" class="m-0 max-w-xl text-[clamp(2rem,3vw,2.8rem)]">{aftercare.care.title}</h2>
      <p class="lede mt-4">{aftercare.care.intro}</p>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {
          aftercare.care.items.map((item) => (
            <article class="border-t border-line pt-4">
              <span class="care-material-icon"><Icon name={careIcons[item.title] ?? 'swatch'} /></span>
              <h3 class="m-0 text-[1.7rem]">{item.title}</h3>
              <p class="mt-3 mb-0 text-stone">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="border-t border-line">
      <div class="container-page py-14 md:py-20">
        <div class="aftercare-questions">
          <BuyerFaq items={faq} />
        </div>
      </div>
    </section>
  )}

  <section id="guarantees" class="border-t border-line" aria-labelledby="guarantees-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">{aftercare.assurance.eyebrow}</p>
      <h2 id="guarantees-heading" class="m-0 max-w-xl text-[clamp(2rem,3vw,2.8rem)]">{aftercare.assurance.title}</h2>
      <p class="lede mt-4 max-w-3xl">{aftercare.assurance.intro}</p>
      <dl class="mt-8 grid gap-x-10 gap-y-6 md:grid-cols-2" style="margin-left:0">
        {aftercare.assurance.items.map((item) => (
          <div class="border-t border-line pt-4">
            <dt style="font-weight:500">{item.title}</dt>
            <dd class="m-0 mt-2">{item.text}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 mb-0"><a href="#guarantee-band">The twelve-month workmanship guarantee</a> · <a href="/professionals/developers/">Working with main contractors</a></p>
    </div>
  </section>

  <section id="support" class="border-t border-line">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Support</p>
      <h2 class="m-0 max-w-xl text-[clamp(2rem,3vw,2.8rem)]">Send a note about existing work.</h2>
      <p class="lede mt-4">Use this for a seam, a repair, or a question about a finished room. It is kept apart from a new installation enquiry. Send a photograph and we will say whether it is the hang, a knock or the building before anything else.</p>
      <div class="mt-8 max-w-2xl">
        <EnquiryForm variant="aftercare" />
      </div>
    </div>
  </section>

  <section id="guarantee-band" class="band-dark on-dark">
    <div class="container-page py-16 md:py-20">
      <h2 class="m-0 max-w-xl text-[clamp(2rem,3vw,2.8rem)]">{aftercare.guarantee.title}</h2>
      <div class="prose mt-6">
        {
          aftercare.guarantee.paragraphs.map((paragraph) => (
            <p class="m-0 text-[#efe7da]">{paragraph}</p>
          ))
        }
      </div>
      <Action variant="secondary" class="mt-8" href="/contact/">Start your project</Action>
    </div>
  </section>
</Base>

<style>
  .aftercare-evidence { display: grid; gap: 2rem; align-items: center; padding-bottom: 3.5rem; }
  .care-material-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-bottom: .9rem; color: var(--color-brass); border: 1px solid var(--color-line); border-radius: 50%; }
  .inspection-schematic { margin-top:1rem; border-top:1px solid var(--color-line); }
  .inspection-schematic summary { cursor:pointer; min-height:44px; padding-block:.75rem; }
  @media (min-width: 768px) { .aftercare-evidence { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); } }
</style>
