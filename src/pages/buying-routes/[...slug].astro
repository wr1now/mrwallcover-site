---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MakerDirectoryNav from '../../components/MakerDirectoryNav.astro';
import MakerDirectoryFilter from '../../components/MakerDirectoryFilter.astro';
import MakerRoute from '../../components/MakerRoute.astro';
import { makerDirectory, directoryVisible, directoryReview, directoryRoutes } from '../../lib/makers-directory';
import { breadcrumbNode } from '../../lib/schema';
import '../../styles/makers-directory.css';
export function getStaticPaths(){return directoryVisible?[{params:{slug:undefined}}]:[];}
const crumbs=[{name:'Home',href:'/'},{name:'Wallcovering Guide',href:'/advice/'},{name:'Buying routes',href:'/buying-routes/'}];
---
<Base title="Official Wallcovering Buying Routes | Mr Wallcover" description="Find official wallcovering shops, showroom contacts, trade enquiries and sample routes, with geographic limits and dated sources before ordering." path="/buying-routes/" updated={makerDirectory.updated} noindex={directoryReview} extraSchema={[breadcrumbNode(crumbs)]}>
<div class="container-page pb-20"><header class="page-head maker-intro"><Breadcrumb items={crumbs}/><p class="eyebrow">The Wallcovering Guide · Source</p><h1>The right way in.</h1><p class="lede mt-5">A sample request, showroom contact and wallpaper order are different things. Start with the maker’s official route and check who can buy, where it can be delivered and which terms apply.</p><p>No paid placement, affiliate ranking or individual seller endorsement. Country selectors and the maker’s current product and destination terms take precedence.</p>{directoryReview&&<p class="maker-review-note">Editorial review preview. Copy approved by the owner on 18 October 2026; these links are not proof of fulfilled orders.</p>}</header><MakerDirectoryNav/><MakerDirectoryFilter kind="routes" makers={makerDirectory.makers}/><div class="maker-route-grid">{directoryRoutes.map(route=><MakerRoute route={route} makerName={route.makerName} makerSlug={route.makerSlug}/>)}</div></div>
</Base>
