---
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqList from '../components/FaqList.astro';
import Base from '../layouts/Base.astro';
import { allFaqItems, faq, faqGroups, faqItems } from '../lib/content';
import { breadcrumbNode, faqNode } from '../lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Questions', href: '/faq/' },
];
---

<Base
  title={faq.title}
  description={faq.description}
  path="/faq/"
  extraSchema={[faqNode(allFaqItems), breadcrumbNode(crumbs)]}
>
  <div class="container-page">
    <header class="page-head pb-0">
      <Breadcrumb items={crumbs} />
    </header>
  </div>
  <FaqList items={faqItems} groups={faqGroups} coreHeading={(faq as { coreHeading?: string }).coreHeading} eyebrow={faq.eyebrow} heading={faq.heading} lede={faq.lede} titleLevel="h1" />
</Base>
