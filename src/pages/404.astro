---
import Base from '../layouts/Base.astro';
import utility from '../content/utility.json';
---

<Base title={utility.notFound.title} description={utility.notFound.description} path="/404/" noindex={true}>
  <div class="container-page py-20">
    <p class="eyebrow">404</p>
    <h1 class="m-0 text-[clamp(2.6rem,6vw,4.2rem)]">{utility.notFound.heading}</h1>
    <p class="lede mt-5">{utility.notFound.text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-solid-ink" href="/">Home</a>
      <a class="btn btn-line" href="/projects/">Work</a>
      <a class="btn btn-line" href="/contact/">Contact</a>
    </div>
  </div>
</Base>

<script is:inline>
  // GitHub Pages serves this page for any unknown URL. A retired project URL (one that is no
  // longer a page and cannot be named in the source) goes to the work index instead of a dead end.
  if (/^\/projects\/[a-z0-9-]+\/?$/.test(location.pathname)) location.replace('/projects/');
</script>
