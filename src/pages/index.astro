---
import facts from '../data/facts.json';
import Hero from '../components/Hero.astro';
import Picture from '../components/Picture.astro';
import MaterialStudio from '../components/MaterialStudio.astro';
import Base from '../layouts/Base.astro';
import { home, faqItems, projects, projectHref, videoById } from '../lib/content';
import { AWARD_TEXT, AWARD_URL, faqNode } from '../lib/schema';
import '../styles/atelier.css';
// The hero's one extra rule (home-hero.css) is inlined in <head>. Every other homepage rule, the restored sections
// and the showcase included, is in atelier.css, so the page is styled by one sheet before first paint.
import homeHeroCss from '../styles/home-hero.css?raw';
const selection = [
  { slug: 'raffles-london-the-owo', label: 'Raffles London at The OWO', type: 'Hospitality', image: 'owo-official-classic', credit: 'Venue photograph · Raffles London at The OWO (official)' },
  { slug: 'trematon-castle', label: 'The Castle of Trematon', type: 'Historic interiors', image: 'trematon-01', credit: '' },
  { slug: 'calico-beverly-1975-cadence', label: 'Calico × BEVERLY 1975', type: 'Design & culture', image: 'beverly-08', credit: '' },
].map(item => ({...item, project: projects.find(p => p.slug === item.slug)!}));
// Restored from 1b387c6 (the homepage before #23): every published case study stays on the homepage.
const shownSlugs = new Set(['browns-hotel-mayfair', ...selection.map((item) => item.slug)]);
const moreWork = projects.filter((project) => project.featured && !shownSlugs.has(project.slug));
const alsoOnRecord = projects.filter((project) => !project.featured && !shownSlugs.has(project.slug));
const calicoProjects = projects.filter((project) => project.group === 'design-weeks');
const calicoLabel = (project: (typeof projects)[number]) =>
  project.slug === 'heathrow-terminal-4-calico' ? 'Calico Wallpaper at Heathrow Terminal 4' : project.title.replace(/: '?([^']+)'? at .*$/, ': $1');
// Top-of-page showcase: one large finished-room photograph per hotel and historic commission.
// Our own photographs first; a credited venue image only where we have no finished-room photo of our own.
const showcase = [
  { slug: 'browns-hotel-mayfair', name: 'Brown’s Hotel', place: 'Mayfair', image: 'browns-hotel-mayfair-10', credit: '' },
  { slug: 'raffles-london-the-owo', name: 'Raffles London at The OWO', place: 'Whitehall', image: 'owo-official-junior-suite', credit: 'Image: Raffles London at The OWO (official)' },
  { slug: 'four-seasons-ten-trinity-square', name: 'Four Seasons, Ten Trinity Square', place: 'Private Residences, City of London', image: 'fs-residences-01' },
  { slug: 'old-bailey-hotel', name: 'Hyde London City', place: 'Old Bailey', image: 'old-bailey-06', credit: '' },
  { slug: 'heathrow-terminal-4-calico', name: 'Calico Wallpaper at Heathrow', place: 'Terminal 4', image: 'heathrow-05', credit: '' },
  { slug: 'trematon-castle', name: 'The Castle of Trematon', place: 'Cornwall', image: 'trematon-01', credit: '' },
  { slug: 'house-of-hackney-st-michaels', name: 'House of Hackney', place: 'St Michael’s Clergy House', image: 'house-of-hackney-st-michaels-06', credit: '' },
].filter((item) => projects.some((p) => p.slug === item.slug));
const hotelNames = [
  {name: "Brown’s Hotel", place: 'MAYFAIR', href: '/projects/browns-hotel-mayfair/'},
  {name: 'Raffles London', place: 'THE OWO', href: '/projects/raffles-london-the-owo/'},
  {name: 'Four Seasons', place: 'TEN TRINITY SQUARE', href: '/projects/four-seasons-ten-trinity-square/'},
  {name: 'Hyde London City', place: 'OLD BAILEY', href: '/projects/old-bailey-hotel/'},
];
---
<Base title={home.title} description={facts.description} path="/" preloadHero extraSchema={[faqNode(faqItems)]} image="/media/atelier/browns-bedroom-2000.jpg" imageAlt="Our completed wallcovering installation at Brown's Hotel, Mayfair.">
  <style is:inline slot="head" set:html={homeHeroCss}></style>
  <div class="atelier">
    <section class="atelier-hero" aria-labelledby="hero-heading">
      <Hero />
      <div class="atelier-hero-shade" aria-hidden="true"></div>
      <div class="atelier-hero-content">
        <p class="atelier-kicker light">{home.hero.eyebrow}</p>
        <h1 id="hero-heading">{home.hero.titleLead}<br /><em>{home.hero.titleEm}</em></h1>
        <p class="atelier-hero-description">{home.hero.lede}</p>
        <p class="atelier-hero-award hero-award"><a href={AWARD_URL} rel="noopener">{AWARD_TEXT}</a></p>
        <div class="atelier-hero-actions">
          <a class="atelier-button cream" href="/projects/">Explore our work <span aria-hidden="true">↗</span></a>
          <a class="atelier-button ghost" href="/contact/">Start your project <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="atelier-hero-foot">
        <span>LONDON & SELECTED UK PROJECTS</span>
        <a href="/projects/browns-hotel-mayfair/"><span>ON LOCATION</span> Brown’s Hotel, Mayfair <b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <section class="home-showcase" aria-labelledby="showcase-heading">
      <div class="home-showcase-head">
        <p class="atelier-kicker">Hotels and historic commissions</p>
        <h2 id="showcase-heading">Rooms we have <em>finished.</em></h2>
      </div>
      <ul class="home-showcase-strip" role="list">
        {showcase.map((item) => (
          <li class="home-showcase-item">
            <a class="home-showcase-image" href={projectHref(item.slug)} tabindex="-1" aria-hidden="true"><Picture id={item.image} sizes="(min-width: 1024px) 34vw, (min-width: 768px) 48vw, 80vw" /></a>
            <p class="home-showcase-place">{item.place}</p>
            <h3><a href={projectHref(item.slug)}>{item.name}</a></h3>
            {item.credit && <p class="home-showcase-credit">{item.credit}</p>}
          </li>
        ))}
      </ul>
    </section>

    <section class="atelier-hotel-band" aria-label="Selected hotel projects">
      <p class="atelier-kicker">OUR WORK HAS A PLACE<br />IN EXTRAORDINARY ADDRESSES</p>
      <div>{hotelNames.map(hotel => <a href={hotel.href}><span>{hotel.name}</span><small>{hotel.place}</small></a>)}</div>
      <p class="home-partner-line"><a href="#calico-heading">Work delivered in partnership with Calico Wallpaper</a></p>
    </section>

    <section class="atelier-intro atelier-section" aria-labelledby="intro-heading">
      <p class="atelier-kicker">THE PRACTICE</p>
      <div><h2 id="intro-heading">A beautiful wall begins<br />long before <em>the first drop.</em></h2>
        <div class="atelier-intro-bottom"><p>From the first survey to the last carefully matched seam, we bring care to every stage. Silk, grasscloth, hand-painted paper and bespoke murals. Wallcoverings, hung properly. By people who understand the material.</p><div><p>{facts.description}</p><a class="atelier-text-link" href="/about/">Meet the practice <span aria-hidden="true">↗</span></a></div></div>
        <dl class="home-facts">{home.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
        <p class="home-pillars">{home.pillars.join(' · ')}</p>
      </div>
    </section>

    <section class="atelier-section home-proof" aria-labelledby="proof-heading">
      <div class="atelier-section-head"><div><p class="atelier-kicker">{home.proof.eyebrow}</p><h2 id="proof-heading">{home.proof.title}</h2></div><p class="home-proof-text">{home.proof.text}</p></div>
      <div class="home-proof-strip" role="region" tabindex="0" aria-label="Photographs from Brown's Hotel">
        {home.proof.images.map((id) => <figure><Picture id={id} sizes="(min-width: 768px) 18rem, 78vw" /></figure>)}
      </div>
      <h3 class="home-films-title">On location: short films from Brown’s Hotel</h3>
      <div class="atelier-film-grid home-films" data-films role="region" aria-label="Short films from Brown’s Hotel" tabindex="0">{home.proof.videos.map(id => { const film = videoById(id); return <figure><video controls playsinline preload="none" data-poster={film.poster} width={film.width} height={film.height} src={film.src} aria-label={film.alt} /><figcaption class="caption">{film.caption}</figcaption></figure>; })}</div>
    </section>
    <div class="home-studio"><MaterialStudio /></div>

    <section class="atelier-section atelier-work" aria-labelledby="selected-work">
      <div class="atelier-section-head"><div><p class="atelier-kicker">SELECTED COMMISSIONS</p><h2 id="selected-work">Places with <em>presence.</em></h2></div><a class="atelier-text-link" href="/projects/">View the full portfolio <span aria-hidden="true">↗</span></a></div>
      <div class="atelier-project-grid">
        <article class="atelier-project atelier-project-lead">
          <a class="atelier-project-image" href="/projects/browns-hotel-mayfair/">
            <picture><source type="image/webp" srcset="/media/atelier/browns-facade-dusk-960.webp 960w, /media/atelier/browns-facade-dusk-1600.webp 1600w" sizes="(min-width: 768px) 57vw, 100vw" /><img src="/media/atelier/browns-facade-dusk-1600.jpg" alt="Brown's Hotel in Mayfair at dusk, its entrance illuminated beneath the flags. Our photograph of the hotel exterior." width="1600" height="1200" loading="lazy" /></picture>
            <span class="atelier-project-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="atelier-project-meta"><div><p class="atelier-kicker">HOSPITALITY · MAYFAIR</p><h3><a href="/projects/browns-hotel-mayfair/">Brown’s Hotel</a></h3></div><span>2022–2024</span></div>
          <p>A full decorating package, delivered while the hotel continued welcoming guests.</p>
          <p class="atelier-credit">Our photograph of the hotel exterior. See the commission for completed interiors.</p>
        </article>
        {selection.map((item, i) => <article class:list={['atelier-project', `atelier-project-${i + 1}`]}>
          <a class="atelier-project-image" href={projectHref(item.slug)}>
            <Picture id={item.project.imageId ?? item.image} thumbOnly={item.type !== 'Hospitality'} sizes="(min-width: 768px) 36vw, 100vw" />
            <span class="atelier-project-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="atelier-project-meta"><div><p class="atelier-kicker">{item.type}</p><h3><a href={projectHref(item.slug)}>{item.label}</a></h3></div><span>{item.project.dates}</span></div>
          <p>{item.project.role}</p>
          {item.credit && <p class="atelier-credit">{item.credit}</p>}
        </article>)}
      </div>
      <div class="home-more">
        <p class="atelier-kicker">{home.featured.eyebrow} · More commissions</p>
        <h3 class="home-more-title">{home.featured.title}</h3>
        <p class="home-more-text">{home.featured.text}</p>
        <div class="home-more-grid">
          {moreWork.map((project) => <article class="home-card" data-project-slug={project.slug}>
            {project.imageId && <a class="home-card-image" href={projectHref(project.slug)} tabindex="-1" aria-hidden="true"><Picture id={project.imageId} sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw" /></a>}
            <h4><a href={projectHref(project.slug)}>{project.title}</a></h4>
            <p>{project.role}{project.dates ? ` · ${project.dates}` : ''}</p>
          </article>)}
        </div>
        {alsoOnRecord.length > 0 && <div class="home-record"><p class="atelier-kicker">Also on the record</p><ul>{alsoOnRecord.map((project) => <li><a href={projectHref(project.slug)}>{project.title}</a><span>. {project.summary}</span></li>)}</ul></div>}
      </div>
    </section>

    <section class="atelier-craft" aria-labelledby="craft-heading">
      <div class="atelier-craft-image"><picture><source srcset="/media/atelier/browns-cornice-960.webp 960w, /media/atelier/browns-cornice-1440.webp 1440w" type="image/webp" sizes="(min-width: 768px) 50vw, 100vw" /><img src="/media/atelier/browns-cornice-960.webp" width="960" height="1280" alt="Botanical wallcovering meeting the detailed white cornice at Brown's Hotel, Mayfair." loading="lazy" /></picture><p>THE FINISH, UP CLOSE · BROWN’S HOTEL</p></div>
      <div class="atelier-craft-copy"><p class="atelier-kicker light">THE DETAIL IS THE DIFFERENCE</p><h2 id="craft-heading">The room is the vision.<br /><em>The finish is our craft.</em></h2><p>Setting out around a doorway. Carrying a pattern through a corner. Preparing a wall so raking light reveals the texture, never the substrate. This is the work that makes the whole room feel right.</p>
        <dl><div><dt>Material knowledge</dt><dd>Silk, grasscloth, vinyl, textiles, murals and hand-painted papers.</dd></div><div><dt>Care from beginning to end</dt><dd>Survey, management, supply, installation and aftercare.</dd></div><div><dt>A considered return</dt><dd>A follow-up visit after four to six weeks, with twelve months’ cover on the workmanship of the hang.</dd></div></dl>
        <a class="atelier-text-link light" href="/services/">Explore our expertise <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="atelier-section atelier-service" aria-labelledby="service-heading">
      <div><p class="atelier-kicker">FROM FIRST IDEA TO FINISHED ROOM</p><h2 id="service-heading">One practice.<br /><em>Every stage.</em></h2><p>Bring us the paper you love, a specification, or simply the room you have in mind.</p><a class="atelier-text-link" href="/contact/">Tell us about it <span aria-hidden="true">↗</span></a></div>
      <ol>{home.serviceCards.map((service, i) => <li><a href={service.href}><span class="atelier-service-number">0{i+1}</span><div><h3>{service.title}</h3><p>{service.text}</p></div><span aria-hidden="true">↗</span></a></li>)}</ol>
    </section>

    <section class="atelier-section home-process" aria-labelledby="process-heading">
      <p class="atelier-kicker">{home.process.eyebrow}</p>
      <h2 id="process-heading">{home.process.title}</h2>
      <ol>{home.process.steps.map((step) => <li><span class="atelier-service-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    </section>

    <section class="atelier-materials" aria-labelledby="materials-heading">
      <div class="atelier-materials-copy"><p class="atelier-kicker">A FEEL FOR MATERIAL</p><h2 id="materials-heading">Find the character<br /><em>of your room.</em></h2><p>Soft texture. Quiet depth. A whole landscape on a wall. Explore the material families and what they ask of the room.</p><div class="atelier-material-links"><a href="/services/silk-wallcovering-installation/">Silk <span aria-hidden="true">↗</span></a><a href="/services/grasscloth-installation/">Grasscloth <span aria-hidden="true">↗</span></a><a href="/materials/">All materials <span aria-hidden="true">↗</span></a></div></div>
      <div class="atelier-materials-image"><Picture id="browns-hotel-mayfair-06" sizes="(min-width: 768px) 50vw, 100vw" /><span>ADAM’S EDEN · LEWIS & WOOD · BROWN’S HOTEL</span></div>
    </section>

    <section class="atelier-section home-calico" aria-labelledby="calico-heading">
      <p class="atelier-kicker">{home.partners.eyebrow}</p>
      <h2 id="calico-heading">{home.partners.title}</h2>
      <p class="home-calico-text">{home.partners.text}</p>
      <ul>{calicoProjects.map((project) => <li data-project-slug={project.slug}><a href={projectHref(project.slug)}>{calicoLabel(project)} <span aria-hidden="true">↗</span></a></li>)}</ul>
    </section>

    <section class="home-aftercare" aria-labelledby="aftercare-heading">
      <div class="home-aftercare-inner">
        <p class="atelier-kicker light">{home.aftercare.eyebrow}</p>
        <h2 id="aftercare-heading">{home.aftercare.title}</h2>
        <p>{home.aftercare.text}</p>
        <a class="atelier-text-link light" href={home.aftercare.href}>{home.aftercare.label} <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="atelier-section atelier-questions" aria-labelledby="questions-heading">
      <div><p class="atelier-kicker">BEFORE WE BEGIN</p><h2 id="questions-heading">A few good<br /><em>questions.</em></h2><a class="atelier-text-link" href="/advice/">The Wallcovering Guide <span aria-hidden="true">↗</span></a></div>
      <div class="faq">{faqItems.map(item => <details id={item.id}><summary><h3>{item.question}</h3><span class="plus" aria-hidden="true"></span></summary><div class="prose pb-5">{item.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div></details>)}</div>
    </section>

    <section class="atelier-section home-needs" aria-labelledby="needs-heading">
      <p class="atelier-kicker">What do you need?</p>
      <h2 id="needs-heading">Five ways to begin.</h2>
      <div class="home-needs-grid">
        <a href="/contact/?intent=install#enquiry"><h3>I already have the wallpaper</h3><p>Installation, with the product you have bought. Measurements can wait.</p></a>
        <a href="/contact/?intent=source#enquiry"><h3>Help me choose and install it</h3><p>A material family, a sample in the room, then the hang.</p></a>
        <a href="/professionals/#designers"><h3>I am specifying a project</h3><p>Send the room schedule, drawings and the specification. Unknowns can stay blank.</p></a>
        <a href="/professionals/"><h3>A hotel or contractor package</h3><p>Access, programme and who supplies the material.</p></a>
        <a href="/aftercare/#support"><h3>Aftercare or a repair</h3><p>A separate note for existing work. A photograph tells us whether it is the hang or the building.</p></a>
      </div>
    </section>

    <section class="atelier-contact" aria-labelledby="contact-heading"><p class="atelier-kicker">YOUR NEXT ROOM</p><h2 id="contact-heading">Let’s make it<br /><em>something remarkable.</em></h2><p>Hotels, prime residences and specified schemes. Tell us what you have in mind.</p><nav class="atelier-enquiry-routes" aria-label="Start with your project"><a href="/contact/?intent=install#enquiry">Wallpaper already chosen <span aria-hidden="true">↗</span></a><a href="/contact/?intent=source#enquiry">Help choosing a wallcovering <span aria-hidden="true">↗</span></a><a href="/contact/?audience=designer#enquiry">A designer’s specification <span aria-hidden="true">↗</span></a></nav><a class="atelier-button ink" href="/contact/">Start your project <span aria-hidden="true">↗</span></a><a class="atelier-contact-email" href={`mailto:${facts.email}`}>{facts.email}</a></section>

    <div class="atelier-ai-note"><p>Looking for structured business and project information?</p><a href="/wallcovering-installation-ai-crawler/">Wallcovering Installation AI Crawler <span aria-hidden="true">↗</span></a></div>
  </div>
</Base>


<script is:inline>
  // Film posters load only when the films come near the viewport (or are touched), so they never compete with the hero.
  (() => {
    const grid = document.querySelector('[data-films]');
    if (!grid) return;
    const load = () => grid.querySelectorAll('video[data-poster]').forEach((video) => { video.poster = video.dataset.poster; video.removeAttribute('data-poster'); });
    grid.addEventListener('pointerdown', load, { once: true });
    grid.addEventListener('focusin', load, { once: true });
    if (!('IntersectionObserver' in window)) return load();
    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { load(); io.disconnect(); } }, { rootMargin: '300px 0px' });
    io.observe(grid);
  })();
</script>

