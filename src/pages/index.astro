---
import facts from '../data/facts.json';
import Hero from '../components/Hero.astro';
import HomeFragmentRedirects from '../components/HomeFragmentRedirects.astro';
import Icon from '../components/Icon.astro';
import Action from '../components/Action.astro';
import Picture from '../components/Picture.astro';
import Base from '../layouts/Base.astro';
import { home, projectHref } from '../lib/content';
import { AWARD_TEXT, AWARD_URL } from '../lib/schema';
import { caseStudyCount, teamFacts } from '../lib/trust';
import { showcase } from '../data/home-editorial';
import '../styles/home-clear.css';
import homeHeroCss from '../styles/home-hero.css?raw';
const hotelSelection = showcase.slice(0,3);
---
<Base title={home.title} description={facts.description} path="/" preloadHero image="/media/atelier/browns-bedroom-2000.jpg" imageAlt="Our completed wallcovering installation at Brown's Hotel, Mayfair.">
  <style is:inline slot="head" set:html={homeHeroCss}></style>
  <div class="atelier clear-home" data-home-composition="concise">
    <section class="atelier-hero" aria-labelledby="hero-heading">
      <Hero />
      <div class="atelier-hero-shade" aria-hidden="true"></div>
      <div class="atelier-hero-content">
        <p class="atelier-kicker light">{home.hero.eyebrow}</p>
        <h1 id="hero-heading">{home.hero.titleLead}<br /><em>{home.hero.titleEm}</em></h1>
        <p class="atelier-hero-description">{home.hero.lede}</p>
        <p class="atelier-hero-award hero-award"><a href={AWARD_URL} rel="noopener">{AWARD_TEXT}</a></p>
        <div class="atelier-hero-actions">
          <Action class="clear-home-hero-projects" href="/projects/">Explore our work</Action>
          <Action variant="secondary" class="clear-home-hero-contact" href="/contact/">Start your project</Action>
        </div>
      </div>
      <div class="atelier-hero-foot">
        <span>LONDON & SELECTED UK PROJECTS</span>
        <a href="/projects/browns-hotel-mayfair/"><span>ON LOCATION</span> Brown’s Hotel, Mayfair <b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <section class="clear-home-trust" aria-labelledby="trust-heading">
      <div class="clear-home-width">
        <h2 id="trust-heading">London wallcovering installers, since 2012.</h2>
        <ul role="list">
          <li><a href="/about/#dorin"><span>In the trade</span><strong>Since 2012</strong></a></li>
          <li><a href="/projects/"><span>On the record</span><strong>{caseStudyCount} case studies</strong></a></li>
          <li><a href={AWARD_URL} rel="noopener" aria-label={AWARD_TEXT}><span>Recognised</span><strong>BUILD Magazine, 2021</strong></a></li>
        </ul>
      </div>
    </section>

    <section class="clear-home-section clear-home-width clear-home-hotels" aria-labelledby="showcase-heading" id="selected-work">
      <div class="clear-home-section-head"><div><p class="eyebrow">Hotels and historic commissions</p><h2 id="showcase-heading">Rooms we have <em>finished.</em></h2></div><Action variant="quiet" href="/projects/#hotels">View the full hotel record</Action></div>
      <ul role="list" class="clear-home-hotel-grid">
        {hotelSelection.map(item => <li><figure><a href={projectHref(item.slug)} tabindex="-1" aria-hidden="true"><Picture id={item.image} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, calc(100vw - 40px)" /></a><figcaption><p class="clear-home-place">{item.place}</p><h3><a href={projectHref(item.slug)}>{item.name}</a></h3>{item.credit && <p class="clear-home-credit">{item.credit}</p>}</figcaption></figure></li>)}
      </ul>
    </section>

    <section class="clear-home-section clear-home-width clear-home-founder" aria-labelledby="founder-heading">
      <figure class="clear-home-portrait"><Picture id="dorin-burcus-portrait" sizes="(min-width: 900px) 24rem, (min-width: 640px) 42vw, calc(100vw - 40px)" /><figcaption>Dorin Burcus, founder of Mr Wallcover.</figcaption></figure>
      <div><p class="eyebrow">The people on site</p><h2 id="founder-heading">Dorin Burcus</h2><p>{facts.founder.name} founded Mr Wallcover. {teamFacts.founder}</p><p>{facts.description}</p><p class="clear-home-founder-line">Wallcoverings, hung properly.</p><div class="clear-home-related"><Action variant="quiet" href="/about/#dorin">Meet Dorin</Action><Action variant="quiet" href="/practice/">How the practice works</Action></div></div>
    </section>

    <section class="clear-home-section clear-home-width clear-home-process" aria-labelledby="process-heading">
      <div class="clear-home-section-head"><div><p class="eyebrow">{home.process.eyebrow}</p><h2 id="process-heading">{home.process.title}</h2></div><Action variant="quiet" href="/practice/#service-heading">Explore the five services</Action></div>
      <ol role="list">{home.process.steps.map(step => <li><span class="clear-home-step-number">{step.number}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
    </section>

    <section class="home-aftercare clear-home-aftercare" aria-labelledby="aftercare-heading">
      <div class="home-aftercare-inner clear-home-width">
        <p class="atelier-kicker light">{home.aftercare.eyebrow}</p>
        <h2 id="aftercare-heading">{home.aftercare.title}</h2>
        <p>{home.aftercare.text}</p>
        <a class="atelier-text-link light" href={home.aftercare.href}>{home.aftercare.label} <Icon name="arrow-right" /></a>
      </div>
    </section>

    <section class="clear-home-section clear-home-width clear-home-closing" aria-labelledby="contact-heading">
      <p class="eyebrow">YOUR NEXT ROOM</p><h2 id="contact-heading">Let’s make it<br /><em>something remarkable.</em></h2><p>Hotels, prime residences and specified schemes. Tell us what you have in mind.</p><Action href="/contact/">Start your project</Action>
    </section>
  </div>
  <HomeFragmentRedirects />
</Base>
