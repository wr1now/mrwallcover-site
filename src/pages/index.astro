---
import facts from '../data/facts.json';
import PhoneReveal from '../components/PhoneReveal.astro';
import FaqList from '../components/FaqList.astro';
import Hero from '../components/Hero.astro';
import MaterialStudio from '../components/MaterialStudio.astro';
import Picture from '../components/Picture.astro';
import Base from '../layouts/Base.astro';
import { faq, faqItems, home, projectHref, projects, videoById } from '../lib/content';
import { phoneAvailable } from '../lib/phone';
import { faqNode } from '../lib/schema';

const lead = projects.find((project) => project.slug === home.featured.leadSlug);
const featured = projects.filter((project) => project.featured && project.slug !== home.featured.leadSlug);
const others = projects.filter((project) => !project.featured);
---

<Base
  title={home.title}
  description={facts.description}
  path="/"
  preloadHero={true}
  extraSchema={[faqNode(faqItems)]}
>
  <section class="hero on-dark">
    <Hero />
    <div class="hero-copy on-dark">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <span class="rule"></span>
      <!-- The H1 defines the firm for people and for answer engines. The literary voice follows in the lede. -->
      <h1>{home.hero.titleLead} <em>{home.hero.titleEm}</em></h1>
      <p class="lede mt-5">{home.hero.lede}</p>
      <p class="mt-5 mb-0 text-gold"><a class="trusted-link" href="/projects/#design-weeks">Work delivered in partnership with Calico Wallpaper</a></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-solid" href="/contact/">Start your project</a>
        <a class="btn btn-ghost" href="/projects/">Explore our work</a>
        <a class="btn btn-ghost hero-third" href="/contact/?intent=install">Wallpaper already purchased</a>
      </div>
    </div>
  </section>

  <section class="proof border-b border-line bg-paper" aria-labelledby="proof-heading">
    <div class="container-page pt-12 md:pt-16">
      <p class="eyebrow">{home.proof.eyebrow}</p>
      <h2 id="proof-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">{home.proof.title}</h2>
      <p class="lede mt-4 mb-8">{home.proof.text}</p>
    </div>
    <div class="proof-strip" role="region" tabindex="0" aria-label="Photographs and films from Brown's Hotel">
      {
        home.proof.images.map((id) => (
          <figure class="proof-item">
            <Picture id={id} thumbOnly sizes="(min-width: 768px) 18rem, 78vw" />
          </figure>
        ))
      }
      {
        home.proof.videos.map((id) => {
          const film = videoById(id);
          return (
            <figure class="proof-item">
              <video
                muted
                loop
                playsinline
                controls
                preload="none"
                poster={film.poster}
                width={film.width}
                height={film.height}
                data-src={film.src}
                aria-label={film.alt}
              />
              <figcaption class="caption">{film.caption}</figcaption>
            </figure>
          );
        })
      }
    </div>
  </section>

  <section class="border-b border-line" aria-label="The practice">
    <div class="container-page grid gap-8 py-14 md:grid-cols-12 md:py-20">
      <div class="md:col-span-6">
        <h2 class="m-0 text-[clamp(2.2rem,4vw,3.4rem)]">{home.intro.title}</h2>
        <p class="lede mt-4">{home.intro.text}</p>
        <p class="mt-6 mb-0 text-sm tracking-[0.14em] text-brass uppercase">{home.pillars.join(' · ')}</p>
      </div>
      <dl class="m-0 grid gap-6 md:col-span-5 md:col-start-8">
        {
          home.facts.map((fact) => (
            <div>
              <dt class="eyebrow">{fact.label}</dt>
              <dd class="fact-value m-0">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section aria-labelledby="services-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">{home.servicesIntro.eyebrow}</p>
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="services-heading" class="m-0 text-[clamp(2.2rem,4vw,3.4rem)]">{home.servicesIntro.title}</h2>
          <p class="lede mt-4">{home.servicesIntro.text}</p>
        </div>
        <div class="grid gap-x-8 sm:grid-cols-2 lg:col-span-7">
          {
            home.serviceCards.map((card) => (
              <a class="card-link" href={card.href}>
                <h3>{card.title}</h3>
                <p class="m-0 text-stone">{card.text}</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="work-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">{home.featured.eyebrow}</p>
      <h2 id="work-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">{home.featured.title}</h2>
      <p class="lede mt-4">{home.featured.text}</p>
      {
        lead && (
          <a class="mt-10 grid items-end gap-6 no-underline text-inherit md:grid-cols-12" href={projectHref(lead.slug)}>
            <div class="md:col-span-8">
              <Picture id={home.featured.leadImage} sizes="(min-width: 768px) 60vw, 100vw" />
            </div>
            <div class="md:col-span-4">
              <p class="eyebrow">{lead.dates}</p>
              <h3 class="m-0 text-[clamp(2rem,3vw,2.8rem)]">{lead.title}</h3>
              <p class="mt-3 mb-0 text-stone">{lead.summary}</p>
            </div>
          </a>
        )
      }
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {
          featured.map((project) => (
            <a class="project-card" href={projectHref(project.slug)}>
              {project.imageId && (
                <Picture id={project.imageId} sizes="(min-width: 1280px) 584px, (min-width: 768px) calc(50vw - 3rem), 100vw" />
              )}
              <h3>{project.title}</h3>
              <p class="m-0 text-stone">{project.role}{project.dates ? ` · ${project.dates}` : ''}</p>
            </a>
          ))
        }
      </div>
      <div class="mt-12 border-t border-line pt-6">
        <p class="eyebrow">Also on the record</p>
        <ul class="link-row m-0 grid list-none gap-2 p-0 md:grid-cols-2">
          {
            others.map((project) => (
              <li>
                <a href={projectHref(project.slug)}>{project.title}</a>
                <span class="text-stone">. {project.summary}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="needs-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">What do you need?</p>
      <h2 id="needs-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">Five ways to begin.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <a class="card-link" href="/contact/?intent=install"><h3>I already have the wallpaper</h3><p class="m-0 text-stone">Installation, with the product you have bought. Measurements can wait.</p></a>
        <a class="card-link" href="/contact/?intent=source"><h3>Help me choose and install it</h3><p class="m-0 text-stone">A material family, a sample in the room, then the hang.</p></a>
        <a class="card-link" href="/professionals/#designers"><h3>I am specifying a project</h3><p class="m-0 text-stone">Send the room schedule, drawings and the specification. Unknowns can stay blank.</p></a>
        <a class="card-link" href="/professionals/"><h3>A hotel or contractor package</h3><p class="m-0 text-stone">Access, programme and who supplies the material.</p></a>
        <a class="card-link" href="/aftercare/#support"><h3>Aftercare or a repair</h3><p class="m-0 text-stone">A separate note for existing work. A photograph tells us whether it is the hang or the building.</p></a>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="process-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">{home.process.eyebrow}</p>
      <h2 id="process-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">{home.process.title}</h2>
      <ol class="m-0 mt-10 grid list-none gap-8 p-0 md:grid-cols-2 lg:grid-cols-5">
        {
          home.process.steps.map((step) => (
            <li>
              <span class="step-num">{step.number}</span>
              <h3 class="mt-3 mb-2 text-[1.6rem]">{step.title}</h3>
              <p class="m-0 text-stone">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="detail-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">Craft</p>
      <h2 id="detail-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">The join, then the surface.</h2>
      <p class="lede mt-4">Two details from Brown's Hotel, both photographed after completion.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button class="btn btn-solid-ink" type="button" data-detail="join" aria-pressed="true">Corner and join</button>
        <button class="btn btn-line" type="button" data-detail="surface" aria-pressed="false">Surface</button>
      </div>
      <div class="mt-6 max-w-3xl" data-detail-panel="join">
        <Picture id="browns-hotel-mayfair-03" sizes="(min-width: 768px) 48rem, 100vw" />
      </div>
      <div class="mt-6 max-w-3xl" data-detail-panel="surface" hidden>
        <Picture id="browns-hotel-mayfair-01" sizes="(min-width: 768px) 48rem, 100vw" />
      </div>
    </div>
  </section>

  <MaterialStudio />

  <section class="border-t border-line" aria-labelledby="partners-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">{home.partners.eyebrow}</p>
      <h2 id="partners-heading" class="m-0 text-[clamp(2.2rem,4vw,3.2rem)]">{home.partners.title}</h2>
      <p class="lede mt-4">{home.partners.text}</p>
      <ul class="link-row mt-6 grid list-none gap-2 p-0 md:grid-cols-2">
        {projects.filter((p) => p.group === 'design-weeks').map((p) => (
          <li><a href={projectHref(p.slug)}>{p.slug === 'heathrow-terminal-4-calico' ? 'Calico Wallpaper at Heathrow Terminal 4' : p.title.replace(/: '?([^']+)'? at .*$/, ': $1')}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band-dark on-dark" aria-labelledby="aftercare-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">{home.aftercare.eyebrow}</p>
      <h2 id="aftercare-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">{home.aftercare.title}</h2>
      <p class="lede mt-5">{home.aftercare.text}</p>
      <a class="btn btn-ghost mt-8" href={home.aftercare.href}>{home.aftercare.label}</a>
    </div>
  </section>

  <FaqList items={faqItems} eyebrow="Questions" heading="Before you book the hang." lede={faq.lede} />

  <section class="border-t border-line" aria-labelledby="cta-heading">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow">{home.cta.eyebrow}</p>
      <h2 id="cta-heading" class="m-0 max-w-xl text-[clamp(2.2rem,4vw,3.4rem)]">{home.cta.title}</h2>
      <p class="lede mt-4">{phoneAvailable ? home.cta.text : home.cta.textNoPhone}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-solid-ink" href="/contact/">Start your project</a>
        <PhoneReveal class="btn btn-line" label="Show phone number" prefix="Call " />
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-detail]').forEach((button) => {
    button.addEventListener('click', () => {
      const name = button.dataset.detail;
      document.querySelectorAll<HTMLButtonElement>('[data-detail]').forEach((item) => {
        item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
      });
      document.querySelectorAll<HTMLElement>('[data-detail-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.detailPanel !== name;
      });
    });
  });
</script>
<script is:inline>
  const films = document.querySelectorAll('video[data-src]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (films.length && !reduceMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const video = entry.target;
          if (!video.querySelector('source')) {
            const source = document.createElement('source');
            source.src = video.dataset.src;
            source.type = 'video/mp4';
            video.append(source);
            video.play().catch(() => {});
          }
          observer.unobserve(video);
        }
      },
      { rootMargin: '160px' },
    );
    films.forEach((video) => observer.observe(video));
  }
</script>
