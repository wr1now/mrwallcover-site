---
import Breadcrumb from '../components/Breadcrumb.astro';
import Base from '../layouts/Base.astro';
import professionals from '../content/professionals.json';
import { breadcrumbNode } from '../lib/schema';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'For professionals', href: '/professionals/' }];
---
<Base title="For Designers, Developers & Hotels | Mr Wallcover" description="Wallcovering specification and installation routes for designers, property developers, contractors and hotel operators." path="/professionals/" extraSchema={[breadcrumbNode(crumbs)]}>
  <div class="container-page pb-20">
    <header class="page-head guide-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">For professionals</p>
      <h1>From specification<br />to the finished room.</h1>
      <p class="lede mt-5">Choose the route that fits your work. Bring the drawings, the material and the decisions still to be made.</p>
    </header>
    <div class="grid gap-6 md:grid-cols-3">
      {professionals.map((item) => <section class="guide-card" id={item.slug === 'developers' ? 'commercial' : item.slug}><p class="eyebrow">{item.name}</p><h2><a href={`/professionals/${item.slug}/`}>{item.heading}</a></h2><p>{item.intro}</p><a class="guide-read" href={`/professionals/${item.slug}/`}>Explore this service ↗</a></section>)}
    </div>
    <section class="guide-next"><p class="eyebrow">Already have a complete brief?</p><h2>Send the work in front of you.</h2><p>A schedule, drawings and a short note are enough to begin. Include who is supplying the material and any date the tender needs.</p><a class="btn btn-solid-ink" href="/contact/?audience=commercial&intent=install">Start a professional enquiry</a></section>
  </div>
</Base>
