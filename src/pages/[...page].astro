---
/**
 * Editorial pages from src/content/pages/*.md. A page is built only when its
 * frontmatter does not say `"draft": true`; see editorialPages in lib/content.ts.
 *
 * Optional frontmatter, all add-only (pages without it render as before):
 * - updated: ISO date; prints the PageMeta author and "Last updated" line.
 * - published: ISO date; with updated, a page under /advice/ also gets an Article node.
 * - service: { name, serviceType }; adds a Service node for the page.
 * - cta: { label, href }; replaces the default "Request a quotation" button.
 * - intake: { heading, items, download, downloadLabel, guide }; lays the page
 *   out like /professionals/<slug>/ (body beside a "What to send" panel).
 * - otherProfessionals: true; adds the "Other ways we can help" row that the
 *   professional pages carry.
 * - featureMedia: { id, caption, credit, project? }; adds an evidence photograph
 *   beside the body. Use cleared library media and an existing linked project.
 * - featureDiagram: { kind, caption }; adds an original schematic where it explains the article.
 */
import GuideNav from '../components/GuideNav.astro';
import type { GuideStage } from '../lib/guide-stages';
import '../styles/guide.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import BuyerFaq from '../components/BuyerFaq.astro';
import FaqList from '../components/FaqList.astro';
import PageMeta from '../components/PageMeta.astro';
import Action from '../components/Action.astro';
import type { IconName } from '../components/Icon.astro';
import EvidenceFigure from '../components/EvidenceFigure.astro';
import ProfessionalBriefing from '../components/ProfessionalBriefing.astro';
import ProjectEvidence from '../components/ProjectEvidence.astro';
import TechnicalDiagram, { type DiagramKind } from '../components/TechnicalDiagram.astro';
import Base from '../layouts/Base.astro';
import { SITE_URL } from '../config';
import professionals from '../content/professionals.json';
import { editorialPages, linkedProjects, projectHref } from '../lib/content';
import type { EditorialPageData } from '../lib/content';
import type { BuyerAnswer } from '../lib/ai-layer-data';
import { guides, guideHref } from '../lib/guides';
import { breadcrumbNode, faqNode, guideArticleNode, singleServiceNode } from '../lib/schema';

interface PageExtras {
  guideStage?: GuideStage['id'] | 'check';
  updated?: string;
  published?: string;
  service?: { name: string; serviceType?: string };
  cta?: { label: string; href: string };
  intake?: { heading: string; items: string[]; icons?: IconName[]; download?: string; downloadLabel?: string; guide?: string };
  otherProfessionals?: boolean;
  featureMedia?: { id: string; caption: string; credit: string; project?: string };
  featureDiagram?: { kind: DiagramKind; caption: string };
}

export function getStaticPaths() {
  return editorialPages.map((mod) => ({
    params: { page: mod.frontmatter.path.replace(/^\/|\/$/g, '') },
    props: { page: mod.frontmatter, Content: mod.Content },
  }));
}

interface Props {
  page: EditorialPageData & PageExtras;
  Content: any;
}

const { page, Content } = Astro.props;
const crumbs = [{ name: 'Home', href: '/' }, page.parent, { name: page.title, href: page.path }];
const linked = linkedProjects(page.projects, `editorial page "${page.path}"`);
const url = new URL(page.path, SITE_URL).href;
const intake = page.intake;
const relatedGuide = intake?.guide ? guides.find((guide) => guide.frontmatter.slug === intake.guide) : undefined;
if (intake?.guide && !relatedGuide) throw new Error(`editorial page "${page.path}" names a guide that does not exist: ${intake.guide}`);
const cta = page.cta ?? { label: 'Request a quotation', href: '/contact/' };
const featureProject = page.featureMedia?.project ? linked.find((project) => project.slug === page.featureMedia?.project) : undefined;
if (page.featureMedia?.project && !featureProject) throw new Error(`Editorial page "${page.path}" featureMedia must name one of its linked projects`);
// Pages under /professionals/ show their questions the way /professionals/<slug>/ does: the shared
// BuyerFaq block, headed "Questions buyers ask", above "Other ways we can help". Other editorial pages keep FaqList.
const professionalPage = page.parent.href === '/professionals/';
const buyerFaq = professionalPage
  ? page.faq.map((item) => ({ id: item.id, question: item.question, answer: item.paragraphs.join(' ') }) as unknown as BuyerAnswer)
  : [];
---

<Base
  title={page.metaTitle}
  description={page.description}
  path={page.path}
  updated={page.updated}
  meta={!page.updated}
  extraSchema={[
    ...(page.service
      ? [singleServiceNode({ name: page.service.name, description: page.description, url, serviceType: page.service.serviceType ?? page.service.name })]
      : []),
    // Editorial pages under /advice/ are articles like the guides beside them (dated, authored).
    ...(page.path.startsWith('/advice/') && page.updated
      ? [guideArticleNode({ url, headline: page.heading, description: page.description, published: page.published ?? page.updated, updated: page.updated })]
      : []),
    ...(page.faq.length ? [faqNode(page.faq)] : []),
    breadcrumbNode(crumbs),
  ]}
>
  <div class="container-page">
    <header class:list={['page-head', intake && 'guide-head']}>
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      {page.updated && <PageMeta updated={page.updated} class="guide-byline" />}
      <p class="lede mt-5">{page.lede}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Action href={cta.href}>{cta.label}</Action>
        <Action variant="secondary" href="/projects/">See the work</Action>
      </div>
    </header>
    {page.guideStage && <GuideNav current={page.guideStage} />}
    {
      intake ? (
        <div class="grid gap-10 pb-12 md:grid-cols-12">
          <article class="prose guide-prose md:col-span-7">
            <Content />
          </article>
          <div class="editorial-intake-column md:col-span-4 md:col-start-9">
            {page.featureMedia && <EvidenceFigure id={page.featureMedia.id} caption={page.featureMedia.caption} credit={page.featureMedia.credit} href={featureProject ? projectHref(featureProject.slug) : undefined} linkLabel={featureProject ? `View the ${featureProject.title} case study` : undefined} sizes="(min-width: 1024px) 24rem, calc(100vw - 2.5rem)" />}
            <ProfessionalBriefing items={intake.items} icons={intake.icons} heading={intake.heading} download={intake.download ? `/downloads/${intake.download}` : undefined} downloadLabel={intake.downloadLabel} guide={relatedGuide ? {href:guideHref(relatedGuide.frontmatter.slug), label:`${relatedGuide.frontmatter.shortTitle}: read the guide`} : undefined} />
          </div>
        </div>
      ) : (
        <div class:list={['editorial-body pb-12', (page.featureMedia || page.featureDiagram) && 'editorial-body-with-media']}>
          <article class:list={['prose guide-prose max-w-3xl', page.guideStage && 'guide-stage-page']}>
            <Content />
          </article>
          {page.featureMedia && <EvidenceFigure class="editorial-feature-media" id={page.featureMedia.id} caption={page.featureMedia.caption} credit={page.featureMedia.credit} href={featureProject ? projectHref(featureProject.slug) : undefined} linkLabel={featureProject ? `View the ${featureProject.title} case study` : undefined} sizes="(min-width: 1024px) 29rem, calc(100vw - 2.5rem)" />}
          {page.featureDiagram && <div class="editorial-feature-media"><TechnicalDiagram kind={page.featureDiagram.kind} caption={page.featureDiagram.caption} /></div>}
        </div>
      )
    }
    {
      linked.length > 0 && (
        <section class="border-t border-line py-12" aria-labelledby="record-heading">
          <h2 id="record-heading" class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On the public record</h2>
          <ProjectEvidence projects={linked} />
        </section>
      )
    }
    {buyerFaq.length > 0 && <div class="prose guide-prose"><BuyerFaq items={buyerFaq} eyebrow="Questions" /></div>}
    {
      page.otherProfessionals && (
        <section class="guide-related pb-12">
          <h2>Other ways we can help</h2>
          <div class="flex flex-wrap gap-3">
            {professionals.map((other) => (
              <Action variant="secondary" href={`/professionals/${other.slug}/`}>
                {other.name}
              </Action>
            ))}
            <Action variant="secondary" href="/projects/">Explore our work</Action>
          </div>
        </section>
      )
    }
  </div>
  {!professionalPage && page.faq.length > 0 && <FaqList items={page.faq} eyebrow="Questions" heading={`Asked about ${page.title}`} />}
</Base>

<style>
  .editorial-feature-media { margin: 0; }
  .editorial-feature-media figcaption { display: grid; gap: .4rem; margin-top: .9rem; }
  .editorial-feature-media a { color: var(--color-brass); text-decoration: underline; text-underline-offset: .2em; }
  .editorial-body-with-media { display: grid; gap: 2rem; }
  .editorial-intake-column { display:grid; gap:2rem; align-content:start; }
  @media (min-width: 1024px) {
    .editorial-body-with-media { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .editorial-feature-media { position: sticky; top: 8rem; margin-top: 1.4rem; }
  }
</style>
