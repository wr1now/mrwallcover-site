---
import {
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  PUBLIC_EMAIL,
} from '../config';
import Breadcrumb from '../components/Breadcrumb.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import PhoneReveal from '../components/PhoneReveal.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import BookCallLink from '../components/BookCallLink.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import DesignStudy from '../components/DesignStudy.astro';
import Base from '../layouts/Base.astro';
import { contact } from '../lib/content';
import quoteChecklist from '../content/quote-checklist.json';
import { phoneAvailable } from '../lib/phone';
import { BOOKING_URL } from '../config';
import { breadcrumbNode } from '../lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<Base
  title={contact.title}
  description={contact.description}
  path="/contact/"
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page pb-20">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{contact.eyebrow}</p>
      <h1>{contact.heading}</h1>
      <p class="lede mt-5">{contact.lede}</p>
    </header>
    <div class="contact-layout">
      <div id="enquiry" class="contact-form-column scroll-mt-24">
        <EnquiryForm />
      </div>
      <aside class="contact-aside">
        <section class="contact-direct" aria-label="Contact the practice">
        <p class="m-0">{phoneAvailable ? contact.direct : contact.directNoPhone}</p>
        <PhoneReveal wrap="mt-6 mb-0" />
        <p class:list={['m-0', !phoneAvailable && 'mt-6']}><a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a></p>
        {(phoneAvailable || BOOKING_URL) && <div class="contact-quick mt-4 mb-4 flex flex-wrap gap-3"><WhatsAppLink class="btn btn-line" /><BookCallLink class="btn btn-line" /></div>}
        {BOOKING_URL && <p class="booking-hours mt-0 mb-4 text-sm text-stone">Calls Mon–Fri, 9am–5pm UK.</p>}
        <p class="m-0"><a href={INSTAGRAM_URL}>Instagram {INSTAGRAM_HANDLE}</a></p>
        </section>
        <section class="quote-checklist" aria-labelledby="quote-checklist-heading" data-quote-checklist>
          <h2 id="quote-checklist-heading" class="font-serif text-[2rem]">{quoteChecklist.heading}</h2>
          <p>{quoteChecklist.intro}</p>
          <ul class="quote-checklist-list">
            {quoteChecklist.items.map((item) => <li><span class="quote-checklist-icon"><Icon name={item.icon as IconName} /></span><div><strong>{item.lead}</strong> {item.text}{item.href && <> <a href={item.href}>{item.linkText}</a>.</>}</div></li>)}
          </ul>
        </section>
        <section aria-labelledby="brief-help" class="contact-brief">
          <h2 id="brief-help" class="font-serif text-[2rem]">A useful first brief</h2>
          <DesignStudy kind="document" caption="Illustrative project brief" />
          <p>Tell us the area, the rooms or rough scope, the paper or material you have in mind, and your preferred timing. Photographs or drawings can follow by email.</p>
          <p>You do not need every answer yet. We can establish the details together.</p>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .contact-layout { display:grid; gap:var(--layout-gap); align-items:start; }
  .contact-form-column { min-width:0; padding:clamp(1.25rem,3vw,2.5rem); border:1px solid var(--color-line); background:var(--color-panel); border-radius:var(--radius-control); }
  .contact-aside { min-width:0; display:grid; gap:2.5rem; }
  .contact-aside h2 { font-size:var(--text-h3); margin:0 0 1rem; }
  .contact-direct { padding:1.5rem; background:var(--color-paper); border:1px solid var(--color-line); border-radius:var(--radius-control); }
  .contact-direct p { line-height:1.65; }
  .quote-checklist { padding-bottom:1.5rem; border-bottom:1px solid var(--color-line); }
  .quote-checklist-list { gap: 0; padding: 0; list-style: none; }
  .quote-checklist-list li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: .9rem; align-items: start; padding: 1rem 0; border-top: 1px solid var(--color-line); }
  .quote-checklist-list strong { display: block; margin-bottom: .2rem; font-weight: 500; color: var(--color-ink); }
  .quote-checklist-list li > div { color: var(--color-stone); line-height: 1.65; }
  .quote-checklist-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--color-brass); border: 1px solid var(--color-line); border-radius: 50%; background: var(--color-paper); }
  @media (min-width:1024px) { .contact-layout { grid-template-columns:minmax(0,7fr) minmax(0,4fr); } }
</style>
