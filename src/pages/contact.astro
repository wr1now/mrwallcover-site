---
import {
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  PUBLIC_EMAIL,
} from '../config';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuoteForm from '../components/QuoteForm.astro';
import PhoneReveal from '../components/PhoneReveal.astro';
import Base from '../layouts/Base.astro';
import { contact } from '../lib/content';
import { breadcrumbNode } from '../lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<Base
  title={contact.title}
  description={contact.description}
  path="/contact/"
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page pb-20">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{contact.eyebrow}</p>
      <h1>{contact.heading}</h1>
      <p class="lede mt-5">{contact.lede}</p>
    </header>
    <div class="grid gap-12 md:grid-cols-12">
      <div id="enquiry" class="scroll-mt-24 md:col-span-7">
        <QuoteForm />
      </div>
      <aside class="md:col-span-4 md:col-start-9">
        <p class="m-0">{contact.direct}</p>
        <p class="mt-6 mb-0">
          <PhoneReveal />
        </p>
        <p class="m-0">
          <a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>
        </p>
        <p class="m-0">
          <a href="/contact/" data-wa>WhatsApp</a>
        </p>
        <p class="m-0">
          <a href={INSTAGRAM_URL}>Instagram {INSTAGRAM_HANDLE}</a>
        </p>
      </aside>
    </div>
  </div>
</Base>
