---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageMeta from '../../components/PageMeta.astro';
import GuideCard from '../../components/GuideCard.astro';
import TechnicalDiagram from '../../components/TechnicalDiagram.astro';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import Action from '../../components/Action.astro';
import QuestionVisual from '../../components/QuestionVisual.astro';
import ObjectMotionControls from '../../components/ObjectMotionControls.astro';
import { guides, guideHref } from '../../lib/guides';
import { materials, media } from '../../lib/content';
import { breadcrumbNode, guideArticleNode, guideFaqNode, imageObject } from '../../lib/schema';
import { buyerFaqFor } from '../../lib/ai-layer-data';
import { SITE_URL } from '../../config';
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.frontmatter.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content, frontmatter: data } = guide;
const headings = guide.getHeadings().filter((heading) => heading.depth === 2);
const path = guideHref(data.slug);
const url = `${SITE_URL}${path}`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Wallcovering Guide', href: '/advice/' }, { name: data.shortTitle, href: path }];
const related = guides.filter((item) => data.relatedGuides.includes(item.frontmatter.slug));
const relatedMaterials = materials.items.filter((item) => data.relatedMaterials.includes(item.slug));
// The guide's own questions first, then any buyer questions placed on this guide (src/data/buyer-answers.json): one list, one FAQPage.
const faq: { q: string; a: string; id?: string }[] = [...(data.faq ?? []), ...buyerFaqFor(path).map((item) => ({ q: item.question, a: item.answer, id: item.id }))];
const metaDescription = data.metaDescription ?? data.description;
const article = guideArticleNode({ url, headline: data.title, description: metaDescription, published: data.published, updated: data.updated });
const evidenceImage = data.evidence ? media(data.evidence.id) : undefined;
if (evidenceImage) article.image = [imageObject(new URL(evidenceImage.src, SITE_URL).href)];
// FAQPage only when the questions are rendered on the page below; drafts carry no Article so the review build cannot be mistaken for publication.
const extraSchema = [breadcrumbNode(crumbs), ...(data.draft ? [] : [article, ...(faq.length ? [guideFaqNode(faq)] : [])])];
---
<Base title={`${data.shortTitle} | Mr Wallcover`} description={metaDescription} path={path} author={data.author} ogType="article" extraSchema={extraSchema} updated={data.updated} meta={false} image={evidenceImage?.src} imageAlt={evidenceImage?.alt}>
  <div class="container-page pb-20">
    <header class="page-head guide-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">The Wallcovering Guide / {data.category}</p>
      <h1>{data.title}</h1>
      <p class="lede mt-5">{data.description}</p>
      <PageMeta updated={data.updated} class="guide-byline" />
    </header>
    <div class="guide-layout">
      <aside class="guide-contents">
        <nav aria-label="On this page"><p class="eyebrow">In this guide</p><ol>{headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}{faq.length > 0 && <li><a href="#questions">Questions people ask</a></li>}</ol></nav>
        <Action variant="secondary" class="mt-5" href={data.ctaHref}>{data.ctaLabel}</Action>
        {data.download && <Action variant="quiet" class="mt-3" href={data.download.href} download icon="download">{data.download.label}</Action>}
      </aside>
      <article class="prose guide-prose">
        {data.diagram && <TechnicalDiagram kind={data.diagram} caption={data.diagramCaption} class="guide-opening-diagram" />}
        {data.evidence && <EvidenceFigure {...data.evidence} sizes="(min-width: 1024px) 46rem, calc(100vw - 2.5rem)" class="guide-opening-evidence" />}
        <Content />
        {faq.length > 0 && <section class="guide-faq" data-visual="dimensional" aria-labelledby="questions"><h2 id="questions">Questions people ask</h2><ObjectMotionControls />{faq.map((item) => <div class="guide-faq-item" id={item.id} data-design-hit><div class="question-heading-row"><h3>{item.q}</h3><QuestionVisual question={item.q} id={item.id} /></div><p>{item.a}</p></div>)}</section>}
        {data.sources.length > 0 && <aside class="guide-sources"><h2>Further reading</h2><ul>{data.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul></aside>}
        <div class="guide-next"><p class="eyebrow">Your next step</p><h2>Bring it back to your room.</h2><p>Send the material reference and what you already know. A photograph and a short note are enough to start.</p><Action href={data.ctaHref}>{data.ctaLabel}</Action></div>
      </article>
    </div>
    {relatedMaterials.length > 0 && <section class="guide-related"><h2>Explore the materials</h2><div class="flex flex-wrap gap-3">{relatedMaterials.map((material) => <Action variant="secondary" href={`/materials/${material.slug}/`}>{material.name}</Action>)}</div></section>}
    {related.length > 0 && <section class="guide-related"><h2>Keep reading</h2><div class="guide-grid">{related.map((item) => <GuideCard guide={item.frontmatter} />)}</div></section>}
  </div>
</Base>
