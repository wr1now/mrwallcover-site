---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageMeta from '../../components/PageMeta.astro';
import GuideCard from '../../components/GuideCard.astro';
import TechnicalDiagram from '../../components/TechnicalDiagram.astro';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import Action from '../../components/Action.astro';
import QuestionVisual from '../../components/QuestionVisual.astro';
import ObjectMotionControls from '../../components/ObjectMotionControls.astro';
import { guides, guideHref } from '../../lib/guides';
import { materials, media } from '../../lib/content';
import { breadcrumbNode, guideArticleNode, guideFaqNode, imageObject } from '../../lib/schema';
import { buyerFaqFor } from '../../lib/ai-layer-data';
import { SITE_URL } from '../../config';
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.frontmatter.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content, frontmatter: data } = guide;
const headings = guide.getHeadings().filter((heading) => heading.depth === 2);
const path = guideHref(data.slug);
const url = `${SITE_URL}${path}`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Wallcovering Guide', href: '/advice/' }, { name: data.shortTitle, href: path }];
const related = guides.filter((item) => data.relatedGuides.includes(item.frontmatter.slug));
const relatedMaterials = materials.items.filter((item) => data.relatedMaterials.includes(item.slug));
// The guide's own questions first, then any buyer questions placed on this guide (src/data/buyer-answers.json): one list, one FAQPage.
const faq: { q: string; a: string; id?: string }[] = [...(data.faq ?? []), ...buyerFaqFor(path).map((item) => ({ q: item.question, a: item.answer, id: item.id }))];
const metaDescription = data.metaDescription ?? data.description;
const article = guideArticleNode({ url, headline: data.title, description: metaDescription, published: data.published, updated: data.updated });
const evidenceImage = data.evidence ? media(data.evidence.id) : undefined;
if (evidenceImage) article.image = [imageObject(new URL(evidenceImage.src, SITE_URL).href)];
// FAQPage only when the questions are rendered on the page below; drafts carry no Article so the review build cannot be mistaken for publication.
const extraSchema = [breadcrumbNode(crumbs), ...(data.draft ? [] : [article, ...(faq.length ? [guideFaqNode(faq)] : [])])];
---
<Base title={`${data.seoTitle ?? data.shortTitle} | Mr Wallcover`} description={metaDescription} path={path} author={data.author} ogType="article" extraSchema={extraSchema} updated={data.updated} meta={false} image={evidenceImage?.src} imageAlt={evidenceImage?.alt}>
  <div class="container-page guide-article-page pb-20">
    <header class="page-head guide-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">The Wallcovering Guide / {data.category}</p>
      <h1>{data.title}</h1>
      <p class="lede mt-5">{data.description}</p>
      <PageMeta updated={data.updated} class="guide-byline" />
    </header>
    <div class="guide-layout">
      <aside class="guide-contents">
        <nav aria-label="On this page"><p class="eyebrow">In this guide</p><ol>{headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}{faq.length > 0 && <li><a href="#questions">Questions people ask</a></li>}</ol></nav>
        <Action variant="secondary" class="mt-5" href={data.ctaHref}>{data.ctaLabel}</Action>
        {data.download && <Action variant="quiet" class="mt-3" href={data.download.href} download icon="download">{data.download.label}</Action>}
      </aside>
      <div class="guide-reading-surface">
        <article class="prose guide-prose">
          {data.diagram && <TechnicalDiagram kind={data.diagram} caption={data.diagramCaption} class="guide-opening-diagram" />}
          {data.evidence && <EvidenceFigure {...data.evidence} sizes="(min-width: 1024px) 46rem, calc(100vw - 2.5rem)" class="guide-opening-evidence" />}
          <Content />
        </article>
      </div>
    </div>
    {faq.length > 0 && <section class="guide-faq guide-article-questions" data-visual="dimensional" aria-labelledby="questions"><h2 id="questions">Questions people ask</h2><ObjectMotionControls />{faq.map((item) => <div class="guide-faq-item" id={item.id} data-design-hit><div class="question-heading-row"><h3>{item.q}</h3><QuestionVisual question={item.q} id={item.id} /></div><p>{item.a}</p></div>)}</section>}
    <div class:list={['guide-endmatter', data.sources.length > 0 && 'guide-endmatter--with-sources']}>
      {data.sources.length > 0 && <aside class="guide-sources"><h2>Further reading</h2><ul>{data.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul></aside>}
      <div class="guide-next"><p class="eyebrow">Your next step</p><h2>Bring it back to your room.</h2><p>Send the material reference and what you already know. A photograph and a short note are enough to start.</p><Action href={data.ctaHref}>{data.ctaLabel}</Action></div>
    </div>
    {relatedMaterials.length > 0 && <section class="guide-related"><h2>Explore the materials</h2><div class="flex flex-wrap gap-3">{relatedMaterials.map((material) => <Action variant="secondary" href={`/materials/${material.slug}/`}>{material.name}</Action>)}</div></section>}
    {related.length > 0 && <section class="guide-related"><h2>Keep reading</h2><div class="guide-grid">{related.map((item) => <GuideCard guide={item.frontmatter} />)}</div></section>}
  </div>
</Base>

<style>
  .guide-article-page .guide-head { max-width: 63rem; }
  .guide-layout { grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-top: 2rem; }
  .guide-contents { min-width: 0; position: static; padding: 1.5rem; background: var(--color-ivory-deep); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  .guide-contents nav > p { margin: 0 0 .8rem; }
  .guide-contents ol { display: grid; gap: .25rem; margin: 0; padding-left: 1.2rem; }
  .guide-contents li { padding: 0; line-height: 1.5; }
  .guide-contents li a { display: block; padding-block: .4rem; }
  .guide-contents :global(.mw-action) { width: 100%; justify-content: flex-start; text-align: left; }
  .guide-reading-surface { min-width: 0; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  .guide-reading-surface .guide-prose { max-width: 44rem; margin-inline: auto; }
  .guide-reading-surface :global(.guide-prose > :first-child) { margin-top: 0; }
  .guide-reading-surface :global(.guide-prose > h2) { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); scroll-margin-top: 8rem; }
  .guide-reading-surface :global(.guide-prose > h3) { margin: 2rem 0 .75rem; }
  .guide-reading-surface :global(.guide-prose > ul), .guide-reading-surface :global(.guide-prose > ol) { padding-left: 1.3rem; }
  .guide-reading-surface :global(.guide-prose > ul) { list-style: disc; }
  .guide-reading-surface :global(.guide-prose > ol) { list-style: decimal; }
  .guide-reading-surface :global(.guide-prose li) { padding-left: .2rem; line-height: 1.75; }
  .guide-reading-surface :global(.guide-prose li + li) { margin-top: .7rem; }
  .guide-reading-surface :global(.guide-prose table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 1.5rem; }
  .guide-reading-surface :global(.guide-prose th), .guide-reading-surface :global(.guide-prose td) { min-width: 10ch; padding: .85rem 1rem; border: 1px solid var(--color-line); text-align: left; vertical-align: top; }
  .guide-reading-surface :global(.guide-prose th) { background: var(--color-ivory-deep); font-weight: 500; }
  .guide-article-questions { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 2rem; }
  .guide-article-questions > h2 { max-width: 22ch; margin: 0 0 1rem; }
  .guide-article-questions .guide-faq-item > p { max-width: var(--layout-reading); line-height: 1.8; }
  .guide-endmatter { display: grid; gap: 2rem; margin-top: 3rem; align-items: start; }
  .guide-endmatter .guide-sources { min-width: 0; margin: 0; padding-top: 1.25rem; }
  .guide-sources > h2 { margin: 0 0 1rem; }
  .guide-sources ul { margin: 0; padding-left: 1.2rem; list-style: disc; }
  .guide-sources li { padding-block: .5rem; overflow-wrap: anywhere; }
  .guide-endmatter .guide-next { min-width: 0; margin: 0; border: 1px solid var(--color-line); }
  .guide-endmatter .guide-next .eyebrow { margin-top: 0; }
  @media (min-width: 640px) and (max-width: 1023px) {
    .guide-contents ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
    .guide-contents :global(.mw-action) { width: auto; }
  }
  @media (min-width: 1024px) {
    .guide-layout { grid-template-columns: minmax(13rem, 1fr) minmax(0, 3fr); gap: clamp(2rem, 4vw, 4rem); }
    .guide-contents { position: sticky; top: 7.5rem; align-self: start; padding: 1.5rem 1.25rem; }
    .guide-endmatter--with-sources { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 4rem; }
  }
  @media print {
    .guide-layout { display: block; }
    .guide-reading-surface { padding: 0; border: 0; }
    .guide-reading-surface .guide-prose { max-width: none; }
  }
</style>
