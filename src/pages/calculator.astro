---
import Breadcrumb from '../components/Breadcrumb.astro';
import Action from '../components/Action.astro';
import WallpaperingNav from '../components/WallpaperingNav.astro';
import Base from '../layouts/Base.astro';
import { isConfirmed, makers, wallpapering } from '../lib/materials';
import { formatGroups, formatLabel, formats, rollFormats } from '../lib/roll-formats';
import { breadcrumbNode } from '../lib/schema';
import '../styles/wallpapering.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Wallpaper calculator', href: '/calculator/' },
];
// Roll sizes the visitor can pick, grouped by how the paper is sold. Each preset is a size a maker prints
// (src/data/roll-formats.json); every group also takes any other size typed in (owner, 17 Oct 2026).
const groups = formatGroups.map((group) => ({ ...group, presets: formats.filter((format) => format.group === group.id) }));
const sizeless = (id: string) => id === 'mural' || id === 'panel-set';
const makerOptions = makers.filter(isConfirmed).map((rule) => ({ id: rule.id, name: rule.name, noInfill: Boolean(rule.noOffcutInfill) }));
const conditions = wallpapering.conditionQuestion.options;
---

<Base
  title="Wallpaper calculator: rolls, cutting plan | Mr Wallcover"
  description="Work out how many rolls of wallpaper to order, see how every drop is cut from the rolls, and get the primer, lining and paste for the wall. No price."
  path="/calculator/"
  extraSchema={[breadcrumbNode(crumbs)]}
  preloadFonts
>
  <div class="container-page pb-20">
    <header class="page-head guide-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">Calculator</p>
      <h1>Wallpaper calculator</h1>
      <p class="lede qc-lede mt-5">Choose the roll, then give the wall's width and height. We cut every drop from the rolls the way we do and give you the order with a spare, the cutting plan, and the primer, lining and paste. A quantity to order, not a set-out, and never a price.</p>
    </header>
    <WallpaperingNav current="calculator" />

    <form class="qc" data-quantity aria-labelledby="calculator-heading" novalidate>
      <h2 id="calculator-heading" class="sr-only">Roll calculator</h2>
      <noscript><p class="qc-warning">The calculator needs JavaScript. Our guide to <a href="/advice/quantities/">how much wallpaper to order</a> shows the same method by hand, or <a href="/contact/?intent=install">send us your measurements</a>.</p></noscript>

      <fieldset class="qc-step">
        <legend><span class="qc-num">1</span> The wallpaper</legend>
        <div class="grid gap-5 md:grid-cols-2">
          <div class="field md:col-span-2">
            <label for="qc-format">Roll size</label>
            <select id="qc-format" name="format" aria-describedby="qc-hint-roll">
              {groups.map((group) => (
                <optgroup label={group.label}>
                  {group.presets.map((format) => (
                    <option value={format.id} data-group={group.id} data-width={format.width} data-wunit={format.widthUnit} data-length={format.length ?? ''} data-lunit={format.lengthUnit} data-overlap={format.overlapCm ?? 0} data-sets={format.rollsPerSet}>{formatLabel(format)}</option>
                  ))}
                  {!sizeless(group.id) && <option value={`other-${group.id}`} data-group={group.id} data-other="true">Another size: type it below</option>}
                </optgroup>
              ))}
            </select>
            <p class="qc-hint form-note" id="qc-hint-roll">Not sure? Leave the standard roll and free match: the result says what it assumed.</p>
          </div>
          <div class="qc-custom-size grid gap-5 md:grid-cols-2 md:col-span-2" data-custom-size>
            <p class="qc-hint form-note md:col-span-2">Type the width and length as they are printed, in centimetres or inches, metres, feet or yards.</p>
            <div class="field" data-paper-size>
              <label for="qc-roll-width">Width</label>
              <div class="qc-unit">
                <input id="qc-roll-width" name="rollWidth" data-dim="pwidth" type="number" inputmode="decimal" min="0" step="0.01" value="53" list="qc-widths" />
                <select name="widthUnit" aria-label="Width unit"><option value="cm">cm</option><option value="in">in</option></select>
              </div>
              <datalist id="qc-widths" data-cm={rollFormats.widthSuggestions.cm.join(' ')} data-in={rollFormats.widthSuggestions.in.join(' ')}>
                {rollFormats.widthSuggestions.cm.map((width) => <option value={width} />)}
              </datalist>
            </div>
            <div class="field" data-paper-size>
              <label for="qc-roll-length">Roll length</label>
              <div class="qc-unit">
                <input id="qc-roll-length" name="rollLength" data-dim="plength" type="number" inputmode="decimal" min="0" step="0.01" value="10.05" />
                <select name="lengthUnit" aria-label="Length unit"><option value="m">m</option><option value="ft">ft</option><option value="yd">yd</option></select>
              </div>
            </div>
          </div>
          <div class="field" data-overlap-field hidden>
            <label for="qc-overlap">Overlap at each joint, <span data-u="pwidth">cm</span></label>
            <input id="qc-overlap" name="overlap" data-dim="pwidth" type="number" inputmode="decimal" min="0" step="0.5" value="0" aria-describedby="qc-hint-overlap" />
            <p class="qc-hint form-note" id="qc-hint-overlap">Wide goods are usually overlapped and cut through. Use the overlap on the maker's sheet, or 0 for butt joints.</p>
          </div>
          <div class="field" data-set-field hidden>
            <label for="qc-sets">Rolls in each set</label>
            <input id="qc-sets" name="rollsPerSet" type="number" inputmode="numeric" min="2" step="1" value="2" />
          </div>
          <div class="field" data-paper-size>
            <label for="qc-match">Pattern match</label>
            <select id="qc-match" name="match">
              <option value="free">Free match, or plain</option>
              <option value="reverse">Reverse hang</option>
              <option value="straight">Straight match</option>
              <option value="half">Half-drop</option>
              <option value="third">Third drop</option>
              <option value="quarter">Quarter drop</option>
            </select>
          </div>
          <div class="field" data-paper-size data-repeat-field>
            <label for="qc-repeat">Pattern repeat</label>
            <div class="qc-unit">
              <input id="qc-repeat" name="repeat" data-dim="repeat" type="number" inputmode="decimal" min="0" step="0.1" value="0" />
              <select name="repeatUnit" aria-label="Repeat unit"><option value="cm">cm</option><option value="in">in</option></select>
            </div>
          </div>
          <div class="field" data-mural-field hidden>
            <label for="qc-margin">Margin the mural maker asks you to add, <span data-u="small">cm</span></label>
            <input id="qc-margin" name="margin" data-dim="small" type="number" inputmode="decimal" min="0" step="0.5" placeholder="From the maker's instructions" aria-describedby="qc-hint-margin" />
            <p class="qc-hint form-note" id="qc-hint-margin">Use the maker's stated margin. Enter 0 only when the maker says no extra margin is needed.</p>
          </div>
        </div>
        <details class="qc-sub" data-maker-box>
          <summary>Know the maker or have the product link? <span class="text-stone">(optional)</span></summary>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="field">
              <label for="qc-maker">Maker</label>
              <select id="qc-maker" name="maker">
                <option value="">Not sure, or another maker</option>
                {makerOptions.map((option) => <option value={option.id} data-no-infill={option.noInfill ? 'true' : undefined}>{option.name}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="qc-link">Product link</label>
              <input id="qc-link" name="link" type="url" inputmode="url" autocomplete="off" placeholder="https://" />
              <p class="qc-hint form-note" data-link-note aria-live="polite" hidden></p>
            </div>
          </div>
        </details>
      </fieldset>

      <fieldset class="qc-step">
        <legend><span class="qc-num">2</span> The wall or the room</legend>
        <fieldset class="qc-group">
          <legend>What you are measuring</legend>
          <div class="qc-seg">
            <label><input type="radio" class="sr-only" name="measure" value="wall" checked /><span>One wall</span></label>
            <label><input type="radio" class="sr-only" name="measure" value="walls" /><span>Several walls</span></label>
            <label><input type="radio" class="sr-only" name="measure" value="room" /><span>A whole room</span></label>
          </div>
        </fieldset>
        <fieldset class="qc-group qc-group-quiet">
          <legend>Measured in</legend>
          <div class="qc-seg qc-seg-small">
            <label><input type="radio" class="sr-only" name="mu" value="cm" checked /><span>cm</span></label>
            <label><input type="radio" class="sr-only" name="mu" value="m" /><span>m</span></label>
            <label><input type="radio" class="sr-only" name="mu" value="in" /><span>inches</span></label>
            <label><input type="radio" class="sr-only" name="mu" value="ft" /><span>feet</span></label>
          </div>
        </fieldset>
        <div data-walls class="grid gap-4">
          <div class="qc-wall grid gap-5 md:grid-cols-2" data-wall>
            <div class="field"><label>Wall width, <span data-u="measure">cm</span> <input name="width" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 500" /></label></div>
            <div class="field"><label>Height to paper, <span data-u="measure">cm</span> <input name="height" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 270" aria-describedby="qc-hint-height" /></label></div>
          </div>
        </div>
        <button class="btn btn-line justify-self-start" type="button" data-add-wall hidden>Add another wall</button>
        <div data-room class="grid gap-5 md:grid-cols-3" hidden>
          <div class="field"><label>Room length, <span data-u="measure">cm</span> <input name="roomLength" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 400" /></label></div>
          <div class="field"><label>Room width, <span data-u="measure">cm</span> <input name="roomWidth" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 350" /></label></div>
          <div class="field"><label>Height to paper, <span data-u="measure">cm</span> <input name="roomHeight" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 270" aria-describedby="qc-hint-height" /></label></div>
        </div>
        <p class="qc-hint form-note" id="qc-hint-height">Height to paper: from the top of the skirting to where the paper stops, at the ceiling, the cornice or the picture rail. A room is counted as one run round its walls.</p>
        <p class="qc-hint form-note">A stairwell, a sloping or curved wall, or a ceiling? We measure those for you: <a href="/contact/?intent=install&from=calculator">send us your measurements</a>.</p>
      </fieldset>

      <details class="qc-step qc-more" data-more>
        <summary>
          <span class="qc-num">3</span>
          <span class="qc-summary-text">Doors, windows, chimney breasts and the walls' condition <span class="text-stone">(optional)</span>
            <span class="qc-summary-note">Takes out drops over doors and windows; sets the primer and lining.</span>
          </span>
          <span class="qc-plus" aria-hidden="true"></span>
        </summary>
        <div class="grid gap-6">
          <div class="field md:max-w-md">
            <label for="qc-condition">{wallpapering.conditionQuestion.label}</label>
            <select id="qc-condition" name="condition">
              {conditions.map((option) => <option value={option.id}>{option.label}</option>)}
            </select>
          </div>
          <div class="grid gap-3">
            <p class="m-0 font-medium">Doors, windows and niches</p>
            <div data-openings class="grid gap-4"></div>
            <div class="flex flex-wrap gap-3">
              <button class="btn btn-line" type="button" data-add-opening="window">Add a window</button>
              <button class="btn btn-line" type="button" data-add-opening="door">Add a door</button>
              <button class="btn btn-line" type="button" data-add-opening="niche">Add a niche</button>
            </div>
          </div>
          <div class="grid gap-3">
            <p class="m-0 font-medium">Chimney breast and alcove returns</p>
            <div data-returns class="grid gap-4"></div>
            <button class="btn btn-line justify-self-start" type="button" data-add-return>Add a return</button>
            <p class="qc-hint form-note m-0">Each side of a chimney breast or an alcove is a return. Its depth is added to the width of the wall.</p>
          </div>
          <fieldset class="qc-group qc-checks">
            <legend>Anything else about the space?</legend>
            <label><input type="checkbox" name="bespoke" value="stairs" /> A stairwell</label>
            <label><input type="checkbox" name="bespoke" value="slope" /> A sloping wall or ceiling</label>
            <label><input type="checkbox" name="bespoke" value="curved" /> A curved wall</label>
            <label><input type="checkbox" name="bespoke" value="ceiling" /> The ceiling</label>
          </fieldset>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="field"><label>Trim at the top, <span data-u="small">cm</span> <input name="trimTop" data-dim="small" type="number" inputmode="decimal" min="0" step="0.5" value="5" /></label></div>
            <div class="field"><label>Trim at the bottom, <span data-u="small">cm</span> <input name="trimBottom" data-dim="small" type="number" inputmode="decimal" min="0" step="0.5" value="5" /></label></div>
          </div>
        </div>
      </details>

      <div class="qc-submit">
        <Action type="submit" icon="arrow-right">Work it out</Action>
      </div>
      <!-- The docket spans every row of the left column at desktop width (see .qc-docket below), so it stays beside the form. -->
      <aside class="qc-docket" data-docket aria-labelledby="qc-docket-heading">
        <h3 id="qc-docket-heading" class="qc-docket-title" tabindex="-1">Your order</h3>
        <div class="qc-docket-body" data-docket-body>
          <figure class="qc-measure-diagram">
            <svg viewBox="0 0 320 180" role="img" aria-labelledby="qc-measure-title qc-measure-desc">
              <title id="qc-measure-title">Two measurements to begin</title>
              <desc id="qc-measure-desc">An illustrative wall elevation: measure its full width and the height from the skirting to where the wallpaper stops. The drawing is not to scale.</desc>
              <defs>
                <linearGradient id="qc-paper" x1="0" x2="1"><stop stop-color="var(--color-panel)" /><stop offset="1" stop-color="var(--color-ivory-deep)" /></linearGradient>
              </defs>
              <path class="qc-diagram-shadow" d="M45 33h226v116H45z" />
              <path class="qc-diagram-wall" d="M34 24h226v116H34z" />
              <path class="qc-diagram-paper" d="M34 24h57v116H34z" />
              <path class="qc-diagram-seam" d="M91 24v116m56-116v116m57-116v116" />
              <path class="qc-diagram-rule" d="M34 134h226M34 140h226" />
              <path class="qc-diagram-dimension" d="M34 155v10m226-10v10M34 160h226m-226 0 5-3m-5 3 5 3m221-3-5-3m5 3-5 3M276 24h10m-10 110h10m-5-110v110m0-110-3 5m3-5 3 5m-3 105-3-5m3 5 3-5" />
              <text x="147" y="177" text-anchor="middle">Wall width</text>
              <text x="302" y="80" text-anchor="middle" transform="rotate(-90 302 80)">Height to paper</text>
            </svg>
            <figcaption>Width sets the number of drops. Height sets each cut. <span>Illustrative · not to scale</span></figcaption>
          </figure>
          <dl class="qc-order qc-order-empty">
            <div><dt>Working</dt><dd><strong>—</strong></dd></div>
            <div><dt><span class="qc-op">+</span> Spare</dt><dd><strong>—</strong></dd></div>
            <div class="qc-total"><dt><span class="qc-op">=</span> Order</dt><dd><strong>—</strong></dd></div>
          </dl>
          <p class="qc-hint">Type the wall's width and height.</p>
        </div>
        <p class="qc-small" data-stale-note hidden>Update the measurement to refresh this result.</p>
      </aside>
      <p class="sr-only" role="status" data-qc-status></p>
      <div class="qc-result" id="qc-result" data-quantity-output tabindex="-1" hidden></div>
    </form>

    <!-- Shared actions are rendered once, then cloned when the calculator has an outcome. -->
    <template data-qc-action="check"><Action href="/contact/?intent=advice&from=calculator" icon="arrow-right">Have Mr Wallcover check this</Action></template>
    <template data-qc-action="send"><Action href="/contact/?intent=install&from=calculator" variant="secondary" icon="mail">Send us your measurements</Action></template>
    <template data-qc-action="request"><Action href="/contact/?intent=install&from=calculator" icon="mail">Send us your measurements</Action></template>

    <template data-opening-template>
      <fieldset class="qc-opening" data-opening>
        <legend class="qc-opening-title" data-opening-title></legend>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="field" data-opening-wall hidden><label>On wall <select name="o-wall"></select></label></div>
          <div class="field"><label>Width, <span data-u="measure">cm</span> <input name="o-width" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
          <div class="field"><label>Height, <span data-u="measure">cm</span> <input name="o-height" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
          <div class="field" data-from-floor><label><span data-from-floor-label>Sill above the skirting</span>, <span data-u="measure">cm</span> <input name="o-floor" data-dim="measure" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
          <div class="field"><label>Reveal depth, <span data-u="small">cm</span> <input name="o-depth" data-dim="small" type="number" inputmode="decimal" min="0" step="0.1" value="0" /></label></div>
          <div class="field" data-reveals><label>Papered reveals
            <select name="o-reveals"><option value="none">None</option><option value="sides">Sides</option><option value="sides-head">Sides and head</option></select>
          </label></div>
          <button class="btn btn-line md:col-span-3 justify-self-start" type="button" data-remove>Remove<span class="sr-only" data-remove-name></span></button>
        </div>
      </fieldset>
    </template>
    <template data-return-template>
      <div class="qc-return grid gap-4 md:grid-cols-3" data-return>
        <div class="field" data-return-wall hidden><label>On wall <select name="r-wall"></select></label></div>
        <div class="field"><label>Return depth, <span data-u="small">cm</span> <input name="r-depth" data-dim="small" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
        <button class="btn btn-line justify-self-start self-end" type="button" data-remove>Remove<span class="sr-only" data-remove-name></span></button>
      </div>
    </template>

    <section class="guide-next mt-16">
      <p class="eyebrow">How it counts</p>
      <h2>The method, with worked examples.</h2>
      <p>Why width decides the number of drops, how the pattern repeat changes the cut, why we count drops rather than add a percentage, and when doors and windows save a drop: our guide to <a href="/advice/quantities/">how much wallpaper to order</a> works through it by hand. The materials follow our <a href="/wallpapering/preparation/">preparation tables</a> and the <a href="/wallpapering/lining-and-adhesives/">lining papers, pastes and primers</a> we use.</p>
      <div class="flex flex-wrap gap-3">
        <Action href="/contact/?intent=install" icon="mail">Send us your measurements</Action>
        <Action href="/advice/quantities/" variant="secondary" icon="book">Read the guide</Action>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/quantity-ui';
</script>

<style is:global>
  /* ---- Layout: the form, with the order docket beside it from 64rem ---- */
  .qc { display: grid; grid-template-columns: minmax(0, 1fr); accent-color: var(--color-ink); }
  .qc > * + * { margin-top: var(--space-8); }
  .qc > .qc-docket { margin-top: var(--space-6); }
  @media (min-width: 64rem) {
    .qc { grid-template-columns: minmax(0, 46rem) minmax(18rem, 22rem); column-gap: clamp(3rem, 5vw, 5rem); justify-content: space-between; align-items: start; }
    .qc > * { grid-column: 1; }
    /* The docket spans every row of the left column (steps 1-3, the submit row, the result, with rows to spare:
       empty rows take no height), so it stays beside the form from step 1 to the end of the materials. */
    .qc > .qc-docket { grid-column: 2; grid-row: 1 / span 9; align-self: start; position: sticky; top: calc(var(--header-height) + var(--header-inset-top) + var(--space-6)); margin-top: 0; }
  }
  html:has(.qc) { scroll-padding-top: calc(var(--header-height) + var(--header-inset-top) + 1rem); }
  @media (max-width: 79.99rem) { html:has(.qc) { scroll-padding-bottom: var(--dock-clearance); } }
  html:not(.js) .qc-docket, html:not(.js) .qc :is([type="submit"], [data-add-opening], [data-add-return], [data-add-wall]) { display: none; }

  /* ---- Type: the answer is the largest thing after the H1 ---- */
  @media (max-width: 47.99rem) { .qc-lede { font-size: var(--text-body); } }
  .qc-step > legend, .qc-more > summary, .qc-result h3, .qc-docket-title { margin: 0; font-family: var(--font-serif); font-size: var(--text-h3); font-weight: 500; line-height: 1.15; }
  main .guide-next > h2:not(.sr-only) { font-size: var(--text-h3); }
  .qc-num { display: inline-block; min-width: 1.5em; font-family: var(--font-serif); color: var(--color-brass); font-variant-numeric: lining-nums; }
  .qc-hint { margin: 0; max-width: var(--measure-copy); color: var(--color-stone); font-size: var(--text-meta); }
  .qc-hint a, .qc-result a:not(.mw-action), .qc-docket a:not(.mw-action) { color: inherit; text-decoration: underline; text-decoration-color: var(--color-brass); text-underline-offset: 3px; }

  /* ---- Steps: the hairline above each title, never through it ---- */
  .qc-step { min-width: 0; margin: 0; padding: 0; border: 0; display: grid; gap: var(--space-5); }
  .qc-step > legend, .qc-more > summary { float: left; width: 100%; padding: var(--space-5) 0 0; border-top: 1px solid var(--color-line); }
  .qc-step > legend + * { clear: both; }
  .qc-more > summary { cursor: pointer; display: flex; align-items: flex-start; gap: .25rem; min-height: 44px; list-style: none; }
  .qc-more > summary::-webkit-details-marker { display: none; }
  .qc-summary-text { flex: 1; }
  .qc-summary-note { display: block; margin-top: .35rem; font: 400 var(--text-meta)/1.5 var(--font-sans); color: var(--color-stone); }
  .qc-plus { position: relative; flex: none; width: .9rem; height: .9rem; margin: .55em 0 0 1rem; }
  .qc-plus::before, .qc-plus::after { content: ""; position: absolute; background: var(--color-brass); }
  .qc-plus::before { left: 0; top: calc(50% - 1px); width: 100%; height: 2px; }
  .qc-plus::after { top: 0; left: calc(50% - 1px); width: 2px; height: 100%; }
  .qc-more[open] .qc-plus::after { transform: scaleY(0); }
  @media (prefers-reduced-motion: no-preference) { .qc-plus::after { transition: transform .2s ease; } }
  .qc-sub { border-top: 1px solid var(--color-line); }
  .qc-sub > summary { cursor: pointer; display: flex; align-items: center; gap: .5rem; min-height: 48px; font-weight: 500; list-style: none; }
  .qc-sub > summary::-webkit-details-marker { display: none; }
  .qc-sub > summary::before { content: "+"; width: 1ch; color: var(--color-brass); font-size: 1.2em; line-height: 1; }
  .qc-sub[open] > summary::before { content: "\2212"; }
  .qc-sub > div { padding: var(--space-3) 0 0; }

  /* ---- Controls: ink segmented choices, 2px corners, joined unit fields ---- */
  .qc-group { min-width: 0; margin: 0; padding: 0; border: 0; display: grid; gap: var(--space-2); }
  .qc-group > legend { padding: 0; margin-bottom: var(--space-2); font-weight: 500; }
