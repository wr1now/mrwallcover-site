---
import Breadcrumb from '../components/Breadcrumb.astro';
import WallpaperingNav from '../components/WallpaperingNav.astro';
import Base from '../layouts/Base.astro';
import { isConfirmed, makers, wallpapering } from '../lib/materials';
import { formatGroups, formatLabel, formats, rollFormats } from '../lib/roll-formats';
import { breadcrumbNode } from '../lib/schema';
import '../styles/wallpapering.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Calculator', href: '/calculator/' },
];
// Roll sizes the visitor can pick, grouped by how the paper is sold. Each preset is a size a maker prints
// (src/data/roll-formats.json); every group also takes any other size typed in (owner, 17 Oct 2026).
const groups = formatGroups.map((group) => ({ ...group, presets: formats.filter((format) => format.group === group.id) }));
const sizeless = (id: string) => id === 'mural' || id === 'panel-set';
const makerOptions = makers.filter(isConfirmed).map((rule) => ({ id: rule.id, name: rule.name, noInfill: Boolean(rule.noOffcutInfill) }));
const conditions = wallpapering.conditionQuestion.options;
---

<Base
  title="Wallpaper calculator: rolls, cutting plan | Mr Wallcover"
  description="Work out how many rolls of wallpaper to order, see how every drop is cut from the rolls, and get the primer, lining and paste for the wall. No price."
  path="/calculator/"
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page pb-20">
    <header class="page-head guide-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">Calculator</p>
      <h1>Wallpaper calculator</h1>
      <p class="lede mt-5">Tell us the paper and the wall, and the calculator cuts every drop from the rolls the way we do. You get the working rolls, one spare roll on its own line, the order, the cutting plan, and the primer, lining and paste for the wall. It gives a quantity to order, not a set-out, and never a price.</p>
    </header>
    <WallpaperingNav current="calculator" />

    <form class="qc grid gap-8" data-quantity aria-labelledby="calculator-heading" novalidate>
      <h2 id="calculator-heading" class="m-0 text-[1.6rem]">Roll calculator</h2>
      <noscript><p class="m-0">The calculator needs JavaScript. Our guide to <a href="/advice/quantities/">how much wallpaper to order</a> shows the same method by hand, or <a href="/contact/?intent=install">send us your measurements</a>.</p></noscript>

      <fieldset class="qc-step">
        <legend><span class="eyebrow">1</span> The wallpaper</legend>
        <div class="grid gap-5 md:grid-cols-2">
          <div class="field">
            <label for="qc-maker">Maker</label>
            <select id="qc-maker" name="maker">
              <option value="">Not sure, or another maker</option>
              {makerOptions.map((option) => <option value={option.id} data-no-infill={option.noInfill ? 'true' : undefined}>{option.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="qc-link">Or paste the product link <span class="text-stone">(optional)</span></label>
            <input id="qc-link" name="link" type="url" inputmode="url" autocomplete="off" placeholder="https://" />
            <p class="qc-hint form-note" data-link-note hidden></p>
          </div>
          <div class="field md:col-span-2">
            <label for="qc-format">Roll size</label>
            <select id="qc-format" name="format">
              {groups.map((group) => (
                <optgroup label={group.label}>
                  {group.presets.map((format) => (
                    <option value={format.id} data-group={group.id} data-width={format.width} data-wunit={format.widthUnit} data-length={format.length ?? ''} data-lunit={format.lengthUnit} data-overlap={format.overlapCm ?? 0} data-sets={format.rollsPerSet}>{formatLabel(format)}</option>
                  ))}
                  {!sizeless(group.id) && <option value={`other-${group.id}`} data-group={group.id} data-other="true">Another size: type it below</option>}
                </optgroup>
              ))}
            </select>
          </div>
          <div class="field" data-paper-size>
            <label for="qc-roll-width">Width</label>
            <div class="qc-unit">
              <input id="qc-roll-width" name="rollWidth" type="number" inputmode="decimal" min="0" step="0.01" value="53" list="qc-widths" />
              <select name="widthUnit" aria-label="Width unit"><option value="cm">cm</option><option value="in">in</option></select>
            </div>
            <datalist id="qc-widths" data-cm={rollFormats.widthSuggestions.cm.join(' ')} data-in={rollFormats.widthSuggestions.in.join(' ')}>
              {rollFormats.widthSuggestions.cm.map((width) => <option value={width} />)}
            </datalist>
          </div>
          <div class="field" data-paper-size>
            <label for="qc-roll-length">Roll length</label>
            <div class="qc-unit">
              <input id="qc-roll-length" name="rollLength" type="number" inputmode="decimal" min="0" step="0.01" value="10.05" />
              <select name="lengthUnit" aria-label="Length unit"><option value="m">m</option><option value="ft">ft</option><option value="yd">yd</option></select>
            </div>
          </div>
          <div class="field" data-overlap-field hidden>
            <label for="qc-overlap">Overlap at each joint, cm</label>
            <input id="qc-overlap" name="overlap" type="number" inputmode="decimal" min="0" step="0.5" value="0" />
            <p class="qc-hint form-note">Wide goods are usually overlapped and cut through. Use the overlap on the maker's sheet, or 0 for butt joints.</p>
          </div>
          <div class="field" data-set-field hidden>
            <label for="qc-sets">Rolls in each set</label>
            <input id="qc-sets" name="rollsPerSet" type="number" inputmode="numeric" min="2" step="1" value="2" />
          </div>
          <div class="field" data-paper-size>
            <label for="qc-match">Pattern match</label>
            <select id="qc-match" name="match">
              <option value="free">Free match, or plain</option>
              <option value="reverse">Reverse hang</option>
              <option value="straight">Straight match</option>
              <option value="half">Half-drop</option>
              <option value="third">Third drop</option>
              <option value="quarter">Quarter drop</option>
            </select>
          </div>
          <div class="field" data-paper-size data-repeat-field>
            <label for="qc-repeat">Pattern repeat, cm</label>
            <input id="qc-repeat" name="repeat" type="number" inputmode="decimal" min="0" step="0.1" value="0" />
          </div>
          <div class="field" data-mural-field hidden>
            <label for="qc-margin">Margin the mural maker asks you to add, cm</label>
            <input id="qc-margin" name="margin" type="number" inputmode="decimal" min="0" step="0.5" value="10" />
          </div>
        </div>
        <p class="qc-hint form-note">Not sure? Leave the standard roll and free match: the result says what it assumed. The roll size, repeat and match are on the product page or the label. Any width can be typed, in centimetres or inches.</p>
      </fieldset>

      <fieldset class="qc-step">
        <legend><span class="eyebrow">2</span> The wall or the room</legend>
        <div class="quantity-measure" role="radiogroup" aria-label="Measure by">
          <label><input type="radio" name="measure" value="wall" checked /> One wall</label>
          <label><input type="radio" name="measure" value="walls" /> Several walls</label>
          <label><input type="radio" name="measure" value="room" /> A whole room</label>
        </div>
        <div data-walls class="grid gap-4">
          <div class="qc-wall grid gap-5 md:grid-cols-2" data-wall>
            <div class="field"><label>Wall width, cm <input name="width" type="number" inputmode="decimal" min="0" step="0.1" value="500" /></label></div>
            <div class="field"><label>Height to paper, cm <input name="height" type="number" inputmode="decimal" min="0" step="0.1" value="270" /></label></div>
          </div>
        </div>
        <button class="btn btn-line" type="button" data-add-wall hidden>Add another wall</button>
        <div data-room class="grid gap-5 md:grid-cols-3" hidden>
          <div class="field"><label>Room length, cm <input name="roomLength" type="number" inputmode="decimal" min="0" step="0.1" value="400" /></label></div>
          <div class="field"><label>Room width, cm <input name="roomWidth" type="number" inputmode="decimal" min="0" step="0.1" value="350" /></label></div>
          <div class="field"><label>Height to paper, cm <input name="roomHeight" type="number" inputmode="decimal" min="0" step="0.1" value="270" /></label></div>
        </div>
        <p class="qc-hint form-note">Height to paper: from the top of the skirting to where the paper stops, at the ceiling, the cornice or the picture rail. A room is counted as one run round its walls.</p>
      </fieldset>

      <details class="qc-step qc-more" data-more>
        <summary><span class="eyebrow">3</span> Openings, returns and the wall <span class="text-stone">(optional)</span></summary>
        <div class="grid gap-6 mt-5">
          <div class="field md:max-w-md">
            <label for="qc-condition">{wallpapering.conditionQuestion.label}</label>
            <select id="qc-condition" name="condition">
              {conditions.map((option) => <option value={option.id}>{option.label}</option>)}
            </select>
          </div>
          <div class="grid gap-3">
            <p class="m-0 font-medium">Doors, windows and niches</p>
            <div data-openings class="grid gap-4"></div>
            <div class="flex flex-wrap gap-3">
              <button class="btn btn-line" type="button" data-add-opening="window">Add a window</button>
              <button class="btn btn-line" type="button" data-add-opening="door">Add a door</button>
              <button class="btn btn-line" type="button" data-add-opening="niche">Add a niche</button>
            </div>
          </div>
          <div class="grid gap-3">
            <p class="m-0 font-medium">Chimney breast and alcove returns</p>
            <div data-returns class="grid gap-4"></div>
            <button class="btn btn-line justify-self-start" type="button" data-add-return>Add a return</button>
            <p class="qc-hint form-note m-0">Each side of a chimney breast or an alcove is a return. Its depth is added to the width of the wall.</p>
          </div>
          <fieldset class="quantity-measure">
            <legend>Anything else about the space?</legend>
            <label><input type="checkbox" name="bespoke" value="stairs" /> A stairwell</label>
            <label><input type="checkbox" name="bespoke" value="slope" /> A sloping wall or ceiling</label>
            <label><input type="checkbox" name="bespoke" value="curved" /> A curved wall</label>
            <label><input type="checkbox" name="bespoke" value="ceiling" /> The ceiling</label>
          </fieldset>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="field"><label>Trim at the top, cm <input name="trimTop" type="number" inputmode="decimal" min="0" step="0.5" value="5" /></label></div>
            <div class="field"><label>Trim at the bottom, cm <input name="trimBottom" type="number" inputmode="decimal" min="0" step="0.5" value="5" /></label></div>
          </div>
        </div>
      </details>

      <div class="flex flex-wrap gap-3">
        <button class="btn btn-solid-ink" type="submit">Work it out</button>
      </div>
      <div class="qc-result" data-quantity-output role="status" aria-live="polite" tabindex="-1" hidden></div>
    </form>

    <template data-opening-template>
      <div class="qc-opening grid gap-4 md:grid-cols-3" data-opening>
        <p class="m-0 md:col-span-3 font-medium" data-opening-title></p>
        <div class="field" data-opening-wall hidden><label>On wall <select name="o-wall"></select></label></div>
        <div class="field"><label>Width, cm <input name="o-width" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
        <div class="field"><label>Height, cm <input name="o-height" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
        <div class="field" data-from-floor><label><span data-from-floor-label>Sill above the skirting, cm</span> <input name="o-floor" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
        <div class="field"><label>Reveal depth, cm <input name="o-depth" type="number" inputmode="decimal" min="0" step="0.1" value="0" /></label></div>
        <div class="field" data-reveals><label>Papered reveals
          <select name="o-reveals"><option value="none">None</option><option value="sides">Sides</option><option value="sides-head">Sides and head</option></select>
        </label></div>
        <button class="btn btn-line md:col-span-3 justify-self-start" type="button" data-remove>Remove</button>
      </div>
    </template>
    <template data-return-template>
      <div class="qc-return grid gap-4 md:grid-cols-3" data-return>
        <div class="field" data-return-wall hidden><label>On wall <select name="r-wall"></select></label></div>
        <div class="field"><label>Return depth, cm <input name="r-depth" type="number" inputmode="decimal" min="0" step="0.1" /></label></div>
        <button class="btn btn-line justify-self-start self-end" type="button" data-remove>Remove</button>
      </div>
    </template>

    <section class="guide-next mt-16">
      <p class="eyebrow">How it counts</p>
      <h2>The method, with worked examples.</h2>
      <p>Why width decides the number of drops, how the pattern repeat changes the cut, why we count drops rather than add a percentage, and when doors and windows save a drop: our guide to <a href="/advice/quantities/">how much wallpaper to order</a> works through it by hand. The materials follow our <a href="/wallpapering/preparation/">preparation tables</a> and the <a href="/wallpapering/lining-and-adhesives/">lining papers, pastes and primers</a> we use.</p>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-solid-ink" href="/contact/?intent=install">Send us your measurements</a>
        <a class="btn btn-line" href="/advice/quantities/">Read the guide</a>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/quantity-ui';
</script>

<style is:global>
  .qc { max-width: 52rem; }
  .qc-step { margin: 0; padding: 1.5rem 0 0; border: 0; border-top: 1px solid var(--color-line); display: grid; gap: 1.25rem; }
  .qc-step > legend, .qc-more > summary { padding: 0; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; }
  .qc-step legend .eyebrow, .qc-more summary .eyebrow { display: inline-block; margin: 0 .5rem 0 0; vertical-align: middle; font-family: var(--font-sans, inherit); }
  .qc-more > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; gap: .25rem; flex-wrap: wrap; }
  .qc-hint { margin: 0; color: var(--color-stone); font-size: .9rem; }
  .qc-unit { display: flex; gap: .5rem; }
  .field .qc-unit input { flex: 1 1 auto; min-width: 0; }
  .field .qc-unit select { flex: 0 0 auto; width: 5.25rem; }
  .qc-opening, .qc-return { border-left: 2px solid var(--color-line); padding-left: 1rem; }
  .quantity-measure { margin: 0; padding: 0; border: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; }
  .quantity-measure legend { padding: 0; margin-bottom: .5rem; font-weight: 500; }
  .quantity-measure label { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; }
  .qc-result { border-top: 2px solid var(--color-ink); padding-top: 1.5rem; display: grid; gap: 1.5rem; }
  .qc-result:focus { outline: none; }
  .qc-order { display: grid; gap: .25rem; margin: 0; }
  .qc-order div { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr; gap: .25rem 1rem; align-items: baseline; padding: .6rem 0; border-bottom: 1px solid var(--color-line); }
  .qc-order dd { display: grid; gap: .15rem; }
  .qc-note { color: var(--color-stone); font-size: .95rem; }
  @media (max-width: 47.99rem) { .qc-order div { grid-template-columns: 1fr; } }
  .qc-order dt { font-size: var(--text-eyebrow); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--color-brass); }
  .qc-order dd { margin: 0; }
  .qc-order strong { font-family: var(--font-serif); font-size: 1.9rem; font-weight: 500; line-height: 1.1; white-space: nowrap; }
  .qc-order .qc-total strong { font-size: 2.4rem; }
  .qc-warning { margin: 0; padding: .9rem 1rem; background: var(--color-ivory-deep); border-left: 3px solid var(--color-brass); }
  .qc-result h3 { margin: 0 0 .5rem; font-size: 1.35rem; }
  .qc-result ul, .qc-result ol { margin: 0; padding-left: 1.2rem; display: grid; gap: .35rem; }
  .qc-result p { margin: 0; }
  .qc-plan li { overflow-wrap: anywhere; }
  .qc-materials li span { display: block; color: var(--color-stone); font-size: .9rem; }
  .qc-materials a, .qc-result p a { color: inherit; text-decoration: underline; text-decoration-color: var(--color-brass); text-underline-offset: 3px; }
  .qc-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .qc-small { color: var(--color-stone); }
  @media print {
    .qc-step, .qc-more, .qc button[type="submit"], .qc-actions, .wp-subnav, .guide-layout, .page-head .lede { display: none !important; }
    .qc-result { border: 0; }
  }
</style>
