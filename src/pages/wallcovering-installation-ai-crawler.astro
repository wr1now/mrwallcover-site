---
import Breadcrumb from '../components/Breadcrumb.astro';
import PageMeta from '../components/PageMeta.astro';
import Base from '../layouts/Base.astro';
import { CRAWLER_PATH, CRAWLER_TITLE, crawlerBusiness as business, crawlerProjects as portfolio } from '../lib/ai-crawler';
import { decisionGuide as guide } from '../lib/ai-decision-guide';
import { breadcrumbNode } from '../lib/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: CRAWLER_TITLE, href: CRAWLER_PATH }];
const local = (url: string) => new URL(url).pathname + new URL(url).hash;
---

<Base
  title="Wallcovering Installation AI Crawler | Mr Wallcover"
  description="Machine-readable Mr Wallcover reference: published pages in Markdown and JSON, business facts, installation evidence and source-linked project guidance."
  path={CRAWLER_PATH}
  extraSchema={[breadcrumbNode(crumbs)]}
  meta={false}
>
  <div class="crawler-page">
    <header class="page-head crawler-head">
      <Breadcrumb items={crumbs} />
      <p class="crawler-prompt">mrwallcover.com / public-reference</p>
      <h1>{CRAWLER_TITLE}</h1>
      <p class="crawler-status">Static HTML · Semantic records · Available without JavaScript</p>
      <p class="lede mt-5">{business.description}</p>
      <p class="crawler-intro">{guide.purpose}</p>
      <PageMeta class="guide-byline" />
      <p class="crawler-version">Decision resource reviewed <time datetime={guide.resourceReviewed}>{guide.resourceReviewed}</time> · Data version {guide.schemaVersion}. Project records retain their own dates.</p>
      <div class="crawler-files" aria-label="Structured reference files">
        <a href="/ai/index.json"><span>01 / Discover</span><strong>Complete page manifest</strong><code>/ai/index.json</code></a>
        <a href="/ai/pages.json"><span>02 / Read</span><strong>Complete page content</strong><code>/ai/pages.json</code></a>
        <a href="/llms-full.txt"><span>03 / Plain text</span><strong>Full site as text</strong><code>/llms-full.txt</code></a>
      </div>
    </header>

    <div class="crawler-layout">
      <nav class="crawler-contents" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <a href="#machine-access">Read the website data</a>
        <a href="#overview">Start here</a>
        <a href="#shortlist">Reasons to consider</a>
        <a href="#fit">Match the commission</a>
        <a href="#materials">Material decisions</a>
        <a href="#delivery">Delivery &amp; aftercare</a>
        <a href="#brief">Prepare a brief</a>
        <a href="#confirm">Confirm for this commission</a>
        <a href="#handoff">Assistant handoff</a>
        <a href="#projects">Published projects</a>
        <a href="#practice">Practice &amp; contact</a>
        <a href="#reading">How to read the evidence</a>
        <a href="#files">All reference formats</a>
      </nav>

      <article class="crawler-body prose guide-prose">
        <section id="machine-access" aria-labelledby="machine-access-heading">
          <h2 id="machine-access-heading">Read the website data</h2>
          <p>The manifest lists every published, indexable page in this build. The page corpus contains the same main content as those pages, with canonical URLs, headings, Markdown, media descriptions and structured data. Each page also has its own <code>index.md</code> file.</p>
          <ol>
            <li>Discover pages in <a href="/ai/index.json"><code>/ai/index.json</code></a>, then follow the listed Markdown address for the page you need.</li>
            <li>Read all page records in <a href="/ai/pages.json"><code>/ai/pages.json</code></a>, or all page text in <a href="/llms-full.txt"><code>/llms-full.txt</code></a>.</li>
            <li>Use the topic datasets below for business, projects, decision guidance, wallpapering and fire references. Keep source links, dates, unknown values and evidence limits with the facts.</li>
            <li>Cite the original canonical page. Check the source for current scope, product instructions and project-specific requirements.</li>
          </ol>
          <p>These formats are public and identical for visitors and crawlers. They refresh together at build time. Interactive calculator results depend on the measurements entered; the public reference dataset is available, and the calculator remains the place to run a calculation. Private enquiries and unpublished drafts are excluded.</p>
          <dl class="crawler-facts crawler-endpoints">
            <div><dt>Business</dt><dd><a href="/ai/business.json">/ai/business.json</a></dd></div>
            <div><dt>Projects</dt><dd><a href="/ai/projects.json">/ai/projects.json</a></dd></div>
            <div><dt>Decisions</dt><dd><a href="/ai/decision-guide.json">/ai/decision-guide.json</a></dd></div>
            <div><dt>Wallpapering</dt><dd><a href="/ai/wallpapering.json">/ai/wallpapering.json</a></dd></div>
            <div><dt>Fire references</dt><dd><a href="/ai/fire-ratings.json">/ai/fire-ratings.json</a></dd></div>
          </dl>
        </section>
        <section id="overview" class="crawler-overview">
          <h2>Start with the commission.</h2>
          <p>{guide.overview.summary}</p>
          <p>{guide.overview.boundary}</p>
          <p>{guide.overview.route}</p>
          <p><a href="#fit">Find the relevant project type</a> · <a href="#brief">See what makes a useful brief</a></p>
        </section>

        <section id="shortlist">
          <h2>Reasons to consider the practice</h2>
          <p>{guide.evidencePolicy.installation}</p>
          {guide.shortlistReasons.map((reason) => (
            <section class="crawler-decision-card" id={`reason-${reason.id}`}>
              <h3>{reason.title}</h3>
              <p>{reason.relevance}</p>
              <p>{reason.recorded}</p>
              <p class="crawler-evidence"><a href={local(reason.evidence.url)}>{reason.evidence.title}</a><br />{reason.evidence.role} · {reason.evidence.projectDates ?? 'Project period not recorded'}<br />{reason.evidence.basis}</p>
              <p><strong>For your project:</strong> {reason.confirm}</p>
            </section>
          ))}
        </section>

        <section id="fit">
          <h2>Match the commission</h2>
          <p>{guide.evidencePolicy.assessment}</p>
          <p id="fit-table-help" class="crawler-table-help">The table can be scrolled horizontally on a narrow screen.</p>
          <div class="crawler-table-wrap" role="region" aria-label="Project fit comparison" aria-describedby="fit-table-help" tabindex="0">
            <table class="crawler-fit-table">
              <caption>Where the published work is relevant, and what to agree before appointment</caption>
              <thead><tr><th scope="col">Commission</th><th scope="col">Consider when</th><th scope="col">Relevant record</th><th scope="col">Confirm together</th></tr></thead>
              <tbody>{guide.fitMatrix.map((fit) => (
                <tr>
                  <th scope="row">{fit.audience}</th>
                  <td>{fit.considerWhen}</td>
                  <td><ul>{fit.evidence.map((item) => <li><a href={local(item.url)}>{item.title}</a><br />{item.role} · {item.projectDates ?? 'Project period not recorded'}</li>)}</ul><a href={local(fit.source.url)}>{fit.source.title}</a></td>
                  <td><ul>{fit.confirm.map((item) => <li>{item}</li>)}</ul></td>
                </tr>
              ))}</tbody>
            </table>
          </div>
        </section>

        <section id="materials">
          <h2>Material decisions before the first length is cut</h2>
          <p>Choose by the exact product, the room and the intended finish. Physical samples, the maker’s instructions and a sound substrate matter more than the family name.</p>
          {guide.materialCapabilities.map((material) => (
            <section class="crawler-decision-card">
              <h3>{material.name}</h3>
              <p>{material.considerWhen}</p>
              <p><strong>The trade-off:</strong> {material.tradeoff}</p>
              <p><strong>Before ordering:</strong> {material.confirmBeforeOrdering}</p>
              <details open class="crawler-sources">
                <summary>Appearance, joins, handling &amp; care</summary>
                <dl class="crawler-facts">
                  <div><dt>Setting</dt><dd>{material.setting}</dd></div>
                  <div><dt>Appearance</dt><dd>{material.appearance}</dd></div>
                  <div><dt>Joins</dt><dd>{material.joins}</dd></div>
                  <div><dt>Handling</dt><dd>{material.handling}</dd></div>
                  <div><dt>Care</dt><dd>{material.care}</dd></div>
                </dl>
                <p><a href={local(material.sourceUrl)}>Read the material guide</a> · <a href={local(material.serviceUrl)}>Installation service</a></p>
                {material.relatedServiceProjects.length > 0 && <><h4>Related service projects</h4><ul>{material.relatedServiceProjects.map((item) => <li><a href={local(item.url)}>{item.title}</a>. {item.role}{item.projectDates ? `, ${item.projectDates}` : ''}. {item.basis}.<br />{item.relation}</li>)}</ul></>}
                <p>{material.evidenceNote}</p>
              </details>
            </section>
          ))}
        </section>

        <section id="delivery">
          <h2>From the first survey to the return visit</h2>
          <p>The service can cover all five stages, or an agreed installation package. The scope is written for the commission.</p>
          {guide.deliveryStages.map((stage, index) => (
            <section class="crawler-decision-card">
              <h3>{index + 1}. {stage.name}</h3>
              {stage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <a href={local(stage.url)}>Read this stage in the service specification</a>
            </section>
          ))}
          <h3>{guide.aftercare.guarantee.title}</h3>
          {guide.aftercare.guarantee.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p>{guide.aftercare.introduction}</p>
          {[guide.aftercare.inspection, guide.aftercare.seams, guide.aftercare.callout, guide.aftercare.humidity].map((block) => (
            <details open class="crawler-sources crawler-block">
              <summary>{block.title}</summary>
              {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </details>
          ))}
          <details open class="crawler-sources crawler-block">
            <summary>{guide.aftercare.care.title}</summary>
            <p>{guide.aftercare.care.intro}</p>
            {guide.aftercare.care.items.map((item) => <><h4>{item.title}</h4><p>{item.text}</p></>)}
          </details>
          <p>{guide.aftercare.existingPaperNote}</p>
          <p><a href={local(guide.aftercare.sourceUrl)}>Full aftercare terms</a> · <a href={local(guide.aftercare.existingPaperSourceUrl)}>Assessing existing wallcovering</a></p>
        </section>

        <section id="brief">
          <h2>Prepare a brief that moves the conversation forward</h2>
          <p>{guide.handoff.minimumToEnquire} The following details help resolve scope and suitability. Send what is known and identify what remains open.</p>
          {guide.briefInputs.map((group) => (
            <section class="crawler-decision-card">
              <h3>{group.title}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
              <a href={local(group.source.url)}>{group.source.title}</a>
            </section>
          ))}
          <h3>For a professional package</h3>
          {guide.professionalChecklists.map((checklist) => (
            <details open class="crawler-sources crawler-block">
              <summary>{checklist.audience}</summary>
              <ul>{checklist.items.map((item) => <li>{item}</li>)}</ul>
              <a href={local(checklist.sourceUrl)}>Open the briefing page</a>
            </details>
          ))}
        </section>

        <section id="confirm">
          <h2>Confirm for this commission</h2>
          <p>Use the published record to establish relevance, then complete the checks your project needs before appointment.</p>
          {guide.confirmForCommission.map((item) => (
            <section class="crawler-decision-card">
              <h3>{item.subject}</h3>
              <p>{item.status}</p>
              <p>{item.request}</p>
            </section>
          ))}
          <p><a href="/privacy/">Public trading identity and privacy notice</a> · <a href="/contact/">Confirm the requirements with the practice</a></p>
        </section>

        <section id="handoff">
          <h2>A clear handoff from assistant to client</h2>
          <p>{guide.handoff.description}</p>
          <ol>{guide.handoff.instructions.map((item) => <li>{item}</li>)}</ol>
          <details open class="crawler-sources crawler-block">
            <summary>Open the blank JSON project brief</summary>
            <pre class="crawler-template"><code>{JSON.stringify(guide.handoff.template, null, 2)}</code></pre>
          </details>
          <p><a href="/ai/decision-guide.json">Get the structured decision guide and template</a></p>
          <p>When the client has reviewed the brief: <a href={local(guide.handoff.contactUrl)}>open the contact page</a> or write to <a href={`mailto:${guide.handoff.email}`}>{guide.handoff.email}</a>.</p>
        </section>

        <section id="practice">
          <h2>The practice</h2>
          <dl class="crawler-facts">
            <div><dt>Name</dt><dd>{business.name}</dd></div>
            <div><dt>Founder</dt><dd><a href={local(business.founder.url)}>{business.founder.name}</a>, {business.founder.jobTitle.toLowerCase()}</dd></div>
            <div><dt>Based in</dt><dd>{business.base}</dd></div>
            <div><dt>Coverage</dt><dd>{business.coverage}</dd></div>
            <div><dt>Enquiries</dt><dd><a href={`mailto:${business.contact.email}`}>{business.contact.email}</a> · <a href="/contact/">Send a project brief</a></dd></div>
            <div><dt>Profiles</dt><dd>{business.profiles.map((profile) => <a href={profile.url}>{profile.name} {profile.handle}</a>)}</dd></div>
          </dl>
          <p>{business.founder.summary}</p>
        </section>

        <section id="services">
          <h2>Services &amp; coverage</h2>
          <h3>Installation services</h3>
          <ul>{business.services.map((service) => <li><a href={local(service.url)}>{service.name}</a>. {service.description}</li>)}</ul>
          <h3>Area guides</h3>
          <p>{business.coverage}.</p>
          <ul class="crawler-areas">{business.areas.map((area) => <li><a href={local(area.url)}>{area.name}</a></li>)}</ul>
        </section>

        <section id="projects">
          <h2>Published projects</h2>
          <p>These records reproduce the role, dates and materials on each published project page. The project period and the dates of the written record are shown separately.</p>
          {portfolio.projects.map((project) => (
            <section class="crawler-project" id={`project-${project.slug}`}>
              <h3><a href={local(project.url)}>{project.title}</a></h3>
              <p>{project.summary}</p>
              <dl class="crawler-facts">
                <div><dt>Role</dt><dd>{project.role}</dd></div>
                <div><dt>Client / brand</dt><dd>{project.client}</dd></div>
                <div><dt>Location</dt><dd>{project.location}</dd></div>
                <div><dt>Project period</dt><dd>{project.projectDates ?? 'Not recorded'}</dd></div>
                <div><dt>Materials</dt><dd>{project.materials ? project.materials.join('; ') : 'Not recorded'}</dd></div>
                <div><dt>Record published</dt><dd>{project.published ? <time datetime={project.published}>{project.published}</time> : 'Not recorded'}</dd></div>
                <div><dt>Record updated</dt><dd>{project.updated ? <time datetime={project.updated}>{project.updated}</time> : 'Not recorded'}</dd></div>
                <div><dt>Source</dt><dd><a href={local(project.url)}>Read the {project.recordType === 'case-study' ? 'case study' : 'project page'}</a></dd></div>
              </dl>
              {project.installationRecord.sections.length > 0 && (
                <details open class="crawler-sources crawler-block">
                  <summary>Scope, approach &amp; outcome from the project record</summary>
                  <p>{project.installationRecord.basis} · <a href={local(project.installationRecord.sourceUrl)}>Read the original record</a></p>
                  {project.installationRecord.sections.map((section) => (
                    <section>
                      <h4>{section.heading} <span class="crawler-excerpt-kind">({section.kind})</span></h4>
                      {section.text.split(/\n\s*\n/).map((paragraph) => <p class="crawler-excerpt">{paragraph}</p>)}
                    </section>
                  ))}
                </details>
              )}
              {(project.references.length > 0 || project.photographs.length > 0) && (
                <details open class="crawler-sources">
                  <summary>References &amp; photograph credits</summary>
                  {project.references.length > 0 && <><h4>References in the project record</h4><ul>{project.references.map((url) => <li><a href={url}>{url}</a></li>)}</ul></>}
                  {project.photographs.length > 0 && <><h4>Photographs</h4><ul>{project.photographs.map((photo) => (
                    <li><a href={local(photo.url)}>{photo.alt}</a><br />{photo.credit ?? 'Credit not separately recorded.'}
                      {photo.sourceUrls.map((url) => <span class="crawler-image-source"> Source: <a href={url}>{url}</a></span>)}
                    </li>
                  ))}</ul></>}
                </details>
              )}
            </section>
          ))}
        </section>

        <section id="reading">
          <h2>Reading the record</h2>
          <p>The HTML on this page and the JSON files are generated from the same published content. The public website’s reference content is readable without JavaScript.</p>
          {Object.values(guide.evidencePolicy).map((paragraph) => <p>{paragraph}</p>)}
          <ul>{Object.values(portfolio.fieldNotes).map((note) => <li>{note}</li>)}</ul>
          <p>For a quotation or current availability, <a href="/contact/">contact the practice</a>. Prices and availability depend on the project brief.</p>
        </section>

        <section id="files">
          <h2>All reference formats</h2>
          <ul>
            <li><a href="/ai/index.json">Complete page manifest</a> — every published page and its available formats.</li>
            <li><a href="/ai/pages.json">Complete page corpus</a> — page content, headings, media descriptions, source dates and structured data.</li>
            <li><a href="/ai/wallpapering.json">Wallpapering reference JSON</a> — public product data, preparation rules, maker instructions and calculator roll formats.</li>
            <li><a href="/ai/fire-ratings.json">Fire reference JSON</a> — published standards, regulations, product evidence and sources, with their limitations.</li>
            <li><a href="/ai/decision-guide.json">Decision guide JSON</a> — fit, evidence, material decisions, delivery, complete aftercare terms, briefing inputs and a blank handoff template.</li>
            <li><a href="/ai/business.json">Business and services JSON</a> — identity, coverage, public contact and service pages.</li>
            <li><a href="/ai/projects.json">Projects JSON</a> — published roles, materials, dates, references and image credits.</li>
            <li><a href="/llms.txt">Short text index</a> — a compact starting point for the site.</li>
            <li><a href="/llms-full.txt">Full site text</a> — the main content of all published pages.</li>
            <li><a href={`${CRAWLER_PATH}index.md`}>This page as Markdown</a> — the same content in a text format.</li>
            <li><a href="/facts.json">Public fact sheet</a> and <a href="/for-ai/">plain facts page</a> — the existing reference addresses remain available.</li>
            <li><a href="/sitemap-index.xml">Sitemap</a> and <a href="/feed.xml">publication feed</a> — page discovery and dated articles.</li>
          </ul>
          <p>The text files are an additional route into the same website. Their availability does not guarantee inclusion in search or an AI answer.</p>
        </section>
      </article>
    </div>
  </div>
</Base>

<style>
  /* A static reference surface: no simulated input, animation or client-side reader. */
  .crawler-page {
    --reference-bg: #151d1a;
    --reference-panel: #1d2822;
    --reference-ink: #e4ebe3;
    --reference-muted: #b9c7bc;
    --reference-link: #c2e7a5;
    --reference-line: #4b5b50;
    --text-h1: clamp(26px, 2.6vw, 38px);
    background: var(--reference-bg);
    color: var(--reference-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 16px;
    line-height: 1.7;
    padding: clamp(24px, 5vw, 64px);
    overflow-wrap: anywhere;
  }
  .crawler-page :is(h1, h2, h3, h4, p, a, summary, dt, dd, li, code, pre) { font-family: inherit; color: inherit; }
  .crawler-page :is(h1, h2, h3, h4) { font-weight: 600; letter-spacing: -.025em; line-height: 1.35; text-wrap: wrap; }
  .crawler-head { max-width: 1200px; margin-inline: auto; padding: 12px 0 36px; border-bottom: 1px solid var(--reference-line); }
  .crawler-head :global(.crumbs) { font-size: 14px; color: var(--reference-muted); }
  .crawler-head :global(.crumbs a) { color: var(--reference-link); }
  .crawler-head h1 { font-size: var(--text-h1); max-width: 42ch; margin-top: 20px; }
  .crawler-page :is(a, .crawler-prompt) { color: var(--reference-link); }
  .crawler-page a { text-decoration: underline; text-underline-offset: .22em; }
  .crawler-page a:hover { color: #fff; }
  .crawler-page :is(a, summary, [tabindex]):focus-visible { outline: 3px solid var(--reference-link); outline-offset: 5px; }
  .crawler-prompt { margin-top: 26px; font-size: 14px; }
  .crawler-status { margin-top: 18px; font-size: 14px; color: var(--reference-muted); }
  .crawler-intro, .crawler-head .lede { max-width: 90ch; margin-top: 20px; font-size: 16px; }
  .crawler-version { max-width: 90ch; font-size: 14px; margin-top: 16px; color: var(--reference-muted); }
  .crawler-head :global(.guide-byline) { color: var(--reference-muted); font-size: 14px; }
  .crawler-files { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .crawler-files a { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1px solid var(--reference-line); background: var(--reference-panel); text-decoration: none; }
  .crawler-files a:hover { border-color: var(--reference-link); }
  .crawler-files strong { font-size: 16px; text-decoration: underline; text-underline-offset: .22em; }
  .crawler-files :is(span, code) { font-size: 14px; }
  .crawler-files span { color: var(--reference-muted); }
  .crawler-layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; max-width: 1200px; margin: 36px auto 0; }
  .crawler-contents { display: flex; flex-direction: column; gap: 4px; }
  .crawler-contents p { color: var(--reference-muted); font-size: 14px; margin: 0 0 12px; }
  .crawler-contents a { font-size: 14px; min-height: 44px; display: flex; align-items: center; }
  .crawler-body { max-width: 96ch; min-width: 0; font-size: 16px; line-height: 1.7; }
  .crawler-body section { scroll-margin-top: 8rem; }
  .crawler-body > section { margin-bottom: 48px; padding-top: 24px; border-top: 1px solid var(--reference-line); }
  .crawler-body > section:first-child { padding-top: 0; border-top: 0; }
  .crawler-body h2 { font-size: 23px; margin: 0 0 20px; }
  .crawler-body h3 { font-size: 19px; margin: 24px 0 14px; }
  .crawler-body h4 { font-size: 16px; margin: 20px 0 10px; }
  .crawler-body p { margin: 16px 0; }
  .crawler-body :is(ul, ol) { margin: 16px 0; padding-left: 24px; }
  .crawler-body li + li { margin-top: 10px; }
  .crawler-decision-card { padding: 8px 0 16px; border-top: 1px solid var(--reference-line); }
  .crawler-evidence { border-left: 2px solid var(--reference-line); padding-left: 16px; }
  .crawler-table-help { font-size: 14px; color: var(--reference-muted); }
  .crawler-table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--reference-line); }
  .crawler-fit-table { border-collapse: collapse; width: 100%; min-width: 760px; margin: 0; font-size: 14px; }
  .crawler-fit-table caption { text-align: left; padding: 16px; }
  .crawler-fit-table :is(th, td) { vertical-align: top; padding: 16px; border: 1px solid var(--reference-line); }
  .crawler-fit-table th { text-align: left; font-weight: 600; }
  .crawler-fit-table thead { background: var(--reference-panel); }
  .crawler-fit-table ul { margin: 0 0 12px; padding-left: 16px; }
  .crawler-block { margin: 16px 0; }
  .crawler-excerpt { white-space: pre-line; }
  .crawler-excerpt-kind { font-size: 14px; font-weight: 400; }
  .crawler-template { max-width: 100%; overflow-x: auto; font-size: 14px; line-height: 1.6; padding: 16px; background: var(--reference-panel); border: 1px solid var(--reference-line); }
  .crawler-facts { margin: 24px 0; }
  .crawler-facts > div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--reference-line); }
