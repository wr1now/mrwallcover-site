---
import { ANALYTICS_SRC, PUBLIC_EMAIL } from '../config';
import Breadcrumb from '../components/Breadcrumb.astro';
import Base from '../layouts/Base.astro';
import { privacy } from '../lib/content';
import { phoneAvailable } from '../lib/phone';
import { breadcrumbNode } from '../lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy', href: '/privacy/' },
];
// With analytics switched on at build time, the notice describes it; otherwise it says none runs.
const analyticsOn = Boolean(ANALYTICS_SRC);
const lineFor = (paragraph: string) => {
  if (!analyticsOn) return paragraph;
  if (paragraph.includes('does not run analytics')) return privacy.analyticsOn.covers;
  if (paragraph.includes('There is a place in the build for a cookie-free analytics script')) return privacy.analyticsOn.cookies;
  return paragraph;
};
---

<Base
  title={privacy.title}
  description={analyticsOn ? privacy.analyticsOn.description : privacy.description}
  path="/privacy/"
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page pb-20">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{privacy.eyebrow}</p>
      <h1>{privacy.heading}</h1>
      <p class="mt-4 mb-0 text-stone">Updated {privacy.updated}</p>
    </header>
    <div class="grid gap-10">
      <section id="designer-workspace" class="max-w-2xl border-t border-line pt-6">
        <h2 class="m-0 text-[2rem]">Designer project workspace</h2>
        <div class="prose mt-4">
          <p>The project form holds your draft in the current browser tab. It does not automatically save project information or sign-in credentials in browser storage. Downloading a draft creates a file on your device; closing an unsaved tab loses that draft.</p>
          <p>Private saving and uploads are available only when the workspace says the service is active. Signing in and saving sends the selected project details to the private service. These may include your contact details, project address, specifications, programme, drawings and optional property-value context. Authorised studio members and Mr Wallcover staff use them to assess the work and prepare estimates. Uploaded files are checked before becoming available, and extracted information needs human confirmation.</p>
          <p>The workspace does not load the public site's analytics. Original drawings, private notes and property values are excluded from public search and client budget links. A client link exposes the selected estimate, including its project name and site address, until it expires or is revoked. Revoking a link cannot recall files a recipient has already downloaded.</p>
          <p>Contact <a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a> to request access, correction or deletion of saved project information. Retention and any records needed for an agreed installation are handled with you by Mr Wallcover. The workspace does not promise automatic deletion when a tab closes.</p>
        </div>
      </section>
      {
        privacy.sections.map((section) => (
          <section class="max-w-2xl border-t border-line pt-6">
            <h2 class="m-0 text-[2rem]">{section.heading}</h2>
            <div class="prose mt-4">
              {section.paragraphs.map((paragraph) => (
                <p class="m-0">
                  {paragraph.includes('email address published') ? (
                    <>
                      For any privacy request, write to <a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>
                      {phoneAvailable ? (
                        <>, or call the telephone number on the <a href="/contact/">contact page</a>.</>
                      ) : (
                        <>, or use the form on the <a href="/contact/">contact page</a>.</>
                      )}
                    </>
                  ) : paragraph.includes('ico.org.uk') ? (
                    <>
                      To use any of these rights, email <a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>. We may
                      need to confirm it is you. You can also complain to the Information Commissioner's Office at{' '}
                      <a href="https://ico.org.uk/make-a-complaint/">ico.org.uk</a>.
                    </>
                  ) : (
                    lineFor(paragraph)
                  )}
                </p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
