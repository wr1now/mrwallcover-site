---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Action from '../../components/Action.astro';
import MakerRoute from '../../components/MakerRoute.astro';
import MakerDirectoryNav from '../../components/MakerDirectoryNav.astro';
import MakerDirectoryFilter from '../../components/MakerDirectoryFilter.astro';
import MakerCardPhoto from '../../components/MakerCardPhoto.astro';
import { makerDirectory, directoryVisible, directoryReview, type MakerProfile } from '../../lib/makers-directory';
import { breadcrumbNode } from '../../lib/schema';
import '../../styles/makers-directory.css';
export function getStaticPaths(){return directoryVisible?[{params:{slug:undefined},props:{maker:null}},...makerDirectory.makers.map(maker=>({params:{slug:maker.slug},props:{maker}}))]:[];}
interface Props {maker:MakerProfile|null}
const {maker}=Astro.props;
const path=maker?`/makers/${maker.slug}/`:'/makers/';
const crumbs=[{name:'Home',href:'/'},{name:'Wallcovering Guide',href:'/advice/'},{name:'Makers',href:'/makers/'},...(maker?[{name:maker.name,href:path}]:[])];
// A maker whose name already says what it makes (York Wallcoverings, Calico Wallpaper) is not given the word twice.
const title=maker?`${/wallcovering|wallpaper/i.test(maker.name)?maker.name:`${maker.name} Wallcoverings`} | Mr Wallcover`:'Wallcovering Makers Directory | Mr Wallcover';
const description=maker?`Explore ${/wallcovering|wallpaper/i.test(maker.name)?maker.name:`${maker.name} wallcoverings`} and official sourcing contacts, with source dates, purchasing limits and product-specific checks before ordering.`:'Explore twenty international wallcovering brands, their official sourcing routes and the evidence to check before choosing and ordering.';
// Visible dates in UK form (17 October 2026), as on the route cards; the data and datetime stay ISO.
const ukDate=(iso:string)=>new Intl.DateTimeFormat('en-GB',{dateStyle:'long',timeZone:'UTC'}).format(new Date(`${iso}T00:00:00Z`));
// Several sources per maker: each link names its own address, so no two links read the same.
// The address breaks only before a slash (<wbr>), never inside a word or the host name.
const sourceParts=(url:string)=>{const u=new URL(url);return {host:u.hostname.replace(/^www\./,''),segments:u.pathname.replace(/\/$/,'').split('/').filter(Boolean)};};
---
<Base title={title} description={description} path={path} updated={makerDirectory.updated} noindex={directoryReview} extraSchema={[breadcrumbNode(crumbs)]}>
<div class="container-page pb-20">
<header class="page-head maker-intro"><Breadcrumb items={crumbs}/><p class="eyebrow">The Wallcovering Guide · Choose and source</p><h1>{maker?maker.name:'The Makers directory.'}</h1><p class="lede mt-5">{maker?maker.summary:'Find a material, a design approach and the right official contact before you commit to a wallcovering.'}</p>
{!maker&&<><p>{makerDirectory.selection} Inclusion does not imply an endorsement, supplier relationship or installation by Mr Wallcover.</p><p class="maker-photo-guide">“Our installation” shows that maker’s wallcovering in our work. “Craft example” names a different maker and project we have worked on; it illustrates the craft and is not an installation record for the directory brand.</p></>}
{directoryReview&&<p class="maker-review-note">Editorial review preview. Copy approved by the owner on 18 October 2026. Source checks use website evidence; no test order or fulfilment guarantee is implied.</p>}
</header><MakerDirectoryNav/>
{maker?<>
<section class="maker-section"><h2>Source evidence</h2><p>Read the maker’s information for the selected product and destination. A brand profile does not certify a seller or prove that an order will be accepted.</p><ul class="maker-sources">{maker.sources.map(source=>{const parts=sourceParts(source.url);return <li><a href={source.url} target="_blank" rel="noopener noreferrer">Official source: <span class="whitespace-nowrap">{parts.host}</span>{parts.segments.map(segment=><><wbr/>/{segment}</>)}</a> — checked <time datetime={source.checked_on}>{ukDate(source.checked_on)}</time></li>;})}</ul><Action href={maker.website} variant="secondary" target="_blank" rel="noopener noreferrer">Visit maker website</Action></section>
<section class="maker-section" id="routes"><h2>Official sourcing routes</h2>{maker.routes.length?<><p>Check the route’s scope before ordering. Showrooms, samples and finder links do not establish a roll checkout or delivery promise.</p><div class="maker-route-grid">{maker.routes.map(route=><MakerRoute route={route}/>)}</div></>:<p>No purchasing route is listed for this brand. This profile provides brand information only.</p>}</section>
<div class="maker-back"><Action href="/makers/" variant="secondary">All makers</Action></div>
</>:<><MakerDirectoryFilter kind="makers"/><div class="maker-grid">{makerDirectory.makers.map(m=><article class="maker-card" data-directory-item data-search={`${m.name} ${m.summary}`.toLowerCase()}><p class="eyebrow">Maker reference</p><h2><a href={`/makers/${m.slug}/`}>{m.name}</a></h2><MakerCardPhoto slug={m.slug}/><p>{m.summary}</p><p class="maker-date">{m.routes.length?`${m.routes.length} official sourcing ${m.routes.length===1?'route':'routes'}`:'Brand information only'} · source check <time datetime={m.checked_on}>{ukDate(m.checked_on)}</time></p><Action href={`/makers/${m.slug}/`} variant="quiet">Explore {m.name}</Action></article>)}</div></>}
<section class="maker-section"><h2>From sample to specification</h2><p>Record the exact design and product code, check current instructions and establish the wall preparation before quantities and installation are agreed.</p><Action href="/contact/?intent=source">Discuss your wallcovering</Action></section>
</div></Base>
