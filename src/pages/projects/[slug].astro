---
import Action from '../../components/Action.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CaseStudyGlance from '../../components/CaseStudyGlance.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import { pictureSources } from '../../lib/picture';
import Base from '../../layouts/Base.astro';
import { areaHref, areas, caseStudyBySlug, landingProjectSlugs, media, ogImageFor, projectAliases, projectHref, projects, specialismHref, specialisms, videoById } from '../../lib/content';
import { SITE_URL } from '../../config';
import { breadcrumbNode, caseStudyArticleNode, projectNode, videoNode } from '../../lib/schema';
import type { Project } from '../../lib/types';
import method from '../../content/method.json';
import exteriorMethod from '../../content/method-exterior.json';
import retired from '../../content/retired-projects.json';
const methodIcons: IconName[] = ['ruler', 'layers', 'room', 'tag', 'drawing', 'check'];

export function getStaticPaths() {
  return [
    ...projects.map((project) => ({
      params: { slug: project.slug },
      props: { project, redirectTo: null },
    })),
    // Earlier URLs now served by a case study.
    ...Object.entries(projectAliases).map(([oldSlug, newSlug]) => ({
      params: { slug: oldSlug },
      props: { project: projects.find((p) => p.slug === newSlug)!, redirectTo: projectHref(newSlug) },
    })),
    // Retired project URLs (once published, now not a page): back to the work index.
    ...retired.items
      .filter((item) => !projects.some((p) => p.slug === item.slug))
      .map((item) => ({
        params: { slug: item.slug },
        // Only the title is shown on a redirect stub; the rest keeps the page's frontmatter happy.
        props: { project: { ...projects[0], slug: item.slug, title: 'Our work', caseStudy: false, videos: [] } as Project, redirectTo: item.redirectTo },
      })),
  ];
}

interface Props {
  project: Project;
  redirectTo: string | null;
}

const { project, redirectTo } = Astro.props;
const study = project.caseStudy ? caseStudyBySlug(project.slug) : undefined;
const isExterior = study?.frontmatter.method === 'exterior';
const projectMethod = isExterior ? exteriorMethod : method;
const projectMethodIcons: IconName[] = isExterior ? ['ruler', 'room', 'layers', 'drawing', 'swatch', 'calendar'] : methodIcons;
/* Modest (preview-only) heroes are shown at their own pixel width, never stretched past it. */
const modestHeroWidth = project.modest && project.imageId ? media(project.imageId).thumbWidth : 360;
const StudyContent = study?.Content;
const redirectUrl = redirectTo ? new URL(redirectTo, SITE_URL).href : null;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Work', href: '/projects/' },
  { name: project.title, href: projectHref(project.slug) },
];
const films = project.videos.map((id) => videoById(id));
const ogImage = project.imagePolicy === 'none' ? undefined : ogImageFor(project.imageId);
const pageUrl = new URL(projectHref(project.slug), SITE_URL).href;
const galleryAbs = project.gallery.map((id) => ({ url: new URL(media(id).jpg, SITE_URL).href, credit: project.credits?.[id] ?? null }));
const relatedAreas = areas.filter((a) => a.projects.some((slug) => (projectAliases[slug] ?? slug) === project.slug));
const relatedServices = specialisms.filter((s) => landingProjectSlugs(s).some((slug) => (projectAliases[slug] ?? slug) === project.slug));
const otherStudies = projects.filter((p) => p.caseStudy && p.slug !== project.slug);
const schemaNodes = study
  ? caseStudyArticleNode({
      url: pageUrl,
      headline: project.title,
      description: project.description,
      images: galleryAbs,
      location: project.location,
      dates: project.dates,
      mentions: study.frontmatter.wallcoverings,
      published: study.frontmatter.published,
      updated: study.frontmatter.updated,
    })
  : projectNode({
      url: pageUrl,
      name: project.title,
      description: project.description,
      location: project.location,
      dates: project.dates,
      image: ogImage ? new URL(ogImage, SITE_URL).href : undefined,
    });
/* The hero's sizes, shared by the <picture> and its preload so both pick the same file. */
const heroSizes = project.modest ? `(min-width: ${modestHeroWidth + 40}px) ${modestHeroWidth}px, 100vw` : '(min-width: 768px) 72rem, 100vw';
const heroPreload = project.imageId && !redirectTo && StudyContent ? { ...pictureSources(project.imageId, project.modest)[0], sizes: heroSizes } : undefined;
---

{redirectUrl ? (
  <html lang="en-GB">
    <head>
      <meta charset="utf-8" />
      <title>Moved: {project.title}</title>
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={redirectUrl} />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
    </head>
    <body><a href={redirectTo}>{project.title}</a></body>
  </html>
) : (
<Base
  preloadImage={heroPreload}
  preloadFonts
  title={project.metaTitle}
  description={project.description}
  path={projectHref(project.slug)}
  image={ogImage}
  imageAlt={project.imageId ? media(project.imageId).alt : undefined}
  imageCredit={project.imageId ? project.credits?.[project.imageId] : undefined}
  updated={study?.frontmatter.updated}
  ogType="article"
  extraSchema={[
    schemaNodes,
    breadcrumbNode(crumbs),
    ...films.map((film) => videoNode(film, pageUrl)),
  ]}
>
  <Fragment slot="head">
    {import.meta.env.MW_CONTENT_PREVIEW !== '1' && <link rel="alternate" type="application/json" href={new URL(`/ai/projects/${project.slug}.json`, SITE_URL).href} title="Complete project record as JSON" />}
  </Fragment>
  <div class="container-page project-page">
    <header class="page-head project-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{project.location}</p>
      <h1>{project.title}</h1>
      <p class="lede mt-5">{project.summary}</p>
    </header>
    {project.awaitingPhotos && (
      <figure class="photo-awaiting">
        <div class="photo-awaiting-frame">
          <p>Interior photographs to follow</p>
        </div>
        <figcaption class="caption">This panel stands in for the interior photographs, which will follow once they are cleared. It is not a photograph of the hotel or of the finished rooms.</figcaption>
      </figure>
    )}
    {StudyContent ? (
      <div class="pb-12">
        {project.imageId && (
          <figure class:list={['project-lead-image m-0 mb-10', project.modest && 'modest-hero']} style={project.modest ? `max-width:${modestHeroWidth}px` : undefined}>
            <Picture id={project.imageId} loading="eager" fetchpriority="high" thumbOnly={project.modest} sizes={heroSizes} />
            {project.credits?.[project.imageId] && <figcaption class="caption">{project.credits[project.imageId]}</figcaption>}
          </figure>
        )}
        <div class="project-story-layout">
          {study && <CaseStudyGlance study={{ slug: project.slug, client: study.frontmatter.client, role: study.frontmatter.role, years: study.frontmatter.years, wallcoverings: study.frontmatter.wallcoverings ?? [] }} />}
          <article class="prose case-study">
            <StudyContent />
          </article>
        </div>
        {project.gallery.length > 1 && (
          <section class="project-gallery-section mt-14" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading" class="m-0 text-[clamp(2rem,3vw,2.7rem)]">Photographs</h2>
            <div class:list={['project-gallery mt-6', project.modest && 'modest-gallery']}>
              {project.gallery.filter((id) => id !== project.imageId).map((id) => (
                <figure class="m-0">
                  <Picture id={id} thumbOnly={project.modest} sizes={project.modest ? '(min-width: 768px) 360px, (min-width: 640px) 50vw, 100vw' : '(min-width: 768px) 36rem, 100vw'} />
                  {project.credits?.[id] && <figcaption class="caption">{project.credits[id]}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}
        <section class="project-method mt-14 border-t border-line pt-10" aria-labelledby="method-heading">
          <p class="eyebrow">{projectMethod.eyebrow}</p>
          <h2 id="method-heading" class="m-0 max-w-xl text-[clamp(2rem,3vw,2.7rem)]">{projectMethod.title}</h2>
          <p class="lede mt-4 max-w-2xl">{projectMethod.text}</p>
          <ol class="method-list mt-8 grid md:grid-cols-2" style="list-style:none;padding:0;margin-left:0;column-gap:2.5rem;row-gap:1.5rem">
            {projectMethod.items.map((item, index) => (
              <li style="padding-top:0.25rem">
                <p class="eyebrow method-marker m-0"><Icon name={projectMethodIcons[index]} />{String(index + 1).padStart(2, '0')}</p>
                <h3 style="margin:0.25rem 0 0.5rem;font-size:1.25rem;line-height:1.4">{item.title}</h3>
                <p class="m-0">{item.text}</p>
              </li>
            ))}
          </ol>
          {isExterior && <p class="mt-8 mb-0"><a href="/services/exterior-works/">Discuss exterior decorating, repairs and scaffolded access</a></p>}
          <p class="mt-8 mb-0">{isExterior && 'For our wallcovering work: '}<a href="/details/">See the finish up close: seams, internal corners, edges and joins from our own installations</a></p>
        </section>
        {films.length > 0 && (
          <section class="mt-14">
            <h2 class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On site</h2>
            <div class="mt-6 grid gap-6 md:grid-cols-3" data-films>
              {films.map((film) => (
                <figure class="m-0">
                  <div class="video-frame">
                    <video controls playsinline preload="none" data-poster={film.poster} width={film.width} height={film.height} aria-label={film.alt}>
                      <source src={film.src} type="video/mp4" />
                    </video>
                  </div>
                  <figcaption class="caption">{film.caption}</figcaption>
                </figure>
              ))}
            </div>
            <script is:inline>
              // Film posters load only when the films come near the viewport (or are touched), as on the homepage, so they never compete with the lead image.
              (() => {
                if (window.__filmPosters) return;
                window.__filmPosters = true;
                document.querySelectorAll('[data-films]').forEach((grid) => {
                  const load = () => grid.querySelectorAll('video[data-poster]').forEach((video) => { video.poster = video.dataset.poster; video.removeAttribute('data-poster'); });
                  grid.addEventListener('pointerdown', load, { once: true });
                  grid.addEventListener('focusin', load, { once: true });
                  if (!('IntersectionObserver' in window)) return load();
                  const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { load(); io.disconnect(); } }, { rootMargin: '300px 0px' });
                  io.observe(grid);
                });
              })();
            </script>
          </section>
        )}
        <nav class="project-related mt-14 grid gap-10 border-t border-line pt-10 md:grid-cols-3" aria-label="Related pages">
          <div>
            <p class="eyebrow">More case studies</p>
            <ul class="m-0 grid list-none gap-1 p-0">
              {otherStudies.map((p) => <li><a href={projectHref(p.slug)}>{p.title}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Services</p>
            <ul class="m-0 grid list-none gap-1 p-0">
              {(relatedServices.length ? relatedServices : specialisms.slice(0, 4)).map((s) => <li><a href={specialismHref(s.slug)}>{s.name}</a></li>)}
              <li><a href="/aftercare/">Aftercare</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow">Where we work</p>
            <ul class="m-0 grid list-none gap-1 p-0">
              {(relatedAreas.length ? relatedAreas : areas.slice(0, 3)).map((a) => <li><a href={areaHref(a.slug)}>{a.heading}</a></li>)}
            </ul>
            <p class="mt-6"><Action variant="primary" href="/contact/">Request a quotation</Action></p>
          </div>
        </nav>
      </div>
    ) : (
    <>
    <div class="project-record-layout pb-12">
      <dl class="meta-list">
        <div>
          <dt>Role</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt>Client</dt>
          <dd>{project.client}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{project.location}</dd>
        </div>
        {
          project.dates && (
            <div>
              <dt>Dates</dt>
              <dd>{project.dates}</dd>
            </div>
          )
        }
      </dl>
      <div class="prose project-record-copy">
        {project.paragraphs.map((paragraph) => <p class="m-0">{paragraph}</p>)}
      </div>
    </div>

    {
      project.imagePolicy === 'modest' && project.imageId && (
        <figure class="modest-figure pb-16">
          <Picture id={project.imageId} thumbOnly sizes="16rem" />
          {project.caption && <figcaption class="caption">{project.caption}</figcaption>}
        </figure>
      )
    }

    {
      project.imagePolicy === 'own' && (
        <div class="pb-16">
          {project.caption && <p class="caption mb-6">{project.caption}</p>}
          <div class="grid gap-4 sm:grid-cols-2">
            {project.gallery.map((id) => {
              const image = media(id);
              const wide = image.width > image.height;
              return (
                <figure class:list={['m-0', wide && 'sm:col-span-2']}>
                  <Picture
                    id={id}
                    sizes={wide ? '(min-width: 768px) 72rem, 100vw' : '(min-width: 768px) 36rem, 100vw'}
                  />
                </figure>
              );
            })}
          </div>
          {films.length > 0 && (
            <div class="mt-14">
              <h2 class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On site</h2>
              <div class="mt-6 grid gap-6 md:grid-cols-3" data-films>
                {films.map((film) => (
                  <figure class="m-0">
                    <div class="video-frame">
                      <video
                        controls
                        playsinline
                        preload="none"
                        data-poster={film.poster}
                        width={film.width}
                        height={film.height}
                        aria-label={film.alt}
                      >
                        <source src={film.src} type="video/mp4" />
                      </video>
                    </div>
                    <figcaption class="caption">{film.caption}</figcaption>
                  </figure>
                ))}
              </div>
              <script is:inline>
                // Film posters load only when the films come near the viewport (or are touched), as on the homepage, so they never compete with the lead image.
                (() => {
                  if (window.__filmPosters) return;
                  window.__filmPosters = true;
                  document.querySelectorAll('[data-films]').forEach((grid) => {
                    const load = () => grid.querySelectorAll('video[data-poster]').forEach((video) => { video.poster = video.dataset.poster; video.removeAttribute('data-poster'); });
                    grid.addEventListener('pointerdown', load, { once: true });
                    grid.addEventListener('focusin', load, { once: true });
                    if (!('IntersectionObserver' in window)) return load();
                    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { load(); io.disconnect(); } }, { rootMargin: '300px 0px' });
                    io.observe(grid);
                  });
                })();
              </script>
            </div>
          )}
        </div>
      )
    }
    </>
    )}
  </div>
</Base>
)}

<style>
  .project-head { max-width: 65rem; }
  .project-head .lede { max-width: var(--layout-reading); }
  .project-lead-image { margin-bottom: clamp(2rem, 5vw, 4rem); }
  .project-lead-image :global(.media-frame) { overflow: hidden; border-radius: var(--radius-control); }
  .project-lead-image .caption { max-width: 56rem; margin-top: 1rem; }
  .project-story-layout { display: grid; gap: 2rem; align-items: start; }
  .project-story-layout .case-study { min-width: 0; max-width: none; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  .case-study > :global(:first-child) { margin-top: 0; }
  .case-study > :global(h2) { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); scroll-margin-top: 8rem; }
  .case-study > :global(h2:first-child) { padding-top: 0; border-top: 0; }
  .case-study > :global(p), .case-study > :global(ul), .case-study > :global(ol) { max-width: 44rem; }
  .case-study > :global(ul) { list-style: disc; }
  .case-study > :global(ol) { list-style: decimal; }
  .case-study :global(li) { line-height: 1.75; }
  .case-study :global(li + li) { margin-top: .7rem; }
  .case-study :global(th), .case-study :global(td) { padding: .85rem 1rem; border: 1px solid var(--color-line); text-align: left; vertical-align: top; }
  .case-study :global(th) { background: var(--color-ivory-deep); font-weight: 500; }
  .project-gallery-section { padding-top: 2.5rem; border-top: 1px solid var(--color-line); }
  .project-gallery { columns: 1; column-gap: 1.5rem; }
  .project-gallery > figure { margin: 0 0 1.5rem; break-inside: avoid; }
  .project-gallery :global(.media-frame) { overflow: hidden; border-radius: var(--radius-control); }
  .project-gallery .caption { padding: .25rem .15rem 0; }
  .project-method .method-list { margin-bottom: 0; }
  .project-method .method-list > li { padding: 1.5rem 0 0 !important; border-top: 1px solid var(--color-line); }
  .project-related > div { min-width: 0; padding: 1.5rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  .project-related .eyebrow { margin-top: 0; }
  .project-related li > a { display: inline-flex; align-items: center; min-height: 44px; line-height: 1.5; }
  .project-record-layout { display: grid; gap: 2rem; align-items: start; }
  .project-record-layout .meta-list { min-width: 0; padding: 1.5rem; background: var(--color-ivory-deep); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  .project-record-copy { min-width: 0; max-width: 46rem; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  @media (min-width: 640px) {
    .project-gallery { columns: 2; }
  }
  @media (min-width: 1024px) {
    .project-story-layout, .project-record-layout { grid-template-columns: minmax(15rem, 1fr) minmax(0, 2.5fr); gap: clamp(2rem, 4vw, 4rem); }
    .project-gallery.modest-gallery { columns: 3; }
  }
  @media print {
    .project-story-layout, .project-record-layout { display: block; }
    .project-story-layout .case-study, .project-record-copy { max-width: none; padding: 0; border: 0; }
    .project-gallery { columns: 2; }
  }
</style>
