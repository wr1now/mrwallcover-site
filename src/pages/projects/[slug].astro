---
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picture from '../../components/Picture.astro';
import Base from '../../layouts/Base.astro';
import { areaHref, areas, caseStudyBySlug, media, ogImageFor, projectAliases, projectHref, projects, specialismHref, specialisms, videoById } from '../../lib/content';
import { SITE_URL } from '../../config';
import { breadcrumbNode, caseStudyArticleNode, projectNode, videoNode } from '../../lib/schema';
import type { Project } from '../../lib/types';

export function getStaticPaths() {
  return [
    ...projects.map((project) => ({
      params: { slug: project.slug },
      props: { project, redirectTo: null },
    })),
    // Earlier URLs now served by a case study.
    ...Object.entries(projectAliases).map(([oldSlug, newSlug]) => ({
      params: { slug: oldSlug },
      props: { project: projects.find((p) => p.slug === newSlug)!, redirectTo: projectHref(newSlug) },
    })),
  ];
}

interface Props {
  project: Project;
  redirectTo: string | null;
}

const { project, redirectTo } = Astro.props;
const study = project.caseStudy ? caseStudyBySlug(project.slug) : undefined;
/* Modest (preview-only) heroes are shown at their own pixel width, never stretched past it. */
const modestHeroWidth = project.modest && project.imageId ? media(project.imageId).thumbWidth : 360;
const StudyContent = study?.Content;
const redirectUrl = redirectTo ? new URL(redirectTo, SITE_URL).href : null;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Work', href: '/projects/' },
  { name: project.title, href: projectHref(project.slug) },
];
const films = project.videos.map((id) => videoById(id));
const ogImage = project.imagePolicy === 'none' ? undefined : ogImageFor(project.imageId);
const pageUrl = new URL(projectHref(project.slug), SITE_URL).href;
const galleryAbs = project.gallery.map((id) => ({ url: new URL(media(id).jpg, SITE_URL).href, credit: project.credits?.[id] ?? null }));
const relatedAreas = areas.filter((a) => a.projects.some((slug) => (projectAliases[slug] ?? slug) === project.slug));
const relatedServices = specialisms.filter((s) => s.projects.some((slug) => (projectAliases[slug] ?? slug) === project.slug));
const otherStudies = projects.filter((p) => p.caseStudy && p.slug !== project.slug);
const schemaNodes = study
  ? caseStudyArticleNode({
      url: pageUrl,
      headline: project.title,
      description: project.description,
      images: galleryAbs,
      location: project.location,
      dates: project.dates,
      mentions: study.frontmatter.wallcoverings,
      published: study.frontmatter.published,
      updated: study.frontmatter.updated,
    })
  : projectNode({
      url: pageUrl,
      name: project.title,
      description: project.description,
      location: project.location,
      dates: project.dates,
      image: ogImage ? new URL(ogImage, SITE_URL).href : undefined,
    });
---

{redirectUrl ? (
  <html lang="en-GB">
    <head>
      <meta charset="utf-8" />
      <title>Moved: {project.title}</title>
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={redirectUrl} />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
    </head>
    <body><a href={redirectTo}>{project.title}</a></body>
  </html>
) : (
<Base
  title={project.metaTitle}
  description={project.description}
  path={projectHref(project.slug)}
  image={ogImage}
  imageAlt={project.imageId ? media(project.imageId).alt : undefined}
  imageCredit={project.imageId ? project.credits?.[project.imageId] : undefined}
  updated={study?.frontmatter.updated}
  ogType="article"
  extraSchema={[
    schemaNodes,
    breadcrumbNode(crumbs),
    ...films.map((film) => videoNode(film, pageUrl)),
  ]}
>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{project.location}</p>
      <h1>{project.title}</h1>
      <p class="lede mt-5">{project.summary}</p>
    </header>
    {project.awaitingPhotos && (
      <figure class="photo-awaiting">
        <div class="photo-awaiting-frame">
          <p>Interior photographs to follow</p>
        </div>
        <figcaption class="caption">This panel stands in for the interior photographs, which will follow once they are cleared. It is not a photograph of the hotel or of the finished rooms.</figcaption>
      </figure>
    )}
    {StudyContent ? (
      <div class="pb-12">
        {project.imageId && (
          <figure class:list={['m-0 mb-10', project.modest && 'modest-hero']} style={project.modest ? `max-width:${modestHeroWidth}px` : undefined}>
            <Picture id={project.imageId} loading="eager" fetchpriority="high" thumbOnly={project.modest} sizes={project.modest ? `(min-width: ${modestHeroWidth + 40}px) ${modestHeroWidth}px, 100vw` : '(min-width: 768px) 72rem, 100vw'} />
            {project.credits?.[project.imageId] && <figcaption class="caption">{project.credits[project.imageId]}</figcaption>}
          </figure>
        )}
        <article class="prose case-study">
          <StudyContent />
        </article>
        {project.gallery.length > 1 && (
          <section class="mt-14" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading" class="m-0 text-[clamp(2rem,3vw,2.7rem)]">Photographs</h2>
            <div class:list={['mt-6 grid gap-4', project.modest ? 'modest-gallery sm:grid-cols-2 md:grid-cols-3' : 'sm:grid-cols-2']}>
              {project.gallery.filter((id) => id !== project.imageId).map((id) => (
                <figure class="m-0">
                  <Picture id={id} thumbOnly={project.modest} sizes={project.modest ? '(min-width: 768px) 360px, (min-width: 640px) 50vw, 100vw' : '(min-width: 768px) 36rem, 100vw'} />
                  {project.credits?.[id] && <figcaption class="caption">{project.credits[id]}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}
        {films.length > 0 && (
          <section class="mt-14">
            <h2 class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On site</h2>
            <div class="mt-6 grid gap-6 md:grid-cols-3">
              {films.map((film) => (
                <figure class="m-0">
                  <div class="video-frame">
                    <video controls playsinline preload="none" poster={film.poster} width={film.width} height={film.height} aria-label={film.alt}>
                      <source src={film.src} type="video/mp4" />
                    </video>
                  </div>
                  <figcaption class="caption">{film.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
        <nav class="mt-14 grid gap-10 border-t border-line pt-10 md:grid-cols-3" aria-label="Related pages">
          <div>
            <p class="eyebrow">More case studies</p>
            <ul class="m-0 grid list-none gap-1 p-0">
              {otherStudies.map((p) => <li><a href={projectHref(p.slug)}>{p.title}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Services</p>
            <ul class="m-0 grid list-none gap-1 p-0">
              {(relatedServices.length ? relatedServices : specialisms.slice(0, 4)).map((s) => <li><a href={specialismHref(s.slug)}>{s.name}</a></li>)}
              <li><a href="/aftercare/">Aftercare</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow">Where we work</p>
            <ul class="m-0 grid list-none gap-1 p-0">
              {(relatedAreas.length ? relatedAreas : areas.slice(0, 3)).map((a) => <li><a href={areaHref(a.slug)}>{a.heading}</a></li>)}
            </ul>
            <p class="mt-6"><a class="btn btn-solid-ink" href="/contact/">Request a quotation</a></p>
          </div>
        </nav>
      </div>
    ) : (
    <>
    <div class="grid gap-10 pb-12 md:grid-cols-12">
      <dl class="meta-list md:col-span-4">
        <div>
          <dt>Role</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt>Client</dt>
          <dd>{project.client}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{project.location}</dd>
        </div>
        {
          project.dates && (
            <div>
              <dt>Dates</dt>
              <dd>{project.dates}</dd>
            </div>
          )
        }
      </dl>
      <div class="prose md:col-span-7 md:col-start-6">
        {project.paragraphs.map((paragraph) => <p class="m-0">{paragraph}</p>)}
      </div>
    </div>

    {
      project.imagePolicy === 'modest' && project.imageId && (
        <figure class="modest-figure pb-16">
          <Picture id={project.imageId} thumbOnly sizes="16rem" />
          {project.caption && <figcaption class="caption">{project.caption}</figcaption>}
        </figure>
      )
    }

    {
      project.imagePolicy === 'own' && (
        <div class="pb-16">
          {project.caption && <p class="caption mb-6">{project.caption}</p>}
          <div class="grid gap-4 sm:grid-cols-2">
            {project.gallery.map((id) => {
              const image = media(id);
              const wide = image.width > image.height;
              return (
                <figure class:list={['m-0', wide && 'sm:col-span-2']}>
                  <Picture
                    id={id}
                    sizes={wide ? '(min-width: 768px) 72rem, 100vw' : '(min-width: 768px) 36rem, 100vw'}
                  />
                </figure>
              );
            })}
          </div>
          {films.length > 0 && (
            <div class="mt-14">
              <h2 class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On site</h2>
              <div class="mt-6 grid gap-6 md:grid-cols-3">
                {films.map((film) => (
                  <figure class="m-0">
                    <div class="video-frame">
                      <video
                        controls
                        playsinline
                        preload="none"
                        poster={film.poster}
                        width={film.width}
                        height={film.height}
                        aria-label={film.alt}
                      >
                        <source src={film.src} type="video/mp4" />
                      </video>
                    </div>
                    <figcaption class="caption">{film.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>
      )
    }
    </>
    )}
  </div>
</Base>
)}
