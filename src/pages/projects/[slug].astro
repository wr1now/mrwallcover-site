---
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picture from '../../components/Picture.astro';
import Base from '../../layouts/Base.astro';
import { media, projectHref, projects, videoById } from '../../lib/content';
import { breadcrumbNode } from '../../lib/schema';
import type { Project } from '../../lib/types';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Work', href: '/projects/' },
  { name: project.title, href: projectHref(project.slug) },
];
const films = project.videos.map((id) => videoById(id));
---

<Base
  title={project.metaTitle}
  description={project.description}
  path={projectHref(project.slug)}
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{project.location}</p>
      <h1>{project.title}</h1>
      <p class="lede mt-5">{project.summary}</p>
    </header>
    <div class="grid gap-10 pb-12 md:grid-cols-12">
      <dl class="meta-list md:col-span-4">
        <div>
          <dt>Role</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt>Client</dt>
          <dd>{project.client}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{project.location}</dd>
        </div>
        {
          project.dates && (
            <div>
              <dt>Dates</dt>
              <dd>{project.dates}</dd>
            </div>
          )
        }
      </dl>
      <div class="prose md:col-span-7 md:col-start-6">
        {project.paragraphs.map((paragraph) => <p class="m-0">{paragraph}</p>)}
      </div>
    </div>

    {
      project.imagePolicy === 'modest' && project.imageId && (
        <figure class="modest-figure pb-16">
          <Picture id={project.imageId} thumbOnly sizes="16rem" />
          {project.caption && <figcaption class="caption">{project.caption}</figcaption>}
        </figure>
      )
    }

    {
      project.imagePolicy === 'own' && (
        <div class="pb-16">
          {project.caption && <p class="caption mb-6">{project.caption}</p>}
          <div class="grid gap-4 sm:grid-cols-2">
            {project.gallery.map((id) => {
              const image = media(id);
              const wide = image.width > image.height;
              return (
                <figure class:list={['m-0', wide && 'sm:col-span-2']}>
                  <Picture
                    id={id}
                    sizes={wide ? '(min-width: 768px) 72rem, 100vw' : '(min-width: 768px) 36rem, 100vw'}
                  />
                </figure>
              );
            })}
          </div>
          {films.length > 0 && (
            <div class="mt-14">
              <h2 class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On site</h2>
              <div class="mt-6 grid gap-6 md:grid-cols-3">
                {films.map((film) => (
                  <figure class="m-0">
                    <div class="video-frame">
                      <video
                        controls
                        playsinline
                        preload="none"
                        poster={film.poster}
                        width={film.width}
                        height={film.height}
                        aria-label={film.alt}
                      >
                        <source src={film.src} type="video/mp4" />
                      </video>
                    </div>
                    <figcaption class="caption">{film.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>
      )
    }
  </div>
</Base>
