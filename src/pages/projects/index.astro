---
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picture from '../../components/Picture.astro';
import Base from '../../layouts/Base.astro';
import { projectHref, projects } from '../../lib/content';
import { breadcrumbNode } from '../../lib/schema';
import indexCopy from '../../content/projects.json';

const groups = [
  { id: 'hotels-homes', title: 'Hotels, homes and landmarks', intro: '', items: projects.filter((p) => !p.group) },
  {
    id: 'design-weeks',
    title: 'Design weeks & fashion',
    intro: 'Delivered in partnership with Calico Wallpaper: London Design Festival, London Fashion Week and fashion retail.',
    items: projects.filter((p) => p.group === 'design-weeks'),
  },
].filter((g) => g.items.length > 0);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Work', href: '/projects/' },
];
---

<Base
  title={indexCopy.index.title}
  description={indexCopy.index.description}
  path="/projects/"
  extraSchema={[breadcrumbNode(crumbs)]}
>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{indexCopy.index.eyebrow}</p>
      <h1>{indexCopy.index.heading}</h1>
      <p class="lede mt-5">{indexCopy.index.lede}</p>
    </header>
    {
      groups.map((group) => (
        <section id={group.id} class="scroll-mt-24 pb-16" aria-labelledby={`${group.id}-heading`}>
          <h2 id={`${group.id}-heading`} class="m-0 mb-8 border-t border-line pt-6 text-[clamp(1.9rem,3.5vw,2.8rem)]">{group.title}</h2>
          {group.intro && <p class="lede -mt-4 mb-8">{group.intro}</p>}
          <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2">
            {group.items.map((project) => (
              <a class="project-card" href={projectHref(project.slug)}>
                {project.imagePolicy === 'none' ? (
                  <div class="flex min-h-40 items-end border border-line bg-paper p-4">
                    <p class="m-0 font-serif text-3xl">{project.client}</p>
                  </div>
                ) : (
                  project.imageId && (
                    <Picture id={project.imageId} thumbOnly sizes="(min-width: 640px) 22rem, 100vw" />
                  )
                )}
                <h3>{project.title}</h3>
                <p class="m-0 text-stone">
                  {project.role}
                  {project.dates ? ` · ${project.dates}` : ''}
                </p>
                <p class="mt-2 mb-0">{project.summary}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
