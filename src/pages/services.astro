---
import Breadcrumb from '../components/Breadcrumb.astro';
import Picture from '../components/Picture.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import TechnicalDiagram, { type DiagramKind } from '../components/TechnicalDiagram.astro';
import DesignStudy from '../components/DesignStudy.astro';
import Base from '../layouts/Base.astro';
import { areaHref, areas, editorialPages, services, specialismHref, specialisms } from '../lib/content';
import { breadcrumbNode, serviceNodes, singleServiceNode } from '../lib/schema';
import { SITE_URL } from '../config';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
];
// Published editorial pages that live under /services/ (e.g. heritage and listed buildings).
const serviceEditorials = editorialPages.map((mod) => mod.frontmatter).filter((fm) => fm.path.startsWith('/services/'));
const stageVisuals: Record<string, { icon: IconName; diagram: DiagramKind; caption: string; image?: string; imageCaption?: string }> = {
  surveying: { icon: 'ruler', diagram: 'survey', caption: 'Record the wall, openings and a true vertical before setting out the paper.' },
  management: { icon: 'calendar', diagram: 'programme', caption: 'Illustrative sequence only. Delivery, overlaps and working dates are agreed for each project.' },
  supply: { icon: 'roll', diagram: 'supply', caption: 'Product, batch and delivered quantity are checked against the agreed schedule.' },
  installation: { icon: 'layers', diagram: 'setout', caption: 'The focal point and the end panels guide the layout before any length is cut.', image: 'browns-hotel-mayfair-07', imageCaption: 'Adam’s Eden at Brown’s Hotel, Mayfair, during installation. Floors remain protected. Mr Wallcover project photograph.' },
  aftercare: { icon: 'check', diagram: 'inspection', caption: 'Look at seams, edges and junctions once the paper has settled.', image: 'browns-hotel-mayfair-12', imageCaption: 'Wallcovering meeting the cornice and door case at Brown’s Hotel, Mayfair. Mr Wallcover project photograph.' },
};
---

<Base
  title={services.title}
  description={services.description}
  path="/services/"
  extraSchema={[
    ...serviceNodes(services.pillars),
    ...specialisms.map((s) =>
      singleServiceNode({ name: s.name, description: s.description, url: new URL(specialismHref(s.slug), SITE_URL).href, serviceType: s.serviceType ?? s.name }),
    ),
    breadcrumbNode(crumbs),
  ]}
>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{services.eyebrow}</p>
      <h1>{services.heading}</h1>
      <p class="lede mt-5">{services.lede}</p>
      <nav class="service-stage-nav" aria-label="The five service stages">
        {services.pillars.map((pillar) => <a href={`#${pillar.id}`}><Icon name={stageVisuals[pillar.id].icon} /><span>{pillar.title}</span></a>)}
      </nav>
    </header>
  </div>

  {
    services.pillars.map((pillar, index) => (
      <section id={pillar.id} class:list={['service-stage', index % 2 === 1 && 'bg-paper']}>
        <div class="container-page grid gap-8 py-14 lg:grid-cols-12 md:py-20">
          <div class="lg:col-span-5">
            <p class="eyebrow">0{index + 1}</p>
            <h2 class="m-0 text-[clamp(2rem,4vw,3rem)]">{pillar.title}</h2>
            {pillar.id === 'supply'
              ? <DesignStudy kind="roll" caption={`Illustrative wallpaper roll. ${stageVisuals[pillar.id].caption}`} />
              : <TechnicalDiagram kind={stageVisuals[pillar.id].diagram} caption={stageVisuals[pillar.id].caption} class="service-stage-diagram" />}
          </div>
          <div class="prose lg:col-span-6 lg:col-start-7">
            {pillar.paragraphs.map((paragraph) => (
              <p class="m-0">{paragraph}</p>
            ))}
            {pillar.id === 'installation' && (
              <p class="m-0">
                Specialist detailing: <a href="/projects/imperfect-arches-external-corner-trim/">how we finish an imperfect arch with a bespoke external-corner trim</a>
              </p>
            )}
            {pillar.id === 'aftercare' && (
              <p class="m-0">
                <a href="/aftercare/">The aftercare page</a>
              </p>
            )}
            {stageVisuals[pillar.id].image && <figure class="service-stage-photo">
              <Picture id={stageVisuals[pillar.id].image!} sizes="(min-width: 768px) 42rem, calc(100vw - 2.5rem)" />
              <figcaption class="caption">{stageVisuals[pillar.id].imageCaption}</figcaption>
            </figure>}
          </div>
        </div>
      </section>
    ))
  }

  <section id={services.materials.id} class="border-t border-line">
    <div class="container-page py-16 md:py-24">
      <div class="grid items-end gap-8 md:grid-cols-12">
        <div class="md:col-span-6">
          <p class="eyebrow">{services.materials.eyebrow}</p>
          <h2 class="m-0 text-[clamp(2.2rem,4vw,3.4rem)]">{services.materials.title}</h2>
          <p class="lede mt-4">{services.materials.intro}</p>
        </div>
        <div class="md:col-span-5 md:col-start-8">
          <Picture id="browns-hotel-mayfair-06" sizes="(min-width: 768px) 24rem, 100vw" />
          <p class="caption">Adam’s Eden by Adam Calkin for Lewis &amp; Wood, photographed with its printed selvedge at Brown’s Hotel, Mayfair. Mr Wallcover project photograph.</p>
        </div>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {
          services.materials.items.map((item) => {
            const page = specialisms.find((s) => s.materialKey === item.title);
            return (
              <article class="border-t border-line pt-4">
                <h3 class="m-0 text-[1.8rem]">{page ? <a href={specialismHref(page.slug)}>{item.title}</a> : item.title}</h3>
                <p class="mt-3 mb-0 text-stone">{item.text}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
  <section class="border-t border-line" aria-labelledby="films-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Panel finishes and films</p>
      <h2 id="films-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">Wallcoverings on joinery, bespoke panels and specialist films.</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          ['joinery-wallcoverings-and-panels', 'architectural-film-wrapping', 'window-film']
            .map((slug) => specialisms.find((s) => s.slug === slug)!)
            .map((s) => (
              <article class="border-t border-line pt-4">
                <h3 class="m-0 text-[1.8rem]"><a href={specialismHref(s.slug)}>{s.name}</a></h3>
                <p class="mt-3 mb-0 text-stone">{s.lede}</p>
              </article>
            ))
        }
      </div>
    </div>
  </section>
  <section class="border-t border-line" aria-labelledby="exterior-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Exteriors</p>
      <h2 id="exterior-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">Exterior works.</h2>
      <div class="mt-8 max-w-3xl border-t border-line pt-4">
        <h3 class="m-0 text-[1.8rem]"><a href={specialismHref('exterior-works')}>Exterior works</a></h3>
        <p class="mt-3 mb-0 text-stone">{specialisms.find((s) => s.slug === 'exterior-works')?.lede}</p>
      </div>
    </div>
  </section>
  {
    serviceEditorials.length > 0 && (
      <section class="border-t border-line" aria-labelledby="heritage-heading">
        <div class="container-page py-14 md:py-20">
          <p class="eyebrow">Heritage</p>
          <h2 id="heritage-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">Listed and heritage buildings.</h2>
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {serviceEditorials.map((fm) => (
              <article class="border-t border-line pt-4">
                <h3 class="m-0 text-[1.8rem]"><a href={fm.path}>{fm.title}</a></h3>
                <p class="mt-3 mb-0 text-stone">{fm.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
  <section class="border-t border-line" aria-labelledby="areas-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Where we work</p>
      <h2 id="areas-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">London and the surrounding areas. UK-wide for selected projects.</h2>
      <ul class="link-row mt-6 grid list-none gap-2 p-0 sm:grid-cols-2 md:grid-cols-3">
        {areas.map((area) => (
          <li><a href={areaHref(area.slug)}>{area.heading}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .service-stage-nav { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
  .service-stage-nav a { display: inline-flex; align-items: center; gap: .55rem; min-height: 44px; padding: .65rem .9rem; border: 1px solid var(--color-line); border-radius: var(--radius-control); text-decoration: none; color: var(--color-ink); background: var(--color-paper); }
  .service-stage-nav a:hover { border-color: var(--color-brass); }
  .service-stage { scroll-margin-top: 7rem; }
  .service-stage :global(.service-stage-diagram) { max-width: 34rem; margin-top: 1.75rem; }
  .service-stage-photo { margin: 2rem 0 0; }
  .service-stage-photo :global(.media-img) { width: 100%; max-height: 29rem; object-fit: cover; }
  .service-stage-photo figcaption { margin-top: .8rem; }
  @media (min-width: 768px) and (max-width: 1023px) { .service-stage-nav { gap: .5rem; } }
</style>
