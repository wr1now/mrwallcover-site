---
import Breadcrumb from '../components/Breadcrumb.astro';
import Picture from '../components/Picture.astro';
import Base from '../layouts/Base.astro';
import { areaHref, areas, services, specialismHref, specialisms } from '../lib/content';
import { breadcrumbNode, serviceNodes, singleServiceNode } from '../lib/schema';
import { SITE_URL } from '../config';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
];
---

<Base
  title={services.title}
  description={services.description}
  path="/services/"
  extraSchema={[
    ...serviceNodes(services.pillars),
    ...specialisms.map((s) =>
      singleServiceNode({ name: s.name, description: s.description, url: new URL(specialismHref(s.slug), SITE_URL).href, serviceType: s.serviceType ?? s.name }),
    ),
    breadcrumbNode(crumbs),
  ]}
>
  <div class="container-page">
    <header class="page-head">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">{services.eyebrow}</p>
      <h1>{services.heading}</h1>
      <p class="lede mt-5">{services.lede}</p>
    </header>
  </div>

  {
    services.pillars.map((pillar, index) => (
      <section id={pillar.id} class:list={[index % 2 === 1 && 'bg-paper']}>
        <div class="container-page grid gap-8 py-14 md:grid-cols-12 md:py-20">
          <div class="md:col-span-4">
            <p class="eyebrow">0{index + 1}</p>
            <h2 class="m-0 text-[clamp(2rem,4vw,3rem)]">{pillar.title}</h2>
          </div>
          <div class="prose md:col-span-7 md:col-start-6">
            {pillar.paragraphs.map((paragraph) => (
              <p class="m-0">{paragraph}</p>
            ))}
            {pillar.id === 'installation' && (
              <p class="m-0">
                Specialist detailing: <a href="/projects/imperfect-arches-external-corner-trim/">how we finish an imperfect arch with a bespoke external-corner trim</a>
              </p>
            )}
            {pillar.id === 'aftercare' && (
              <p class="m-0">
                <a href="/aftercare/">The aftercare page</a>
              </p>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <section id={services.materials.id} class="border-t border-line">
    <div class="container-page py-16 md:py-24">
      <div class="grid items-end gap-8 md:grid-cols-12">
        <div class="md:col-span-6">
          <p class="eyebrow">{services.materials.eyebrow}</p>
          <h2 class="m-0 text-[clamp(2.2rem,4vw,3.4rem)]">{services.materials.title}</h2>
          <p class="lede mt-4">{services.materials.intro}</p>
        </div>
        <div class="md:col-span-5 md:col-start-8">
          <Picture id="browns-hotel-mayfair-03" sizes="(min-width: 768px) 24rem, 100vw" />
          <p class="caption">Where two lengths meet. Brown's Hotel, Mayfair.</p>
        </div>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {
          services.materials.items.map((item) => {
            const page = specialisms.find((s) => s.materialKey === item.title);
            return (
              <article class="border-t border-line pt-4">
                <h3 class="m-0 text-[1.8rem]">{page ? <a href={specialismHref(page.slug)}>{item.title}</a> : item.title}</h3>
                <p class="mt-3 mb-0 text-stone">{item.text}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
  <section class="border-t border-line" aria-labelledby="films-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Joinery, panels and films</p>
      <h2 id="films-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">Joinery, bespoke panels, architectural and window film.</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          ['joinery-wallcoverings-and-panels', 'architectural-film-wrapping', 'window-film']
            .map((slug) => specialisms.find((s) => s.slug === slug)!)
            .map((s) => (
              <article class="border-t border-line pt-4">
                <h3 class="m-0 text-[1.8rem]"><a href={specialismHref(s.slug)}>{s.name}</a></h3>
                <p class="mt-3 mb-0 text-stone">{s.lede}</p>
              </article>
            ))
        }
      </div>
    </div>
  </section>
  <section class="border-t border-line" aria-labelledby="exterior-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Exteriors</p>
      <h2 id="exterior-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">Exterior works.</h2>
      <div class="mt-8 max-w-3xl border-t border-line pt-4">
        <h3 class="m-0 text-[1.8rem]"><a href={specialismHref('exterior-works')}>Exterior works</a></h3>
        <p class="mt-3 mb-0 text-stone">{specialisms.find((s) => s.slug === 'exterior-works')?.lede}</p>
      </div>
    </div>
  </section>
  <section class="border-t border-line" aria-labelledby="areas-heading">
    <div class="container-page py-14 md:py-20">
      <p class="eyebrow">Where we work</p>
      <h2 id="areas-heading" class="m-0 text-[clamp(2rem,4vw,3rem)]">London and the surrounding areas. UK-wide for selected projects.</h2>
      <ul class="link-row mt-6 grid list-none gap-2 p-0 sm:grid-cols-2 md:grid-cols-3">
        {areas.map((area) => (
          <li><a href={areaHref(area.slug)}>{area.heading}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
