---
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
import RoomStudio from '../room-studio/RoomStudioApp.tsx';
import studioPage from '../room-studio/page.json';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbNode } from '../lib/schema';
import { roomStudioExamples } from '../room-studio/example-metadata';
const cloudEnabled = import.meta.env.PUBLIC_ROOM_STUDIO_CLOUD_ENABLED === 'true';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Wallpaper my room', href: '/room-studio/' }];
const appSchema = { '@type': 'WebApplication', name: 'Mr Wallcover Room Studio', url: 'https://www.mrwallcover.com/room-studio/', applicationCategory: 'DesignApplication', browserRequirements: 'JavaScript and WebGL for the interactive editor', isAccessibleForFree: true, description: 'Free room-photo previews and measured 3D editing for wallpaper, paint and Bauwerk limewash. Optional finished rendering is available only when configured.' };
---
<Base title="Wallpaper my room — photo & 3D visualiser | Mr Wallcover" description="Upload a room photo or build a measured 3D room. Try wallpaper, paint and Bauwerk limewash, compare finishes and download your preview." path="/room-studio/" image="/media/room-studio/examples/willow-chimney-1.webp" imageAlt="Original illustrative room with Willow lattice wallpaper and a measured chimney breast" imageCredit="Original Room Studio illustration" extraSchema={[breadcrumbNode(crumbs), appSchema]} updated={studioPage.updated}>
  <div class="studio-page container-page pb-20">
    <header class="studio-page-head">
      <div><Breadcrumb items={crumbs} /><p class="eyebrow">Mr Wallcover / Room Studio</p><h1>Wallpaper<br /><em>my room.</em></h1></div>
      <div><p class="lede">See your chosen finish in your own room. Upload a photograph for a quick preview, or build a measured 3D room to explore wallpaper, paint and Bauwerk limewash.</p><p class="studio-page-note">Free photo and 3D previews · No sign-up to start · Private on your device</p><Action href="#room-editor" data-studio-mode="photo" variant="primary">View in your room</Action> <Action href="#room-editor" data-studio-mode="room" variant="secondary">Build a 3D room</Action> <Action href="#example-rooms" variant="quiet">Explore three examples</Action></div>
    </header>
    <section id="example-rooms" class="studio-showcase" aria-labelledby="example-rooms-heading">
      <div class="studio-showcase-heading"><div><p class="eyebrow">Measured rooms. Visible pattern.</p><h2 id="example-rooms-heading">Three spaces.<br /><em>Three different finishes.</em></h2></div><p>Explore a chimney breast, an L-shaped room and an angled bay. These original illustrative designs show how the repeat sits around openings and corners. Open any example to change it yourself.</p></div>
      <div class="studio-showcase-grid">{roomStudioExamples.map((example, index) => <article class="studio-example-card">
        <a href="#room-editor" data-room-example={example.id} aria-label={`Explore ${example.name} in the 3D editor`}><img src={`/media/room-studio/examples/${example.id}-preview.webp`} width="960" height="540" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" alt={`${example.name}: rendered illustrative ${example.layoutLabel.toLowerCase()}`} /></a>
        <div class="studio-example-copy"><p class="eyebrow">{String(index + 1).padStart(2,'0')} / Original illustrative design</p><h3>{example.name}</h3><p>{example.layoutLabel}<br />{example.dimensionsLabel}</p><p class="studio-example-repeat">Repeat {example.repeatMm.width} × {example.repeatMm.height} mm · {example.id === 'ochre-lshape' ? 'half-drop match' : example.id === 'indigo-bay' ? 'half-drop already in tile' : 'straight match'}</p><Action href="#room-editor" data-room-example={example.id} variant="secondary">Explore this room</Action><a class="studio-full-view" href={example.renders.stills[0]}>View full-resolution render</a></div>
      </article>)}</div>
      <p class="studio-example-caption">Blender Cycles renders from the same measured room and wallpaper coordinates as the editor. Two 1920 × 1080 views and a 4096 × 2048 panorama per example. These are illustrative empty-room studies, not completed commissions or manufacturer wallpapers.</p>
    </section>
    <div id="room-editor"><RoomStudio client:only="react"><div slot="fallback" class="studio-page-loading"><p>Your photo and measured-room workspace is loading.</p><noscript><p>Room Studio needs JavaScript for photo editing, measured editing and 3D. You can still <a href="/contact/">send us your room measurements and selected finishes</a>.</p></noscript></div></RoomStudio></div>
    <section class="studio-explanation"><div><p class="eyebrow">A space you can edit</p><h2>From measured walls<br />to considered finishes.</h2></div><div><p>For a photo preview, mark each wall’s four corners and protect windows, furniture and trim with the erase brush. Add the wall width and height for calibrated placement, or adjust an illustrative scale. Compare your choices and download a free PNG. A photograph does not supply unseen walls or a 360° view.</p><p>For a measured room, start with measurements or trace one room on a floor plan. Set the ceiling height, add doors and windows, then try finishes wall by wall. Your wallpaper keeps its real pattern size as you adjust the room.</p><p>Upload a complete repeating tile or a measured strip repeat. Check the tiled proof before applying it. Larger walls reveal more pattern; they do not enlarge the motif. Use a sharp source image: the studio preserves your artwork rather than inventing missing detail.</p><p>The preview is illustrative. Colour and limewash movement are approximate. Test a sample in your room before ordering. {cloudEnabled ? 'Cloud saving requires a verified email. Availability of automatic plan reading and finished renders is shown in the studio.' : 'The three example render packages are available here. Automatic plan reading, cloud saving and finished rendering of your own room are unavailable until the private services are configured. Finished 3D rendering will be a standalone paid package; pricing remains unset while costs are measured.'}</p><Action href="/contact/?intent=install" variant="quiet">Talk to us about installation</Action></div></section>
    <section class="studio-package" aria-labelledby="studio-package-heading"><div><p class="eyebrow">Optional finished rendering</p><h2 id="studio-package-heading">A considered view.<br /><em>A room to keep.</em></h2><p>Keep experimenting with free previews. When finished rendering is available, purchase one package for your confirmed measured-room design. There is no subscription.</p></div><div><ul><li>Two 1920 × 1080 room views</li><li>One 4096 × 2048 panorama with a 360° viewer</li><li>Your editable room and finish specification</li></ul><p>Review the room, wallpaper scale and cameras before checkout. The purchased version stays fixed while you keep editing. Source-image detail and illustrative material limitations are shown before confirmation.</p><p class="studio-page-note">Live checkout is unavailable while price and processing allowances are unset. Automatic plan reading remains disabled.</p></div></section>
  </div>
</Base>
<style>
  .studio-page{max-width:1500px}.studio-page-head{padding:64px 0 22px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.studio-page-head h1{font-size:clamp(64px,6vw,100px);line-height:.95;letter-spacing:-.035em;margin:18px 0}.studio-page-head h1 em{font-weight:400;color:#6d7755}.studio-page-head .lede{max-width:42ch;font-size:21px;line-height:1.55}.studio-page-note{font-size:15px;color:#58644e;margin:22px 0}.studio-explanation{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid #c8cdbf;padding:48px 0 10px}.studio-explanation h2{font-size:48px;line-height:1.05;margin:15px 0}.studio-explanation p{max-width:60ch}.studio-page-loading{min-height:400px;display:grid;place-content:center;border:1px solid #d6d8ca;background:#f8f5ed;padding:24px}#room-editor{scroll-margin-top:100px}@media(max-width:760px){.studio-page-head{padding-top:36px;grid-template-columns:1fr;gap:12px}.studio-page-head h1{font-size:66px}.studio-page-head .lede{font-size:18px}.studio-explanation{grid-template-columns:1fr;gap:18px;padding-top:30px}.studio-explanation h2{font-size:38px}.studio-page-note{font-size:15px}}
.studio-package{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid #c8cdbf;padding:48px 0 10px}.studio-package p,.studio-package li{font-size:18px;line-height:1.6}.studio-package h2{margin:14px 0 22px}.studio-package ul{padding-left:22px}.studio-package li{margin:10px 0}@media(max-width:760px){.studio-package{grid-template-columns:1fr;gap:18px;padding-top:30px}}
</style>
<style>
  .studio-showcase{padding:24px 0 38px;scroll-margin-top:100px}.studio-showcase-heading{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;margin-bottom:26px}.studio-showcase-heading h2{margin:10px 0 0}.studio-showcase-heading h2 em{font-weight:400;color:#6d7755}.studio-showcase-heading>p{max-width:56ch;margin:0}.studio-showcase-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.studio-example-card{background:#fffdf7;border:1px solid #d6d8ca;overflow:hidden;border-radius:10px}.studio-example-card>a{display:block}.studio-example-card img{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}.studio-example-copy{padding:22px}.studio-example-copy .eyebrow{font-size:15px;letter-spacing:.09em}.studio-example-copy h3{margin:8px 0 12px}.studio-example-copy p{font-size:18px;line-height:1.5}.studio-example-repeat{color:#59624f}.studio-full-view{display:block;min-height:44px;font-size:15px;padding-top:12px;text-underline-offset:3px}.studio-example-caption{font-size:15px;line-height:1.55;color:#59624f;max-width:100ch;margin:20px 0 0}@media(max-width:900px){.studio-showcase-grid{grid-template-columns:1fr}.studio-example-card{display:grid;grid-template-columns:1fr 1fr}.studio-example-card>a{height:100%}.studio-example-card img{height:100%;object-fit:cover}.studio-showcase-heading{gap:25px}}@media(max-width:600px){.studio-showcase-heading{grid-template-columns:1fr;gap:14px}.studio-example-card{display:block}.studio-example-card>a{height:auto}.studio-example-card img{height:auto}.studio-example-copy{padding:18px}.studio-showcase{padding-top:15px}}
</style>
