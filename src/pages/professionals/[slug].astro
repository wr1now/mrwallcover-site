---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import professionals from '../../content/professionals.json';
import { guides, guideHref } from '../../lib/guides';
import { breadcrumbNode } from '../../lib/schema';
export function getStaticPaths() { return professionals.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const path = `/professionals/${item.slug}/`;
const related = guides.find((guide) => guide.frontmatter.slug === item.guide);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'For professionals', href: '/professionals/' }, { name: item.name, href: path }];
---
<Base title={`${item.name} | Mr Wallcover`} description={item.description} path={path} extraSchema={[breadcrumbNode(crumbs)]}>
  <div class="container-page pb-20">
    <header class="page-head guide-head"><Breadcrumb items={crumbs} /><p class="eyebrow">{item.name}</p><h1>{item.heading}</h1><p class="lede mt-5">{item.intro}</p><a class="btn btn-solid-ink mt-4" href={`/contact/?audience=${item.audience}&intent=install`}>{item.cta}</a></header>
    <div class="grid gap-10 md:grid-cols-12">
      <div class="prose guide-prose md:col-span-7">{item.sections.map((section) => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}</div>
      <aside class="professional-intake md:col-span-4 md:col-start-9"><p class="eyebrow">A useful starting point</p><h2>What to send</h2><ul>{item.checklist.map((line) => <li>{line}</li>)}</ul><a class="btn btn-line mt-5" href={`/downloads/${item.download}`} download>{item.downloadLabel}</a><p class="text-sm text-stone">CSV · opens in Excel or Numbers. Leave unknown items blank. This is a planning schedule, not an ordering calculation.</p>{related && <p class="mt-6"><a href={guideHref(related.frontmatter.slug)}>{related.frontmatter.shortTitle}: read the guide</a></p>}</aside>
    </div>
    <section class="guide-related"><h2>Other ways we can help</h2><div class="flex flex-wrap gap-3">{professionals.filter((other) => other.slug !== item.slug).map((other) => <a class="btn btn-line" href={`/professionals/${other.slug}/`}>{other.name}</a>)}<a class="btn btn-line" href="/projects/">Explore our work</a></div></section>
  </div>
</Base>
