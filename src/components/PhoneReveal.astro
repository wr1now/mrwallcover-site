---
/**
 * Click-to-reveal phone number. Rendered only when SITE_PHONE was set at build
 * time. The number is not in the repository; Base.astro decodes it on click.
 */
import { phoneAvailable } from '../lib/phone';

interface Props {
  label?: string;
  prefix?: string;
  class?: string;
}
const { label = 'Show phone number', prefix = '', class: cls = 'reveal-phone' } = Astro.props;
---

{phoneAvailable && (
  <button type="button" class={cls} data-phone-reveal data-prefix={prefix || undefined}>{label}</button>
)}
