---
/**
 * Click-to-reveal phone number. The number is not in the HTML; the script in
 * Base.astro decodes it on click and swaps this button for a tel: link.
 */
interface Props {
  label?: string;
  prefix?: string;
  class?: string;
}
const { label = 'Show phone number', prefix = '', class: cls = 'reveal-phone' } = Astro.props;
---

<button type="button" class={cls} data-phone-reveal data-prefix={prefix || undefined}>{label}</button>
