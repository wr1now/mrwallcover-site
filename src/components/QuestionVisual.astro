---
/** A topic-specific drawing beside a question; the question itself carries the meaning. */
import Icon from './Icon.astro';
import { questionIcon } from '../lib/question-visual';
import DesignObject from './DesignObject.astro';
import { objectKindForQuestion } from '../lib/design-object-presentation';
import { dimensionalStudyHelps, questionVisualForPath, type QuestionVisualVariant } from '../lib/question-visual-policy';
interface Props { question: string; id?: string; variant?: QuestionVisualVariant }
const icon = questionIcon(Astro.props.question, Astro.props.id);
const requested=(Astro.props.variant ?? questionVisualForPath(Astro.url.pathname));
const kind=objectKindForQuestion(Astro.props.question, Astro.props.id);
const typographic=requested==='dimensional'&&!dimensionalStudyHelps(kind);
const dimensional=requested==='dimensional'&&!typographic;
---
<span class:list={['question-visual', {'question-visual--dimensional':dimensional, 'question-visual--typographic':typographic}]} data-question-visual={icon} aria-hidden="true">{!typographic&&(dimensional?<DesignObject kind={kind} />:<Icon name={icon} />)}</span>

<style is:global>
  .question-visual.question-visual--typographic { display:none; }
  .guide-faq[data-visual="dimensional"] .guide-faq-item:has(.question-visual--typographic) { padding-right:0; min-height:0; }
  .guide-faq[data-visual="dimensional"] .guide-faq-item:has(.question-visual--typographic) .question-heading-row { display:block; }
  .faq[data-visual="dimensional"] details:has(.question-visual--typographic) > summary { min-height:4.5rem; }
</style>
