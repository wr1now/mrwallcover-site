---
/**
 * Mobile action dock (stage 5, step G6). Four actions at most: "Start your
 * project" first, then Projects, WhatsApp (when SITE_PHONE is set), and Book a call.
 * The phone reveal belongs on the contact pages. "Book a call" (a 20-minute appointment)
 * is a fourth cell only when BOOKING_URL is set in src/config.ts. Opaque champagne (no
 * blur), so on a phone the header is the only blurred surface. Hidden while
 * the mobile menu is open and while a text field has focus (an on-screen
 * keyboard is likely up) or an opted-in editing workspace has focus. Body
 * padding (--dock-clearance) keeps it off the footer's last line.
 */
import Glass from './Glass.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import BookCallLink from './BookCallLink.astro';
---

<Glass element="nav" variant="champagne" opaque class="dock" aria-label="Contact shortcuts" data-dock>
  <a class="dock-primary" href="/contact/">
    <span>Start</span><span class="sr-only"> your project</span>
  </a>
  <a href="/projects/">
    <span>Projects</span>
  </a>
  <WhatsAppLink>WhatsApp</WhatsAppLink>
  <BookCallLink class="dock-book" />
</Glass>

<script>
  // While a text field has focus an on-screen keyboard is likely up, and the dock would sit on top of it.
  const isTextField = (el: EventTarget | null) =>
    (el instanceof HTMLInputElement && !['button', 'submit', 'reset', 'checkbox', 'radio', 'range', 'file', 'color'].includes(el.type)) ||
    el instanceof HTMLTextAreaElement ||
    el instanceof HTMLSelectElement ||
    (el instanceof HTMLElement && el.isContentEditable);
  // Interactive workspaces also need clear buttons and canvas controls when
  // keyboard navigation scrolls them into view at narrow/zoomed layouts.
  const needsDockClearance = (el: EventTarget | null) => isTextField(el) ||
    (el instanceof Element && Boolean(el.closest('[data-dock-clearance]')));
  document.addEventListener('focusin', (event) => {
    document.body.classList.toggle('field-focus', needsDockClearance(event.target));
  });
  // Focusout precedes focusin; keep clearance between fields/workspace controls.
  document.addEventListener('focusout', (event) => {
    if (needsDockClearance(event.relatedTarget)) return;
    requestAnimationFrame(() => {
      if (!needsDockClearance(document.activeElement)) document.body.classList.remove('field-focus');
    });
  });
</script>
