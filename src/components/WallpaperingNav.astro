---
/** Shared links keep calculator, preparation and the technical reference on separate pages. */
interface Props {
  current: 'hub' | 'studio' | 'calculator' | 'guide' | 'preparation' | 'lining' | 'fire';
}
import '../styles/wallpapering.css';
const { current } = Astro.props;
const parts = [
  { id: 'hub', href: '/wallpapering/', label: 'Wallpapering' },
  { id: 'calculator', href: '/calculator/', label: 'Calculator' },
  { id: 'studio', href: '/room-studio/', label: 'Room Studio' },
  { id: 'preparation', href: '/wallpapering/preparation/', label: 'Preparation' },
  { id: 'lining', href: '/wallpapering/lining-and-adhesives/', label: 'Lining & adhesives' },
  { id: 'fire', href: '/advice/wallcovering-fire-ratings-uk/', label: 'Fire ratings & standards' },
  { id: 'guide', href: '/advice/quantities/', label: 'Quantity guide' },
  { id: 'guides', href: '/wallpapering/#hanging-guides', label: 'Hanging guides' },
];
---

<nav aria-label="Wallpapering">
  <ul class="wp-subnav">
    {parts.map((part) => <li><a href={part.href} aria-current={part.id === current ? 'page' : undefined}>{part.label}</a></li>)}
  </ul>
</nav>

<script>
  // On a phone the tabs scroll sideways: bring the current one into view without moving the page.
  for (const list of document.querySelectorAll<HTMLElement>('.wp-subnav')) {
    const current = list.querySelector<HTMLElement>('[aria-current="page"]');
    if (current && current.offsetLeft + current.offsetWidth > list.offsetLeft + list.clientWidth - 40) list.scrollLeft = Math.max(0, current.offsetLeft - list.offsetLeft - 20);
  }
</script>
