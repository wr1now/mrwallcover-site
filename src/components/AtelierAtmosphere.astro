---
import '../styles/atelier-atmosphere.css';
import { questionVisualForPath } from '../lib/question-visual-policy';

interface Props { path: string; quiet?: boolean; }
const { path, quiet = false } = Astro.props;
const active = !quiet && questionVisualForPath(path) === 'dimensional';
---

{/* Original paper forms, confined to the outer gutters and always behind the page. */}
<div class:list={['atelier-atmosphere', !active && 'atelier-atmosphere--quiet']} data-atelier-atmosphere data-atelier-motion={active ? 'active' : 'static'} aria-hidden="true" inert>
  <div class="atelier-atmosphere__edge atelier-atmosphere__edge--right">
    <div class="atelier-atmosphere__fan">
      <span class="atelier-atmosphere__sheet atelier-atmosphere__sheet--back"></span>
      <span class="atelier-atmosphere__sheet atelier-atmosphere__sheet--middle"></span>
      <span class="atelier-atmosphere__sheet atelier-atmosphere__sheet--front"></span>
    </div>
  </div>
  <div class="atelier-atmosphere__edge atelier-atmosphere__edge--left">
    <div class="atelier-atmosphere__curl"><span></span></div>
  </div>
</div>

<script>
  import { mountAtelierAtmosphere } from '../scripts/atelier-atmosphere';
  mountAtelierAtmosphere();
</script>
