---
/** An original schematic about evidence scope, never an approved assembly or a product rating. */
const layers = [
  { title: 'Substrate', text: 'The wall or board, including its class, thickness and density where specified.' },
  { title: 'Fixing & preparation', text: 'The adhesive and any primer, lining, joints or air gap covered by the evidence.' },
  { title: 'Exact wallcovering', text: 'The product reference, backing, weight, finish and printed variant.' },
];
---
<figure class="fire-evidence" aria-labelledby="fire-evidence-caption">
  <p class="eyebrow">Read the documents as one build-up</p>
  <ol>{layers.map((layer, i) => <li><span class="layer-number" aria-hidden="true">0{i + 1}</span><strong>{layer.title}</strong><p>{layer.text}</p></li>)}</ol>
  <figcaption id="fire-evidence-caption">Schematic only. A product classification covers the documented build-up and its permitted variations. These are things to check, not a recommended construction; do not assume an unmentioned layer is included.</figcaption>
</figure>
<style>
  .fire-evidence { margin:2rem 0; padding:clamp(1.25rem,3vw,2rem); border:1px solid var(--color-line); border-radius:var(--radius-control); background:var(--color-paper); }
  .fire-evidence ol { display:grid; gap:1rem; list-style:none; padding:0; margin:1.25rem 0; }
  .fire-evidence li { min-width:0; border-top:3px solid var(--color-brass); padding-top:1rem; }
  .layer-number { display:block; font-size:var(--text-meta); color:var(--color-stone); margin-bottom:.5rem; }
  .fire-evidence strong { display:block; font-family:var(--font-serif); font-size:1.6rem; font-weight:500; line-height:1.2; }
  .fire-evidence li p { font-size:var(--text-body); line-height:1.65; margin:.75rem 0 0; }
  .fire-evidence figcaption { font-size:var(--text-meta); line-height:1.65; max-width:65ch; color:var(--color-stone); }
  @media(min-width:48rem) { .fire-evidence ol { grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; } }
</style>
