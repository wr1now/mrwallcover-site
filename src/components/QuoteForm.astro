---
import { FORM_ENDPOINT, FORM_PROVIDER, PUBLIC_EMAIL, SITE_URL } from '../config';
import { contact } from '../lib/content';

/**
 * Spam protection, in layers:
 * 1. Honeypot field (_honey) that people never see; FormSubmit drops filled ones and so does our script.
 * 2. Time-trap: the script refuses a submit within 4 seconds of the page loading.
 * 3. The real endpoint is not in the action attribute; the script sets it on a genuine submit,
 *    so bots that read raw HTML post nowhere.
 * 4. FormSubmit's own captcha step (_captcha left on).
 */
const isFormSubmit = FORM_PROVIDER === 'formsubmit' && FORM_ENDPOINT.length > 0;
const postsNatively =
  isFormSubmit || FORM_PROVIDER === 'netlify' || (FORM_PROVIDER === 'formspree' && FORM_ENDPOINT.length > 0);
const action = FORM_PROVIDER === 'formspree' ? FORM_ENDPOINT : FORM_PROVIDER === 'netlify' ? '/thank-you/' : undefined;
const encodedEndpoint = isFormSubmit ? btoa(FORM_ENDPOINT.split('').reverse().join('')) : undefined;
const honeyName = isFormSubmit ? '_honey' : 'bot-field';
---

<form
  class="grid gap-5"
  name="quote-request"
  method="POST"
  action={action}
  enctype={postsNatively ? 'multipart/form-data' : undefined}
  data-quote-form
  data-provider={FORM_PROVIDER}
  data-email={PUBLIC_EMAIL}
  data-endpoint={encodedEndpoint}
  data-honey={honeyName}
  data-netlify={FORM_PROVIDER === 'netlify' ? 'true' : undefined}
  data-netlify-honeypot={FORM_PROVIDER === 'netlify' ? 'bot-field' : undefined}
>
  {FORM_PROVIDER === 'netlify' && <input type="hidden" name="form-name" value="quote-request" />}
  {
    isFormSubmit && (
      <>
        <input type="hidden" name="_subject" value="New enquiry from mrwallcover.com" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={`${SITE_URL}/thank-you/`} />
        <input type="hidden" name="_captcha" value="true" />
      </>
    )
  }
  <p class="honeypot" aria-hidden="true">
    <label>
      Leave this field empty
      <input name={honeyName} type="text" tabindex="-1" autocomplete="off" />
    </label>
  </p>
  <div class="grid gap-5 md:grid-cols-2">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="phone">Phone</label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="project-type">Project type</label>
      <select id="project-type" name="project-type" required>
        <option value="">Choose one</option>
        <option>Hotel</option>
        <option>Prime residential</option>
        <option>Retail</option>
        <option>Film: architectural, furniture or window</option>
        <option>Aftercare of existing work</option>
        <option>Other</option>
      </select>
    </div>
    <div class="field">
      <label for="location">Location</label>
      <input id="location" name="location" type="text" autocomplete="address-level2" />
    </div>
    <div class="field">
      <label for="start-date">Preferred start</label>
      <input id="start-date" name="start-date" type="text" placeholder="A month is enough" />
    </div>
  </div>
  <div class="field">
    <label for="message">Message</label>
    <textarea id="message" name="message" required></textarea>
  </div>
  <p class="m-0 text-stone">{contact.photoNote}</p>
  {
    postsNatively && (
      <div class="field">
        <label for="photos">Photographs, if you have them</label>
        <input id="photos" name="attachment" type="file" accept="image/*" multiple />
      </div>
    )
  }
  {isFormSubmit && <p class="form-note m-0 text-stone">{contact.spamNote}</p>}
  <div>
    <button class="btn btn-solid-ink" type="submit">{contact.submit}</button>
  </div>
  <p id="form-status" class="m-0" role="status" hidden></p>
  <noscript><p class="m-0">This form needs JavaScript. Please email {PUBLIC_EMAIL} instead.</p></noscript>
</form>

<script is:inline>
  (function () {
    const form = document.querySelector('[data-quote-form]');
    if (!form) return;
    const loadedAt = Date.now();
    const status = document.getElementById('form-status');
    const say = (text) => {
      if (!status) return;
      status.hidden = false;
      status.textContent = text;
    };
    form.addEventListener('submit', (event) => {
      const provider = form.getAttribute('data-provider');
      const honey = form.querySelector('[name="' + form.getAttribute('data-honey') + '"]');
      if (honey && honey.value.trim()) {
        event.preventDefault();
        return;
      }
      if (Date.now() - loadedAt < 4000) {
        event.preventDefault();
        say('Thank you. Please check the details and press send again.');
        return;
      }
      if (provider === 'formsubmit') {
        const enc = form.getAttribute('data-endpoint');
        if (enc) {
          const files = form.querySelector('input[type="file"]');
          let total = 0;
          if (files && files.files) for (const f of files.files) total += f.size;
          if (total > 5 * 1024 * 1024) {
            event.preventDefault();
            say('The photographs are over 5 MB in total. Please send fewer, or email them to ' + form.getAttribute('data-email') + '.');
            return;
          }
          form.action = atob(enc).split('').reverse().join('');
        }
        return;
      }
      if (provider === 'netlify' || provider === 'formspree') return;
      event.preventDefault();
      const data = new FormData(form);
      const lines = [];
      for (const [key, value] of data.entries()) {
        if (key === 'bot-field' || key === 'form-name') continue;
        if (typeof value !== 'string' || !value.trim()) continue;
        lines.push(key + ': ' + value.trim());
      }
      const email = form.getAttribute('data-email');
      window.location.href =
        'mailto:' + email + '?subject=' + encodeURIComponent('Quotation request') + '&body=' + encodeURIComponent(lines.join('\n'));
      say('Your email application should open with this enquiry. If it does not, write to ' + email + '.');
    });
  })();
</script>
