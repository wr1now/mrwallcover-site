---
/**
 * The fuller project record on /projects/: smaller jobs and earlier stages that do not have a
 * case study, each with up to three of our own photographs (or none) and one line of text.
 * Data: src/content/project-record.json. Private homes are named by area only.
 */
import Picture from './Picture.astro';
import record from '../content/project-record.json';

interface Item { id: string; group: string; name: string; place: string; years: string; text: string; images: string[] }
const items = record.items as Item[];
const groups = record.groups
  .map((group) => ({ ...group, withPhotos: items.filter((item) => item.group === group.id && item.images.length), named: items.filter((item) => item.group === group.id && !item.images.length) }))
  .filter((group) => group.withPhotos.length || group.named.length);
const jobCount = groups.reduce((sum, group) => sum + group.withPhotos.length + group.named.length, 0);
---

<section id="project-record" class="project-record" aria-labelledby="project-record-heading">
  <div class="project-record-head">
    <p class="eyebrow">{record.eyebrow}</p>
    <h2 id="project-record-heading">{record.title}</h2>
    <p class="lede">{record.intro}</p>
  </div>
  {/* Closed by default: lazy photographs inside a closed <details> are not fetched, so a phone
      scrolling past no longer downloads the whole record. Every entry stays in the server HTML. */}
  <details class="project-record-disclosure" data-project-record>
    <summary>
      <span class="project-record-summary">
        <span class="project-record-summary-title">The fuller project record</span>
        <span class="project-record-summary-count">{jobCount} more jobs: hotels, restaurants, shops, workplaces and homes</span>
      </span>
      <span class="project-record-disclosure-icon" aria-hidden="true"></span>
    </summary>
    <div class="project-record-body">
      <nav class="project-record-nav" aria-label="Project record sections">
        <ul>{groups.map((group) => <li><a href={`#record-${group.id}`}>{group.label} <span>{group.withPhotos.length + group.named.length}</span></a></li>)}</ul>
      </nav>
      {groups.map((group) => (
        <section id={`record-${group.id}`} class="record-group" aria-labelledby={`record-${group.id}-heading`}>
          <h3 id={`record-${group.id}-heading`}>{group.label}</h3>
          {group.withPhotos.length > 0 && (
            <ul class="record-grid">
              {group.withPhotos.map((item) => (
                <li id={`record-${item.id}`} class="record-item">
                  <figure>
                    <Picture id={item.images[0]} thumbOnly sizes="(min-width: 1280px) 24rem, (min-width: 768px) 30vw, calc(100vw - 48px)" />
                    {item.images.length > 1 && (
                      <div class="record-thumbs">
                        {item.images.slice(1).map((id) => <Picture id={id} thumbOnly sizes="(min-width: 1280px) 12rem, (min-width: 768px) 15vw, 45vw" />)}
                      </div>
                    )}
                  </figure>
                  <h4>{item.name}</h4>
                  <p class="record-meta">{[item.place, item.years].filter(Boolean).join(' · ')}</p>
                  <p class="record-text">{item.text}</p>
                </li>
              ))}
            </ul>
          )}
          {group.named.length > 0 && (
            <ul class="record-list">
              {group.named.map((item) => (
                <li id={`record-${item.id}`}>
                  <p class="record-list-name">{item.name}</p>
                  <p class="record-meta">{[item.place, item.years].filter(Boolean).join(' · ')}{item.text && <span> · {item.text}</span>}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
      <p class="record-note">{record.note}</p>
    </div>
  </details>
</section>

<script is:inline>
  // Links into the record (the "On this page" row, the hotel list's #record-<id> entries, links from
  // other pages) and printing open the closed disclosure; without JavaScript the summary still works.
  (() => {
    const section = document.getElementById('project-record');
    const record = section && section.querySelector('[data-project-record]');
    if (!record) return;
    const targetOf = (hash) => {
      let id;
      try { id = decodeURIComponent(hash.slice(1)); } catch { return null; }
      const target = id && document.getElementById(id);
      return target && section.contains(target) ? target : null;
    };
    const reveal = () => {
      const target = targetOf(window.location.hash);
      if (!target) return;
      const wasClosed = !record.open;
      record.open = true;
      // The browser jumped while the entry had no box; bring it into view now that it has one.
      if (wasClosed && record.contains(target)) target.scrollIntoView({ block: 'start', behavior: 'instant' });
    };
    // Open before the default jump so it lands, including a repeat click on the same hash (no hashchange).
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[href*="#"]') : null;
      if (!link || link.origin !== window.location.origin || link.pathname !== window.location.pathname) return;
      if (targetOf(link.hash)) record.open = true;
    });
    window.addEventListener('hashchange', reveal);
    reveal();
    let openedForPrint = false;
    window.addEventListener('beforeprint', () => { openedForPrint = !record.open; record.open = true; });
    window.addEventListener('afterprint', () => { if (openedForPrint) record.open = false; openedForPrint = false; });
  })();
</script>

<style>
  .project-record { border-top: 1px solid var(--color-line); padding-block: 3.5rem 2rem; }
  .project-record-head { max-width: var(--layout-reading); }
  .project-record h2 { font-size: var(--text-h2); margin: 0; }
  .project-record .lede { margin: 1rem 0 0; }
  /* The same quiet plus/minus row as the footer groups, at a 64px target. */
  .project-record-disclosure { margin-top: 2rem; border-block: 1px solid var(--color-line); }
  .project-record-disclosure > summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 64px; padding: 1.1rem .4rem; cursor: pointer; list-style: none; }
  .project-record-disclosure > summary::-webkit-details-marker { display: none; }
  .project-record-summary { display: grid; gap: .3rem; min-width: 0; }
  .project-record-summary-title { font-family: var(--font-serif); font-size: var(--text-h3); line-height: 1.15; }
  .project-record-summary-count { font-size: var(--text-meta); line-height: 1.5; color: var(--color-stone); }
  .project-record-disclosure > summary:hover .project-record-summary-title { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .project-record-disclosure-icon { position: relative; display: block; width: 14px; height: 14px; flex-shrink: 0; }
  .project-record-disclosure-icon::before, .project-record-disclosure-icon::after { content: ''; position: absolute; inset: 50% 0 auto; height: 1px; background: currentColor; }
  .project-record-disclosure-icon::after { transform: rotate(90deg); }
  .project-record-disclosure[open] .project-record-disclosure-icon::after { transform: rotate(0); }
  .project-record-disclosure[open] > summary { border-bottom: 1px solid var(--color-line); }
  .project-record-body { padding-bottom: 1rem; }
  .project-record-nav ul { list-style: none; padding: 0; margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .project-record-nav a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; padding: 0 1rem; border: 1px solid var(--color-line); border-radius: var(--button-radius); color: inherit; text-decoration: none; font-size: var(--text-button); background: var(--color-paper); }
  .project-record-nav a:hover { border-color: var(--color-ink); }
  .project-record-nav span { color: var(--color-stone); font-size: var(--text-meta); }
  /* No scroll-margin on groups or entries: the global [id] rule clears the sticky header at every width. */
  .record-group { padding-top: 3rem; }
  .record-group > h3 { font-size: var(--text-h3); margin: 0 0 1.5rem; padding-bottom: .8rem; border-bottom: 1px solid var(--color-line); }
  .record-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.6rem 2rem; }
  .record-item { min-width: 0; }
  .record-item figure { margin: 0; }
  .record-item figure > :global(.media-frame), .record-item figure > :global(.media-frame) :global(picture) { display: block; width: 100%; }
  .record-item figure > :global(.media-frame) :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .record-thumbs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; margin-top: .5rem; }
  .record-thumbs :global(.media-frame), .record-thumbs :global(picture) { display: block; width: 100%; }
  .record-thumbs :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  .record-item h4 { font-family: var(--font-serif); font-size: var(--text-h4); font-weight: 500; line-height: 1.2; margin: 1rem 0 0; }
  .record-meta { margin: .35rem 0 0; font-size: var(--text-meta); color: var(--color-stone); }
  .record-text { margin: .5rem 0 0; font-size: var(--text-body); line-height: 1.6; }
  .record-list { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; }
  .record-list li { border-top: 1px solid var(--color-line); padding-top: .8rem; }
  .record-list-name { margin: 0; font-family: var(--font-serif); font-size: var(--text-h4); line-height: 1.2; }
  .record-note { margin: 3rem 0 0; max-width: var(--layout-reading); font-size: var(--text-body); color: var(--color-stone); }
  @media (max-width: 1023px) { .record-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .record-grid, .record-list { grid-template-columns: minmax(0, 1fr); }
    .record-grid { gap: 2.2rem; }
  }
  /* Paper copies carry the whole record (beforeprint opens it too, so its photographs load). */
  @media print {
    .project-record-disclosure::details-content { content-visibility: visible; block-size: auto; }
    .project-record-disclosure > :not(summary) { display: block; }
    .project-record-disclosure-icon { display: none; }
  }
</style>
