---
interface Props { makers?: {slug:string;name:string}[]; kind: 'makers'|'routes' }
const {makers=[],kind}=Astro.props;
---
<form class="maker-filter" data-directory-filter hidden role="search" onsubmit="return false">
<label>Search {kind === 'makers' ? 'makers' : 'routes'}<input type="search" name="q" data-directory-search placeholder="Maker, material or region" /></label>
{makers.length>0 && <label>Maker<select data-directory-maker><option value="all">All makers</option>{makers.map(m=><option value={m.slug}>{m.name}</option>)}</select></label>}
</form><p class="maker-results" data-directory-count role="status" aria-live="polite"></p>
<script>
const form=document.querySelector<HTMLFormElement>('[data-directory-filter]');
if(form){
 form.hidden=false;
 const search=form.querySelector<HTMLInputElement>('[data-directory-search]')!;
 const maker=form.querySelector<HTMLSelectElement>('[data-directory-maker]');
 const update=()=>{let count=0;const query=search.value.trim().toLocaleLowerCase();document.querySelectorAll<HTMLElement>('[data-directory-item]').forEach(item=>{item.hidden=!(item.dataset.search??'').includes(query)||Boolean(maker&&maker.value!=='all'&&item.dataset.maker!==maker.value);if(!item.hidden)count++;});const status=document.querySelector('[data-directory-count]');if(status)status.textContent=`${count} ${count===1?'result':'results'} shown`;};
 const initial=new URLSearchParams(location.search).get('maker');if(maker&&initial&&Array.from(maker.options).some(o=>o.value===initial))maker.value=initial;
 form.addEventListener('input',update);form.addEventListener('change',update);update();
}
</script>
