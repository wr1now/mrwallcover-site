---
import Action from './Action.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { ENQUIRY_SERVICES, ENQUIRY_SOURCES, EMAIL_MARKETING_TEXT, EMAIL_MARKETING_VERSION, PRIVACY_NOTICE_VERSION } from '../lib/enquiry-context';
import { ENQUIRY_MAILTO, LEAD_API_URL, FORM_ENDPOINT, FORM_PROVIDER, PUBLIC_EMAIL, SITE_URL } from '../config';
import { attachmentLimits } from '../lib/enquiry-attachments';
import { phoneAvailable } from '../lib/phone';

interface Props {
  variant?: 'enquiry' | 'aftercare';
}

const { variant = 'enquiry' } = Astro.props;
const isFormSubmit = !LEAD_API_URL && FORM_PROVIDER === 'formsubmit' && FORM_ENDPOINT.length > 0;
const encodedEndpoint = isFormSubmit ? btoa(FORM_ENDPOINT.split('').reverse().join('')) : '';
const attachmentHelp = attachmentLimits(LEAD_API_URL ? 'lead-api' : FORM_PROVIDER).description;
---

<form
  class="enquiry grid gap-5"
  method="POST"
  enctype="multipart/form-data"
  data-enquiry-form
  data-variant={variant}
  data-provider={LEAD_API_URL ? 'lead-api' : FORM_PROVIDER}
  data-lead-api={LEAD_API_URL}
  data-endpoint={encodedEndpoint}
  data-email={PUBLIC_EMAIL}
  novalidate
>
  <p class="honeypot" aria-hidden="true">
    <label>Leave this field empty <input name="_honey" type="text" tabindex="-1" autocomplete="off" /></label>
  </p>
  <input type="hidden" name="kind" value={variant === 'aftercare' ? 'aftercare' : 'enquiry'} />
  <input type="hidden" name="idempotencyKey" value="" />
  <input type="hidden" name="reference" value="" />
  <input type="hidden" name="shortlist" value="" />
  <input type="hidden" name="topic" value="" />
  <input type="hidden" name="topicOrigin" value="" />
  <input type="hidden" name="privacyNoticeVersion" value={PRIVACY_NOTICE_VERSION} />
  <input type="hidden" name="marketingTextVersion" value={EMAIL_MARKETING_VERSION} />
  <input type="hidden" name="materialPreferences" value="" />
  {isFormSubmit && (
    <>
      <input type="hidden" name="_subject" value={variant === 'aftercare' ? 'Aftercare note from mrwallcover.com' : 'New enquiry from mrwallcover.com'} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value={`${SITE_URL}/thank-you/`} />
      <input type="hidden" name="_captcha" value="true" />
    </>
  )}

  {/* The form sends through its script. Without JavaScript this note shows first, the send button stays disabled and hidden and the fuller-brief control is hidden (visual-system.css), so nobody fills ten fields for nothing. */}
  <p class="enquiry-nojs">This form needs JavaScript to send. If it is switched off, email <a href={ENQUIRY_MAILTO}>{PUBLIC_EMAIL}</a> with the same details and attach any photographs.</p>
  <div data-hide-on-success>
    {variant === 'enquiry' ? <>
      <div class="selection-summary mb-5" data-enquiry-context hidden>
        <p class="eyebrow">About the page you chose</p>
        <p data-enquiry-context-text></p>
        <p class="form-note text-stone">Include this topic with your note, or remove it. You can change the service below.</p>
        <Action variant="secondary" type="button" data-clear-enquiry-context>Remove this topic</Action>
      </div>
      <div class="field mb-5">
        <label for="service">Which service? <span class="text-stone">Optional</span></label>
        <select id="service" name="service"><option value="">Not sure yet</option>{ENQUIRY_SERVICES.map((item) => <option value={item.value}>{item.label}</option>)}</select>
      </div>
    </> : <input type="hidden" name="service" value="aftercare" />}

    <div class="selection-summary" data-selection-summary hidden><p class="eyebrow">Your material choices</p><p data-selection-text></p><Action variant="secondary" type="button" data-clear-selection>Remove these choices</Action></div>
    <div data-error-summary class="form-summary" tabindex="-1" hidden></div>

    {variant === 'enquiry' && (
      <div data-builder-intro>
        <Action variant="secondary" type="button" data-open-builder>Add a fuller brief</Action>
        <p class="form-note m-0 mt-2 text-stone">The short note below is enough. The fuller brief is optional, and you can leave any answer as “not sure”.</p>
      </div>
    )}

    {variant === 'enquiry' && (
      <div data-builder hidden>
        {/* The fuller brief counts only its own parts; the reply fieldset below is always the send step. */}
        <p class="eyebrow" data-step-label>Fuller brief: part 1 of 3</p>
        <div data-step>
          <fieldset class="grid gap-5">
            <legend class="font-serif text-[1.8rem]">Your project</legend>
            <div class="field" id="field-intent">
              <label for="intent">What do you need?</label>
              <select id="intent" name="intent">
                <option value="">Not sure</option>
                <option value="install">I already have the material</option>
                <option value="source">Help me choose, then install it</option>
                <option value="advice">Advice</option>
                <option value="prepare">Removal or preparation</option>
                <option value="repair">Repair</option>
              </select>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              <div class="field">
                <label for="area">Area or postcode district</label>
                <input id="area" name="area" type="text" autocomplete="address-level2" />
              </div>
              <div class="field">
                <label for="rooms">Rooms</label>
                <select id="rooms" name="rooms">
                  <option value="">Not sure</option>
                  <option>One room</option>
                  <option>Several rooms</option>
                  <option>A whole home</option>
                  <option>A hotel floor or more</option>
                </select>
              </div>
            </div>
            <div data-pro hidden class="grid gap-5">
              <div class="field">
                <label for="material-responsibility">Who is supplying the material?</label>
                <input id="material-responsibility" name="materialResponsibility" type="text" placeholder="Not sure is fine" />
              </div>
              <div class="field">
                <label for="programme">Programme or tender date</label>
                <input id="programme" name="programme" type="text" />
              </div>
              <div class="field"><label for="specification-notes">Specification, drawing revisions or open questions</label><textarea id="specification-notes" name="specificationNotes" maxlength="1200" placeholder="Optional. Include design details, approvals or documents the project requires."></textarea></div>
            </div>
          </fieldset>
        </div>
        <div data-step hidden>
          <fieldset class="grid gap-5">
            <legend class="font-serif text-[1.8rem]">Walls and materials</legend>
            <div class="field">
              <label for="product">Product, brand or code, if you know it</label>
              <input id="product" name="product" type="text" />
            </div>
            <div class="field">
              <label for="wall-notes">Walls, heights or condition</label>
              <textarea id="wall-notes" name="wallNotes" placeholder="Optional. Not sure is a complete answer."></textarea>
            </div>
          </fieldset>
        </div>
        <div data-step hidden>
          <fieldset class="grid gap-5">
            <legend class="font-serif text-[1.8rem]">Access and budget</legend>
            <div class="field">
              <label for="access">Access, occupied rooms, or site limits</label>
              <textarea id="access" name="access"></textarea>
            </div>
            <div class="field">
              <label for="budget">Budget</label>
              <select id="budget" name="budget">
                <option value="">Prefer to discuss</option>
                <option>Prefer to discuss</option>
                <option>I have a range and will say so in the note</option>
              </select>
            </div>
          </fieldset>
          <p class="mt-5 mb-0">Check the note below, then send. You can go back and change an answer. Nothing is stored in the page address.</p>
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <Action variant="secondary" icon="arrow-left" type="button" data-step-back>Back</Action>
          <Action variant="secondary" icon="arrow-right" type="button" data-step-next>Continue</Action>
        </div>
      </div>
    )}

    <fieldset class="grid gap-5" data-contact>
      <legend class="font-serif text-[1.8rem]">{variant === 'aftercare' ? 'Tell us what you are seeing' : 'How we should reply'}</legend>
      {variant === 'aftercare' && (
        <>
          <p class="m-0 text-stone">This is for care of work, or for a wallcovering that needs looking at. We look at the photograph first and say whether it is the hang, a knock or the building; the guarantee question follows that.</p>
          <div class="field">
            <label for="project-reference">Reference, if you have one</label>
            <input id="project-reference" name="projectReference" type="text" autocomplete="off" />
          </div>
        </>
      )}
      <p class="form-note m-0 text-stone">A name, how to reply and a short note are all we need. Everything else is optional.</p>
      <div class="field" id="field-name">
        <label for="name">Name <span class="text-stone">Required</span></label>
        <input id="name" name="name" type="text" autocomplete="name" aria-required="true" />
        <p class="form-error" data-error="name"></p>
      </div>
      {/* Same id and name as before, so the professional fields in the fuller brief still follow it. The prompt sits
          here, where the choice is made, so it shows whether or not the fuller brief is open. */}
      {variant === 'enquiry' && (
        <div class="field" id="field-audience">
          <label for="audience">I am a… <span class="text-stone">Optional</span></label>
          <select id="audience" name="audience">
            <option value="">Not sure</option>
            <option value="homeowner">Homeowner</option>
            <option value="designer">Designer or architect</option>
            <option value="developer">Property developer or main contractor</option>
            <option value="hotel">Hotel or property operator</option>
            <option value="commercial">Other commercial project</option>
          </select>
          <p data-professional-help class="form-note mt-2 mb-0 text-stone" aria-live="polite"></p>
        </div>
      )}
      <fieldset id="field-replyBy">
        <legend>Preferred reply <span class="text-stone">Required</span></legend>
        <div class="mt-2 flex flex-wrap gap-4">
          <label class="inline-flex min-h-12 items-center gap-2"><input type="radio" name="replyBy" value="email" required /> Email</label>
          <label class="inline-flex min-h-12 items-center gap-2"><input type="radio" name="replyBy" value="phone" required /> Phone</label>
        </div>
        <p class="form-error" data-error="replyBy"></p>
      </fieldset>
      <div class="field" id="field-email" data-reply="email">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" />
        <p class="form-error" data-error="email"></p>
      </div>
      {/* Both fields show; only the preferred one is required. */}
      <div class="field" id="field-phone" data-reply="phone">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        <p class="form-error" data-error="phone"></p>
      </div>
      <div class="field" id="field-message">
        <label for="message">{variant === 'aftercare' ? 'What should we look at?' : 'Your note'} <span class="text-stone">Required</span></label>
        <textarea id="message" name="message" aria-required="true"></textarea>
        <p class="form-error" data-error="message"></p>
      </div>
      {variant === 'enquiry' && (
        <div class="field">
          <label for="timing">When would you like to start? <span class="text-stone">Optional</span></label>
          <input id="timing" name="timing" type="text" placeholder="A month is enough" />
        </div>
      )}
      <div class="field" id="field-attachment">
        <label for="photos">Photographs or a PDF, if you have them</label>
        <input id="photos" name="attachment" type="file" aria-describedby="attachment-help attachment-error" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif,.pdf,application/pdf" multiple />
        <p id="attachment-help" class="form-note m-0 text-stone">Photographs from your phone and drawings help (JPEG, PNG, WebP, HEIC, HEIF or PDF). {attachmentHelp} Attachments are optional. If a file will not send, email {PUBLIC_EMAIL}.{phoneAvailable && <span data-wa-item> Or send them on <WhatsAppLink>WhatsApp</WhatsAppLink>.</span>}</p>
        <p id="attachment-error" class="form-error" data-error="attachment" aria-live="polite"></p>
        <ul class="file-list" data-file-list></ul>
      </div>
      <div class="field">
        <label for="source-declared">How did you hear about us? <span class="text-stone">Optional</span></label>
        <select id="source-declared" name="sourceDeclared"><option value="">Prefer not to say / not sure</option>{ENQUIRY_SOURCES.map((item) => <option value={item.value}>{item.label}</option>)}</select>
      </div>
      <div data-email-marketing hidden>
        <label class="inline-flex min-h-12 items-start gap-2">
          <input class="mt-1" type="checkbox" name="marketing" value="yes" disabled />
          <span>{EMAIL_MARKETING_TEXT}</span>
        </label>
        <p class="form-note m-0 text-stone">Separate from your enquiry. You can withdraw by <a href={`mailto:${PUBLIC_EMAIL}`}>emailing us</a>.</p>
      </div>
      <p class="form-note m-0 text-stone">
        {LEAD_API_URL
          ? `Your enquiry is saved with a reference before this page confirms it. Dorin Burcus reads it. If you have not heard back, email ${PUBLIC_EMAIL} and quote the reference.`
          : `Your note goes to ${PUBLIC_EMAIL} with a reference, and Dorin Burcus reads it. If you do not hear back, email that address directly.`}
      </p>
      <p class="form-note m-0 text-stone">We use the details you send to respond to this request. <a href="/privacy/">Read the privacy notice</a>.</p>
      {/* Disabled until the script binds: a disabled default button also blocks Enter-key submission without JavaScript. */}
      <Action variant="primary" type="submit" disabled>{variant === 'aftercare' ? 'Send the note' : 'Send your note'}</Action>
    </fieldset>
  </div>
  <p data-status role="status" hidden></p>
  <div data-receipt hidden>
    <h2 class="m-0 font-serif text-[2rem]">Received. Reference <span data-reference></span>.</h2>
    <p data-notification class="lede mt-4"></p>
    <p class="m-0">You can also email {PUBLIC_EMAIL}. If the project needs a survey, we arrange it after we have spoken.</p>
  </div>
</form>

<style is:global>
  /* Global so the form markup carries no scoping attributes (the tests read it as written). Links in the notes are
     underlined, so they do not rely on colour; the WhatsApp offer reads as a word in its sentence, not as the icon button. */
  .enquiry .form-note a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .18em; text-decoration-color: var(--color-underline); }
  .enquiry .form-note .wa-link { display: inline; }
  .enquiry .form-note .wa-glyph { display: none; }
  /* Empty, the prompt takes no space but stays a live region, so a new prompt is announced. */
  .enquiry [data-professional-help]:empty { margin-top: 0; }
</style>

<script is:inline>
  /* As with Base.astro's data-nav-ready check: if the form script has not bound the form by load (blocked or
     stale module), mark it so visual-system.css shows the email notice instead of a silent disabled button. */
  window.addEventListener('load', function () {
    document.querySelectorAll('[data-enquiry-form]:not([data-ready])').forEach(function (form) { form.classList.add('enquiry-unbound'); });
  });
</script>
<script>
  import '../scripts/enquiry-form';
</script>
