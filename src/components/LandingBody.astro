---
import Breadcrumb from './Breadcrumb.astro';
import FaqList from './FaqList.astro';
import Picture from './Picture.astro';
import HotelGroups from './HotelGroups.astro';
import Action from './Action.astro';
import Icon from './Icon.astro';
import ProjectEvidence from './ProjectEvidence.astro';
import FilmWrapDiagram from './FilmWrapDiagram.astro';
import NextSteps from './NextSteps.astro';
import { areaHref, areas, landingProjectSlugs, linkedProjects, media, specialismHref, specialisms } from '../lib/content';
import { imageRights } from '../lib/schema';
import type { LandingPage } from '../lib/content';

interface Props {
  page: LandingPage;
  crumbs: { name: string; href: string }[];
  eyebrow: string;
  kind: 'area' | 'specialism';
}

const { page, crumbs, eyebrow, kind } = Astro.props;
const linked = linkedProjects(landingProjectSlugs(page), `${kind} page "${page.slug}"`);
const otherAreas = areas.filter((a) => a.slug !== page.slug);
const otherSpecialisms = specialisms.filter((s) => s.slug !== page.slug);
const photographCredit = page.imageId ? imageRights(media(page.imageId).jpg).creditText : null;
const materialServices = new Set(['hand-painted-wallpaper-installation', 'grasscloth-installation', 'silk-wallcovering-installation', 'fabric-walling', 'mural-installation', 'acoustic-wallcovering-installation']);
const relatedServices = kind === 'area' ? specialisms : otherSpecialisms;
const serviceGroups = [
  { title: 'Material installation', items: relatedServices.filter((service) => materialServices.has(service.slug)) },
  { title: 'Specialist work', items: relatedServices.filter((service) => !materialServices.has(service.slug)) },
].filter((group) => group.items.length > 0);

/** Split a paragraph into text and [label](href) link segments. Content is our own JSON. */
function segments(text: string) {
  const parts: { text: string; href?: string }[] = [];
  const re = /\[([^\]]+)\]\(([^)\s]+)\)/g;
  let last = 0;
  for (const m of text.matchAll(re)) {
    if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
}
---

<div class="container-page">
  <header class="page-head">
    <Breadcrumb items={crumbs} />
    <p class="eyebrow">{eyebrow}</p>
    <h1>{page.heading}</h1>
    <p class="lede mt-5">{page.lede}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Action href="/contact/">Start your project</Action>
      <Action variant="secondary" href="/projects/">See the work</Action>
    </div>
  </header>
  {page.sections && page.sections.length >= 3 && <nav class="landing-contents" aria-label="On this page">
    <p class="eyebrow">On this page</p>
    <ul>{page.sections.map((section, index) => <li><a href={`#landing-section-${index + 1}`}><Icon name="arrow-right" /><span>{section.heading}</span></a></li>)}</ul>
  </nav>}
  <div class:list={['landing-introduction', (page.imageId || page.visualDiagram) && 'landing-introduction--illustrated']}>
    <div class="prose landing-introduction-copy">
      {page.paragraphs.map((paragraph) => (
        <p>{segments(paragraph).map((seg) => (seg.href ? <a href={seg.href}>{seg.text}</a> : seg.text))}</p>
      ))}
      {
        page.links && page.links.length > 0 && (
          <p>
            Makers:{' '}
            {page.links.map((link, i) => (
              <>
                {i > 0 && ', '}
                <a href={link.href} rel="noopener">{link.label}</a>
              </>
            ))}
          </p>
        )
      }
    </div>
    {
      page.imageId && (
        <figure class="landing-photograph">
          <Picture id={page.imageId} sizes="(min-width: 1024px) 30rem, (min-width: 768px) 42vw, calc(100vw - 2.5rem)" />
          <figcaption class="caption mt-3"><span>{segments(page.imageCaption ?? media(page.imageId).alt).map((seg) => (seg.href ? <a href={seg.href}>{seg.text}</a> : seg.text))}</span>{' '}<span>Photograph: {photographCredit}.</span></figcaption>
        </figure>
      )
    }
    {page.visualDiagram === 'film-wrap' && <div class="landing-process-visual"><FilmWrapDiagram /></div>}
  </div>

  {
    page.sections && page.sections.length > 0 && (
      <div class="landing-sections">
        {page.sections.map((section, index) => (
          <section class="landing-section" id={`landing-section-${index + 1}`}>
            <header>
              <span class="landing-section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h2>{section.heading}</h2>
            </header>
            <div class="prose">
              {section.paragraphs.map((paragraph) => (
                <p>{segments(paragraph).map((seg) => (seg.href ? <a href={seg.href}>{seg.text}</a> : seg.text))}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }

  {
    linked.length > 0 && (
      <section class="border-t border-line py-12" aria-labelledby="record-heading">
        <h2 id="record-heading" class="m-0 text-[clamp(2rem,3vw,2.7rem)]">On the public record</h2>
        <ProjectEvidence projects={linked} />
      </section>
    )
  }
  {page.autoProjects === 'hotels' && <HotelGroups />}
</div>

<style>
  .landing-introduction { display: grid; gap: 2.5rem; padding-bottom: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  .landing-introduction-copy { min-width: 0; }
  .landing-introduction-copy > p:first-child { margin-top: 0; }
  .landing-photograph { margin: 0; min-width: 0; }
  .landing-photograph :global(.media-img) { display: block; width: 100%; height: auto; max-height: 34rem; object-fit: cover; }
  .landing-photograph figcaption { display: grid; gap: .45rem; line-height: 1.6; color: var(--color-stone); }
  .landing-photograph figcaption a { text-decoration: underline; text-underline-offset: .2em; }
  .landing-contents { padding: 1.2rem 1.5rem; border: 1px solid var(--color-line); border-radius: var(--radius-control); background: var(--color-paper); margin-bottom: 2.5rem; }
  .landing-contents > p { margin: 0 0 .6rem; }
  .landing-contents ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .landing-contents a { display: flex; align-items: center; gap: .7rem; min-height: 44px; font-size: var(--text-button); line-height: 1.45; padding-block: .45rem; }
  .landing-contents :global(.mw-icon) { width: 1.15rem; height: 1.15rem; color: var(--color-brass); flex-shrink: 0; }
  .landing-sections { padding-bottom: 1rem; }
  .landing-section { display: grid; gap: 1.5rem; padding-block: clamp(2rem, 4vw, 3.5rem); border-top: 1px solid var(--color-line); scroll-margin-top: 8rem; }
  .landing-section header { min-width: 0; }
  .landing-section-number { display: block; margin-bottom: .75rem; color: var(--color-brass); font-size: var(--text-label); letter-spacing: .12em; }
  .landing-section h2 { max-width: 20ch; margin: 0; font-size: clamp(2rem, 3vw, 2.7rem); }
  .landing-section .prose { min-width: 0; }
  .landing-section .prose > p { margin: 0; }
  .landing-section .prose > p + p { margin-top: 1rem; }
  .landing-related { display: grid; gap: 2.5rem; border-top: 1px solid var(--color-line); padding-block: 3rem; }
  .landing-service-groups { display: grid; gap: 2rem; }
  .landing-service-groups h3 { margin: 0 0 .75rem; font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 500; }
  .landing-related ul { margin: 0; padding: 0; list-style: none; }
  .landing-related li { border-bottom: 1px solid var(--color-line); }
  .landing-related li a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 48px; padding-block: .65rem; line-height: 1.5; text-decoration: none; }
  .landing-related li a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .landing-related li :global(.mw-icon) { flex-shrink: 0; width: 1rem; height: 1rem; color: var(--color-brass); }
  .landing-related-aftercare { margin: 1.5rem 0 0; }
  .landing-next { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 768px) {
    .landing-introduction--illustrated { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); }
    .landing-section { grid-template-columns: minmax(0, .8fr) minmax(0, 1.35fr); gap: clamp(2rem, 5vw, 5rem); }
    .landing-service-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) { .landing-related { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); } }
  @media (max-width: 639px) { .landing-contents ul { grid-template-columns: 1fr; } }
</style>

<FaqList items={page.faq} eyebrow="Questions" heading={kind === 'area' ? `Questions about papering in ${page.name}` : 'Questions we are asked'} />

{/* Area pages end the enquiry path with the same steps as /contact/ (contact.json next); no new text. */}
{kind === 'area' && (
  <div class="container-page landing-next">
    <NextSteps headingId="area-next-heading" />
    <p class="mt-6 mb-0"><Action href="/contact/">Start your project</Action></p>
  </div>
)}

<div class="container-page">
  <nav class="landing-related" aria-label="Related pages">
    <div>
      <p class="eyebrow">{kind === 'area' ? 'What we hang' : 'Materials'}</p>
      <div class="landing-service-groups">
        {serviceGroups.map((group) => <section>
          <h3>{group.title}</h3>
          <ul>{group.items.map((s) => <li><a href={specialismHref(s.slug)}><span>{s.name}</span><Icon name="arrow-right" /></a></li>)}</ul>
        </section>)}
      </div>
      <p class="landing-related-aftercare"><a href="/aftercare/">Aftercare and the twelve-month guarantee</a></p>
    </div>
    <section>
      <p class="eyebrow">Where we work</p>
      <ul>{(kind === 'area' ? otherAreas : areas).map((a) => <li><a href={areaHref(a.slug)}><span>Wallpaper installation in {a.name}</span><Icon name="arrow-right" /></a></li>)}</ul>
    </section>
  </nav>
</div>
