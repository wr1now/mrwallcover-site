---
import facts from '../data/facts.json';
import PhoneReveal from './PhoneReveal.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { areaHref, areas, editorialPages, home, materials, specialismHref, specialisms } from '../lib/content';

/** Every service and material page, generated from content so a new page joins the footer by itself. */
const servicePages = [
  ...specialisms.map((item) => ({ href: specialismHref(item.slug), label: item.name })),
  ...editorialPages.filter((mod) => mod.frontmatter.path.startsWith('/services/')).map((mod) => ({ href: mod.frontmatter.path, label: mod.frontmatter.title })),
];
const materialPages = [
  ...materials.items.map((item) => ({ href: `/materials/${item.slug}/`, label: item.name })),
  ...editorialPages.filter((mod) => mod.frontmatter.path.startsWith('/materials/')).map((mod) => ({ href: mod.frontmatter.path, label: mod.frontmatter.title })),
];
const sentence = (text: string) => text.replace(/^the /, '').replace(/^./, (c) => c.toUpperCase());

const BRAND_NAME = facts.brand;
const FOUNDER_NAME = facts.founder.name;
const PUBLIC_EMAIL = facts.email;
---

<footer class="site-footer">
  <div class="container-page grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="footer-brand">{BRAND_NAME}</p>
      <p class="mt-3 max-w-sm text-stone" data-fact-sheet>{facts.description}</p>
      <p class="mt-4 text-sm tracking-[0.14em] text-brass uppercase">
        {home.pillars.join(' · ')}
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="eyebrow">Visit</p>
      <ul class="m-0 grid list-none gap-1 p-0">
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/projects/#hotels">Hotels</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/materials/">Materials</a></li>
        <li><a href="/professionals/">For professionals</a></li>
        <li><a href="/trade/">Trade and contractors</a></li>
        <li><a href="/services/joinery-wallcoverings-and-panels/">Joinery &amp; bespoke panels</a></li>
        <li><a href="/advice/">Wallcovering Guide</a></li>
        <li><a href="/advice/cost/">Installation cost</a></li>
        <li><a href="/aftercare/">Aftercare</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/faq/">Questions</a></li>
        <li><a href="/areas/">Areas</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/image-use/">Image use</a></li>
        <li><a href="/for-ai/">For AI assistants</a></li>
      </ul>
      <p class="eyebrow mt-6">Areas</p>
      <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-sm">
        {areas.map((area) => (
          <li><a href={areaHref(area.slug)}>{area.name.replace(/^the /, '').replace(/^./, (c) => c.toUpperCase())}</a></li>
        ))}
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="eyebrow">Contact</p>
      <p class="m-0">{FOUNDER_NAME}, founder</p>
      <PhoneReveal wrap="m-0 mt-2" />
      <p class="m-0">
        <a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>
      </p>
      <WhatsAppLink wrap="m-0" />
      {
        facts.profiles.map((profile) => (
          <p class="m-0">
            <a href={profile.url}>{profile.handle ?? profile.name}</a>
          </p>
        ))
      }
    </div>
  </div>
  <nav class="container-page mt-10 grid gap-6 md:grid-cols-2" aria-label="Services and materials">
    <div>
      <p class="eyebrow">Services</p>
      <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-sm">
        {servicePages.map((page) => <li><a href={page.href}>{sentence(page.label)}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Materials</p>
      <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-sm">
        {materialPages.map((page) => <li><a href={page.href}>{sentence(page.label)}</a></li>)}
      </ul>
    </div>
  </nav>
  <div class="container-page mt-10 flex flex-wrap items-center justify-between gap-4 text-sm text-stone">
    <p class="m-0">© {new Date().getFullYear()} {BRAND_NAME}. {FOUNDER_NAME}, founder. {facts.place}.</p>
    {/* Opaque glass, no blur, no transitions. A user-requested preference, so localStorage holds it (the only thing the site stores). */}
    <button class="btn btn-line" type="button" data-effects-toggle aria-pressed="false">Reduce visual effects</button>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-effects-toggle]');
  const reduced = () => document.documentElement.dataset.effects === 'reduced';
  const paint = () => button?.setAttribute('aria-pressed', reduced() ? 'true' : 'false');
  paint();
  button?.addEventListener('click', () => {
    if (reduced()) {
      delete document.documentElement.dataset.effects;
      try { localStorage.removeItem('mw-effects'); } catch {}
    } else {
      document.documentElement.dataset.effects = 'reduced';
      try { localStorage.setItem('mw-effects', 'reduced'); } catch {}
    }
    paint();
  });
</script>
