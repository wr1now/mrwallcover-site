---
import '../styles/footer.css';
import facts from '../data/facts.json';
import PhoneReveal from './PhoneReveal.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import BookCallLink from './BookCallLink.astro';
import Action from './Action.astro';
import Icon from './Icon.astro';
import { BOOKING_URL } from '../config';
import { phoneAvailable } from '../lib/phone';
import { areaHref, areas, editorialPages, home, materials, specialismHref, specialisms } from '../lib/content';

type FooterLink = { href: string; label: string };
const unique = (links: FooterLink[]) => links.filter((link, index) => links.findIndex((item) => item.href === link.href) === index);

/** Published services and materials join the shared directory automatically. */
const servicePages = unique([
  ...specialisms.map((item) => ({ href: specialismHref(item.slug), label: item.name })),
  ...editorialPages.filter((mod) => mod.frontmatter.path.startsWith('/services/')).map((mod) => ({ href: mod.frontmatter.path, label: mod.frontmatter.title })),
]);
const materialPages = unique([
  ...materials.items.map((item) => ({ href: `/materials/${item.slug}/`, label: item.name })),
  ...editorialPages.filter((mod) => mod.frontmatter.path.startsWith('/materials/')).map((mod) => ({ href: mod.frontmatter.path, label: mod.frontmatter.title })),
]);
const installationSlugs = new Set([
  'hand-painted-wallpaper-installation', 'grasscloth-installation', 'silk-wallcovering-installation',
  'fabric-walling', 'mural-installation', 'acoustic-wallcovering-installation',
  'calico-wallpaper-installer', 'house-of-hackney-wallpaper-installer', 'timorous-beasties-installer',
]);
const installation = servicePages.filter((page) => installationSlugs.has(page.href.split('/')[2]));
const specialistWork = servicePages.filter((page) => !installationSlugs.has(page.href.split('/')[2]));
const explore = [
  { href: '/projects/', label: 'Projects' },
  { href: '/projects/#hotels', label: 'Hotels' },
  { href: '/services/', label: 'Services' },
  { href: '/materials/', label: 'Materials' },
  { href: '/professionals/', label: 'For professionals' },
  { href: '/trade/', label: 'Trade and contractors' },
  { href: '/advice/', label: 'Wallcovering Guide' },
  { href: '/where-to-buy/', label: 'Where to buy' },
  { href: '/how-we-check/', label: 'How we check' },
  { href: '/advice/cost/', label: 'Installation cost' },
  { href: '/aftercare/', label: 'Aftercare' },
  { href: '/about/', label: 'About' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/faq/', label: 'Questions' },
  { href: '/areas/', label: 'All areas' },
];
const utility = [
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/image-use/', label: 'Image use' },
  { href: '/for-ai/', label: 'For AI assistants' },
];
const sentence = (text: string) => text.replace(/^the /, '').replace(/^./, (c) => c.toUpperCase());
---

<footer class="site-footer" data-footer>
  <div class="container-page">
    <div class="footer-introduction">
      <div class="footer-practice">
        <p class="footer-brand">{facts.brand}</p>
        <p class="footer-description" data-fact-sheet>{facts.description}</p>
        <p class="footer-workflow">{home.pillars.join(' · ')}</p>
      </div>
      <section class="footer-contact" aria-labelledby="footer-contact-heading">
        <div class="footer-contact-heading">
          <div>
            <h2 id="footer-contact-heading">Start a conversation.</h2>
            <p>{facts.founder.name}, founder</p>
          </div>
          <Action href="/contact/" variant="primary" icon="arrow-right" class="footer-start">Start your project</Action>
        </div>
        <ul class="footer-contact-list">
          <li><a href={`mailto:${facts.email}`}><Icon name="mail" /><span>{facts.email}</span></a></li>
          {phoneAvailable && <li><WhatsAppLink /></li>}
          {BOOKING_URL && <li><BookCallLink><Icon name="calendar" /><span>Book a <span class="whitespace-nowrap">20-minute</span> call</span></BookCallLink></li>}
          {facts.profiles.map((profile) => (
            <li><a href={profile.url}><Icon name="instagram" /><span>{profile.handle ?? profile.name}</span></a></li>
          ))}
          {phoneAvailable && <li class="footer-phone"><Icon name="phone" /><PhoneReveal class="footer-reveal" /></li>}
        </ul>
      </section>
    </div>

    <nav class="footer-directory" aria-label="Footer navigation">
      {/* Open in the server HTML: desktop and no-JavaScript visitors get the full directory.
          The enhancement below collapses these native disclosures on small screens only. */}
      <details class="footer-group footer-explore" open>
        <summary><span>Explore</span><span class="footer-disclosure" aria-hidden="true"></span></summary>
        <div class="footer-group-content footer-explore-columns">
          {[explore.slice(0, 6), explore.slice(6)].map((links) => (
            <ul>{links.map((page) => <li><a href={page.href}>{page.label}</a></li>)}</ul>
          ))}
        </div>
      </details>
      <details class="footer-group footer-expertise" open>
        <summary><span>Expertise</span><span class="footer-disclosure" aria-hidden="true"></span></summary>
        <div class="footer-group-content footer-expertise-columns">
          <div>
            <p class="footer-subheading">Material installation</p>
            <ul>{installation.map((page) => <li><a href={page.href}>{sentence(page.label)}</a></li>)}</ul>
          </div>
          <div>
            <p class="footer-subheading">Specialist work</p>
            <ul>{specialistWork.map((page) => <li><a href={page.href}>{sentence(page.label)}</a></li>)}</ul>
          </div>
        </div>
      </details>
      <details class="footer-group footer-materials" open>
        <summary><span>Materials</span><span class="footer-disclosure" aria-hidden="true"></span></summary>
        <div class="footer-group-content">
          <ul>{materialPages.map((page) => <li><a href={page.href}>{sentence(page.label)}</a></li>)}</ul>
        </div>
      </details>
      <details class="footer-group footer-areas" open>
        <summary><span>Areas</span><span class="footer-disclosure" aria-hidden="true"></span></summary>
        <div class="footer-group-content">
          <ul>{areas.map((area) => <li><a href={areaHref(area.slug)}>{sentence(area.name)}</a></li>)}</ul>
        </div>
      </details>
    </nav>

    <div class="footer-utilities">
      <p class="footer-copyright">© {new Date().getFullYear()} {facts.brand}. {facts.founder.name}, founder. {facts.place}.</p>
      <nav aria-label="Policies and information">
        <ul>{utility.map((page) => <li><a href={page.href}>{page.label}</a></li>)}</ul>
      </nav>
      <button class="btn btn-line footer-effects" type="button" data-effects-toggle aria-pressed="false">Reduce visual effects</button>
    </div>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  const groups = Array.from(footer?.querySelectorAll<HTMLDetailsElement>('.footer-group') ?? []);
  const desktop = window.matchMedia('(min-width: 1024px)');
  const setDirectory = () => groups.forEach((group) => { group.open = desktop.matches; });
  setDirectory();
  desktop.addEventListener('change', setDirectory);
  groups.forEach((group) => {
    group.querySelector('summary')?.addEventListener('click', (event) => {
      // At desktop this is an expanded directory; mobile keeps native interaction.
      if (desktop.matches) event.preventDefault();
    });
  });

  const button = footer?.querySelector<HTMLButtonElement>('[data-effects-toggle]');
  const reduced = () => document.documentElement.dataset.effects === 'reduced';
  const paint = () => button?.setAttribute('aria-pressed', reduced() ? 'true' : 'false');
  paint();
  button?.addEventListener('click', () => {
    if (reduced()) {
      delete document.documentElement.dataset.effects;
      try { localStorage.removeItem('mw-effects'); } catch {}
    } else {
      document.documentElement.dataset.effects = 'reduced';
      try { localStorage.setItem('mw-effects', 'reduced'); } catch {}
    }
    paint();
  });
</script>
