---
/**
 * The visible author line every published page carries.
 *
 * `updated` is an ISO date the page knows for itself (a guide's or case study's
 * frontmatter, stamped from the edit, never the build time) and is shown as
 * "Last updated". `reviewed` shows the site-wide review date from
 * src/data/facts.json as "Last reviewed"; only the AI fact pages (/for-ai/ and
 * /wallcovering-installation-ai-crawler/) set it. Every other page names the
 * author with no date.
 *
 * The <time> element carries data-page-updated so the Markdown twins and
 * llms-full.txt (scripts/build-ai-layer.mjs) read the same date from the HTML;
 * a byline without one is carried there with facts.lastReviewed.
 */
import facts from '../data/facts.json';
import { formatGuideDate } from '../lib/guides';

interface Props {
  updated?: string;
  reviewed?: boolean;
  class?: string;
}

const { updated, reviewed = false, class: className } = Astro.props;
const iso = updated ?? (reviewed ? facts.lastReviewed : undefined);
if (iso !== undefined && !/^\d{4}-\d{2}-\d{2}$/.test(iso)) throw new Error(`PageMeta needs an ISO date, got "${iso}"`);
const label = updated ? 'Last updated' : 'Last reviewed';
const authorHref = `${facts.founder.path}#${facts.founder.fragment}`;
---

{iso ? (
  <p class:list={['page-meta text-sm text-stone', className]}>
    By <a href={authorHref}>{facts.founder.name}</a>, {facts.founder.jobTitle.toLowerCase()} · {label}{' '}
    <time datetime={iso} data-page-updated={updated ? 'updated' : 'reviewed'}>{formatGuideDate(iso)}</time>
  </p>
) : (
  <p class:list={['page-meta text-sm text-stone', className]}>By <a href={authorHref}>{facts.founder.name}</a>, {facts.founder.jobTitle.toLowerCase()}</p>
)}
