---
import Action from './Action.astro';
import Icon, { type IconName } from './Icon.astro';
import DesignObject from './DesignObject.astro';

interface Props {
  items: string[];
  heading?: string;
  icons?: IconName[];
  download?: string;
  downloadLabel?: string;
  guide?: { href: string; label: string };
  id?: string;
  class?: string;
  dimensional?: boolean;
}
const {
  items, heading = 'What to send', icons = ['drawing', 'tag', 'calendar', 'access', 'check'],
  download, downloadLabel, guide, id = 'professional-briefing', class: className, dimensional=false,
} = Astro.props;
---
<aside class:list={['professional-intake professional-briefing', className]} aria-labelledby={id}>
  {dimensional&&<div class="briefing-study"><DesignObject kind="samples" /><p class="briefing-study-caption">Material study · illustrative</p></div>}
  <p class="eyebrow">A useful starting point</p>
  <h2 id={id}>{heading}</h2>
  <ul class="professional-briefing-list">
    {items.map((line, index) => <li><span class="professional-briefing-icon"><Icon name={icons[index] ?? 'drawing'} /></span><span>{line}</span></li>)}
  </ul>
  {download && <>
    <Action variant="secondary" href={download} download icon="download" class="professional-download">{downloadLabel}</Action>
    <p class="professional-download-note">CSV · opens in Excel or Numbers. Leave unknown items blank. This is a planning schedule, not an ordering calculation.</p>
  </>}
  {guide && <p class="professional-guide-link"><a href={guide.href}><Icon name="book" /><span>{guide.label}</span></a></p>}
</aside>

<style>
  .professional-briefing { align-self: start; min-width: 0; padding: clamp(1.25rem, 2.5vw, 1.8rem); }
  .briefing-study { margin:0 auto 1.5rem; max-width:var(--object-card-size); text-align:center; }
  .briefing-study-caption { display:block; margin-top:.3rem; color:var(--color-stone); font-size:var(--text-meta); }
  .professional-briefing h2 { margin: 0; font-size: 2rem; line-height: 1.1; }
  .professional-briefing-list { list-style: none; margin: 1.4rem 0 1.8rem; padding: 0; }
  .professional-briefing-list li { display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: start; gap: .8rem; margin: 0; padding: .9rem 0; border-top: 1px solid var(--color-line); color: var(--color-stone); font-size: var(--text-body); line-height: 1.5; }
  .professional-briefing-icon { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; color: var(--color-brass); }
  .professional-briefing :global(.professional-download) { width: 100%; gap: .6rem; justify-content: center; text-align: center; }
  .professional-download-note { margin: .8rem 0 0; color: var(--color-stone); font-size: var(--text-body); line-height: 1.6; }
  .professional-guide-link { margin: 1.4rem 0 0; }
  .professional-guide-link a { display: inline-flex; align-items: center; min-height: 44px; gap: .65rem; color: var(--color-ink); text-decoration: underline; text-underline-offset: .2em; }
  .professional-guide-link :global(.mw-icon) { color: var(--color-brass); }
</style>
