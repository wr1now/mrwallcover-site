---
/** A schematic explanation of the selected match, never a cutting or ordering calculation. */
const examples = [
  { id: 'free', title: 'Free match', text: 'There is no pattern to line up across the joins. Each length can start independently.', offsets: [0, 0, 0] },
  { id: 'reverse', title: 'Reverse hang', text: 'Alternate lengths turn through 180°. Use this only when the maker asks for it; the arrows show the hanging direction.', offsets: [0, 0, 0] },
  { id: 'straight', title: 'Straight match', text: 'The same point in the design meets at the same height on every length.', offsets: [0, 0, 0] },
  { id: 'half', title: 'Half-drop', text: 'The next length starts half a repeat lower. The third length returns to the first pattern position.', offsets: [0, 24, 0] },
  { id: 'third', title: 'Third drop', text: 'Each next length moves a third of a repeat lower. The pattern returns to its first position on the fourth length.', offsets: [0, 16, 32] },
  { id: 'quarter', title: 'Quarter drop', text: 'Each next length moves a quarter of a repeat lower. The pattern returns to its first position on the fifth length.', offsets: [0, 12, 24] },
];
---
<details class="qc-sub qc-match-guide" data-match-guide>
  <summary>See how the pattern matches</summary>
  <div>
    {examples.map((example) => (
      <figure class="match-example" data-match-example={example.id} hidden={example.id !== 'free'}>
        <svg viewBox="0 0 260 168" aria-hidden="true" focusable="false">
          <defs><clipPath id={`match-${example.id}`}><rect x="25" y="12" width="210" height="132" rx="2" /></clipPath></defs>
          <g clip-path={`url(#match-${example.id})`}>
            <rect class="match-paper" x="25" y="12" width="210" height="132" />
            {example.id === 'free' ? [0,1,2].map((strip) => [0,1,2,3,4].map((line) => <path class="match-texture" d={`M${36+strip*70} ${29+line*24}h45`} />)) : example.id === 'reverse' ? [0,1,2].map((strip) => <g transform={`translate(${60+strip*70} 78) rotate(${strip===1?180:0})`}><path class="match-motif" d="M0 38v-76m-9 10L0-38l9 10" /></g>) : example.offsets.map((offset, strip) => [-1,0,1,2,3].map((repeat) => <path class="match-motif" d={`M${60+strip*70} ${23+repeat*48+offset}l9 12-9 12-9-12Z`} />))}
            <path class="match-seams" d="M95 12v132M165 12v132" />
          </g>
          <path class="match-frame" d="M25 12h210v132H25Z" />
          {[1,2,3].map((n) => <text x={60+(n-1)*70} y="164" text-anchor="middle">{n}</text>)}
        </svg>
        <figcaption><strong>{example.title}</strong><p>{example.text}</p><small>Illustrative · three adjacent lengths, not a cutting plan. Follow the product label.</small></figcaption>
      </figure>
    ))}
  </div>
</details>
<style>
  .match-example { display:grid; grid-template-columns:minmax(0,15rem) minmax(0,1fr); align-items:center; gap:1.5rem; margin:0; padding:1rem 0; }
  .match-example[hidden] { display:none; }
  svg { display:block; width:100%; height:auto; }
  .match-paper { fill:var(--color-panel); }
  .match-frame,.match-seams { fill:none; stroke:var(--color-field-border); stroke-width:1; }
  .match-motif { fill:none; stroke:var(--color-brass); stroke-width:1.6; stroke-linejoin:round; }
  .match-texture { stroke:var(--color-line); stroke-width:2; }
  text { font:16px var(--font-sans); fill:var(--color-stone); }
  figcaption strong { font:500 1.5rem/1.2 var(--font-serif); }
  figcaption p { margin:.5rem 0; font-size:var(--text-body); line-height:1.6; }
  figcaption small { display:block; font-size:var(--text-meta); color:var(--color-stone); line-height:1.5; }
  @media(max-width:47.99rem) { .match-example { grid-template-columns:minmax(0,1fr); gap:1rem; } svg { max-width:15rem; margin-inline:auto; } }
</style>
