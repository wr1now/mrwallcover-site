---
import { altFor, hero } from '../lib/content';
import '../styles/hero-mobile.css';
const srcset = hero.sources.map(source => `${source.src} ${source.width}w`).join(', ');
---
<div class="atelier-hero-media">
  <picture>
    <source type="image/webp" srcset={srcset} sizes="100vw" />
    <img src={hero.fallback} alt={altFor(hero.id)} width={hero.width} height={hero.height} sizes="100vw" fetchpriority="high" decoding="sync" />
  </picture>
</div>
