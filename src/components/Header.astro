---
import Action from './Action.astro';
/**
 * Floating inset champagne-glass header (stage 5, step G5).
 *
 * Desktop: wordmark, then two deliberate rows: the seven primary destinations, optional WhatsApp and the
 * "Start your project" action on one line; the labelled Resources row (navigation.json group "resources")
 * beneath it. Every navigation destination stays visible in the bar; the hierarchy says which ones lead.
 * Phones: wordmark and a disclosure button that opens the mobile menu panel
 * below the bar ("Start your project" is the first dock cell and the last menu
 * link). The panel is a sibling of the header so the bar stays the only glass
 * surface and the panel stays opaque ivory.
 *
 * While a dark band (the olive aftercare and craft bands, the ink band, the
 * material studio stage, the AI Crawler reference page) sits under the bar,
 * the script sets data-over-dark and the bar rises to the more opaque
 * champagne in navigation.css, so it reads ivory rather than grey. The
 * reduced-effects fallbacks in glass.css are opaque already and ignore it.
 *
 * Without JavaScript the panel renders in flow under the bar and the toggle is
 * hidden, so every link stays reachable. Base.astro sets html.js-nav before
 * first paint (no layout shift when this script loads) and removes it on window
 * load unless this script has set data-nav-ready, so a failed module still
 * leaves the links in flow. Once the script runs the panel is
 * a modal dialog (role="dialog", aria-modal, set by the script so the in-flow
 * version stays a plain nav) that works by click, keyboard and touch:
 * Enter/Space toggle, focus moves into the panel on open, Tab cycles through
 * the bar and the panel (the rest of the page is inert), Escape, a close by
 * the toggle, a same-page link or a resize to desktop close it and return
 * focus to the toggle (a link to another page closes it and the page
 * navigates), and the page behind does not scroll while it is open (no layout
 * shift: the scrollbar width is compensated).
 */
import Glass from './Glass.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { navigation } from '../lib/content';

interface Props {
  path: string;
}

const { path } = Astro.props;

function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}

const primary = navigation.filter((item) => item.group !== 'resources');
const resources = navigation.filter((item) => item.group === 'resources');
// On /contact/ itself the Start links jump to the form instead of reloading the page.
const startHref = path.replace(/\/?$/, '/') === '/contact/' ? '#enquiry' : '/contact/';
---

<Glass element="header" variant="champagne" class="site-header" data-site-header>
  <div class="site-header-row">
    <a class="wordmark" href="/" title="Home">
      <em>Mr</em>Wallcover
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <div class="header-main">
        <div class="header-nav-links">
          {primary.map(item => <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </div>
        <WhatsAppLink class="nav-link" icon />
        <Action class="header-action" href={startHref}>Start your project</Action>
      </div>
      {resources.length > 0 && (
        <div class="header-resources" role="group" aria-labelledby="nav-resources-label">
          <span class="header-resources-label" id="nav-resources-label">Resources</span>
          {resources.map(item => <a class="nav-link nav-link--resource" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </div>
      )}
    </nav>
    <div class="header-mobile">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="open-label">Menu</span>
        <span class="close-label">Close</span>
      </button>
    </div>
  </div>
</Glass>
<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <nav class="mobile-links" aria-label="Mobile">
    {primary.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    {resources.length > 0 && (
      <div role="group" aria-labelledby="mobile-resources-label">
        <p class="mobile-links-label" id="mobile-resources-label">Resources</p>
        {resources.map(item => <a class="mobile-link--resource" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </div>
    )}
    <a class="mobile-link--start" href={startHref}>Start your project</a>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const desktop = window.matchMedia('(min-width: 1280px)');
  const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
  let open = false;

  if (toggle && panel) {
    // The script is live: hide the in-flow panel, show the toggle (navigation.css keys on html.js-nav), and give the panel dialog semantics.
    document.documentElement.classList.add('js-nav');
    document.documentElement.setAttribute('data-nav-ready', '');
    panel.setAttribute('role', 'dialog');
    panel.setAttribute('aria-modal', 'true');
    panel.setAttribute('aria-label', 'Menu');
  }

  /** Everything in <body> except the bar and the panel: made inert while the menu is open. */
  const others = () => Array.from(document.body.children).filter((el) => el !== header && el !== panel);

  function setOpen(next: boolean, returnFocus = false) {
    if (!toggle || !panel || next === open) return;
    open = next;
    const root = document.documentElement;
    toggle.setAttribute('aria-expanded', String(next));
    panel.classList.toggle('is-open', next);
    if (next) {
      root.style.setProperty('--scrollbar-comp', `${window.innerWidth - root.clientWidth}px`);
      root.classList.add('nav-open');
      document.body.classList.add('nav-open');
      others().forEach((el) => el.setAttribute('inert', ''));
      requestAnimationFrame(() => panel.querySelector<HTMLElement>(FOCUSABLE)?.focus());
    } else {
      root.classList.remove('nav-open');
      document.body.classList.remove('nav-open');
      others().forEach((el) => el.removeAttribute('inert'));
      if (returnFocus) toggle.focus();
    }
  }

  toggle?.addEventListener('click', () => setOpen(!open, open));
  panel?.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link) return;
    // A same-page target (current page, a hash, tel: or mailto:) does not unload the document, so focus must come back to the toggle.
    const href = link.getAttribute('href') || '';
    const url = new URL(link.href, location.href);
    const staysOnPage = /^(tel|mailto):/.test(href) || (url.origin === location.origin && url.pathname === location.pathname);
    setOpen(false, staysOnPage);
  });
  document.addEventListener('keydown', (event) => {
    if (!open || !header || !panel) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setOpen(false, true);
      return;
    }
    if (event.key !== 'Tab') return;
    const items = [...header.querySelectorAll<HTMLElement>(FOCUSABLE), ...panel.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => el.offsetParent !== null);
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    } else if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    }
  });
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false, true);
  });

  // The observer's root is the strip of viewport the bar covers, so data-over-dark is set only while a dark band is under the bar.
  const darkBands = document.querySelectorAll<HTMLElement>('.home-aftercare, .atelier-craft, .band-dark, .studio-stage, .crawler-page');
  if (header && darkBands.length && 'IntersectionObserver' in window) {
    const under = new Set<Element>();
    let observer: IntersectionObserver | undefined;
    const watch = () => {
      observer?.disconnect();
      under.clear();
      const strip = Math.ceil(header.getBoundingClientRect().bottom);
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => (entry.isIntersecting ? under.add(entry.target) : under.delete(entry.target)));
        header.toggleAttribute('data-over-dark', under.size > 0);
      }, { rootMargin: `0px 0px ${strip - window.innerHeight}px 0px` });
      darkBands.forEach((band) => observer!.observe(band));
    };
    watch();
    window.addEventListener('resize', watch, { passive: true });
  }
</script>
