---
import { media } from '../lib/content';
import { pictureSources } from '../lib/picture';
import placeholders from '../content/placeholders.json';
import creditedMedia from '../content/credited-media.json';

interface Props {
  id: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  thumbOnly?: boolean;
}

const {
  id,
  sizes = '(min-width: 1024px) 40rem, 100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
  thumbOnly = false,
} = Astro.props;

const img = media(id);
const placeholder =
  (placeholders as Record<string, string>)[id] ?? (creditedMedia as Record<string, { placeholder?: string }>)[id]?.placeholder ?? '';
const useFull = img.hasFull && !thumbOnly;
/* Images cut from full-size originals carry an AVIF + WebP set; the browser picks the width from `sizes`. */
const variants = img.variants;
const [first, second] = pictureSources(id, thumbOnly);
const fallbackWidth = variants ? (variants.widths.find((w) => w >= 800) ?? variants.widths[variants.widths.length - 1]) : 0;
---

<span class="media-frame" style={placeholder ? `background-image:url(${placeholder})` : undefined}>
  <picture>
    <source type={first.type} srcset={first.srcset} sizes={sizes} />
    <source type={second.type} srcset={second.srcset} sizes={sizes} />
    <img
      class:list={['media-img', className]}
      src={variants ? `${variants.base}-${fallbackWidth}.webp` : useFull ? img.jpg : img.thumbJpg}
      alt={img.alt}
      width={img.width}
      height={img.height}
      sizes={sizes}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority === 'auto' ? undefined : fetchpriority}
    />
  </picture>
</span>
