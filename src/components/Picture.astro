---
import { media } from '../lib/content';
import placeholders from '../content/placeholders.json';

interface Props {
  id: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  thumbOnly?: boolean;
}

const {
  id,
  sizes = '(min-width: 1024px) 40rem, 100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
  thumbOnly = false,
} = Astro.props;

const img = media(id);
const placeholder = (placeholders as Record<string, string>)[id] ?? '';
const useFull = img.hasFull && !thumbOnly;
const webp = useFull ? `${img.thumb} ${img.thumbWidth}w, ${img.src} ${img.width}w` : `${img.thumb} ${img.thumbWidth}w`;
const jpeg = useFull
  ? `${img.thumbJpg} ${img.thumbWidth}w, ${img.jpg} ${img.width}w`
  : `${img.thumbJpg} ${img.thumbWidth}w`;
---

<span class="media-frame" style={placeholder ? `background-image:url(${placeholder})` : undefined}>
  <picture>
    <source type="image/webp" srcset={webp} sizes={sizes} />
    <source type="image/jpeg" srcset={jpeg} sizes={sizes} />
    <img
      class:list={['media-img', className]}
      src={useFull ? img.jpg : img.thumbJpg}
      alt={img.alt}
      width={img.width}
      height={img.height}
      sizes={sizes}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority === 'auto' ? undefined : fetchpriority}
    />
  </picture>
</span>
