---
/**
 * The standard "At a glance" box (src/lib/glance.ts): seven fields, always in the same order.
 * A field the case study does not record shows a dash, with "Not recorded" for screen readers.
 */
import { glanceRows, type GlanceSource } from '../lib/glance';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  study: GlanceSource;
}

const rows = glanceRows(Astro.props.study);
const icons: IconName[] = ['room', 'drawing', 'tools', 'swatch', 'ruler', 'layers', 'calendar'];
---

<section class="glance-box" aria-labelledby="glance-heading" data-glance>
  <h2 id="glance-heading" class="eyebrow m-0">At a glance</h2>
  <details class="glance-disclosure">
  <summary>Client, materials &amp; project facts</summary>
  <dl class="glance-list">
    {rows.map((row, index) => (
      <div>
        <dt><Icon name={icons[index]} />{row.label}</dt>
        <dd>{row.value ?? <><span aria-hidden="true">–</span><span class="sr-only">Not recorded</span></>}</dd>
      </div>
    ))}
  </dl>
  </details>
</section>

<style>
  .glance-box { min-width: 0; margin: 0; padding: clamp(1.25rem, 2vw, 1.75rem); background: var(--color-ivory-deep); border: 1px solid var(--color-line); border-radius: var(--radius-control); }
  .glance-disclosure { margin-top:.75rem; }
  .glance-disclosure > summary { min-height:44px; cursor:pointer; line-height:1.6; }
  .glance-disclosure[open] > summary { margin-bottom:1rem; }
  @media print {
    .glance-disclosure::details-content { content-visibility:visible; block-size:auto; }
    .glance-disclosure:not([open]) > dl { display:grid; }
  }
  .glance-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.5rem; margin-top: 1rem; }
  .glance-list > div { min-width: 0; padding-block: 1rem; border-top: 1px solid var(--color-line); gap: .5rem; }
  .glance-list > div:last-child { grid-column: 1 / -1; }
  .glance-list dt { align-items: flex-start; line-height: 1.5; }
  .glance-list dt :global(.mw-icon) { flex: 0 0 1.1rem; margin-top: .1rem; }
  .glance-list dd { line-height: 1.6; overflow-wrap: break-word; }
  @media (min-width: 1024px) {
    .glance-list { grid-template-columns: minmax(0, 1fr); }
    .glance-list > div { grid-column: auto; }
  }
</style>
