---
import '../styles/global.css';
import { ANALYTICS_SRC, BRAND_NAME, GOOGLE_SITE_VERIFICATION, SITE_URL } from '../config';
import { CONTACT_PAYLOAD } from '../lib/phone';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileDock from '../components/MobileDock.astro';
import { businessNode, founderNode, jsonLd, webPageNode, websiteNode } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  extraSchema?: object[];
  preloadHero?: boolean;
  /** Site-relative JPEG for social cards. Defaults to /og.jpg. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  author?: string;
}

const {
  title,
  description,
  path,
  noindex: requestedNoindex = false,
  extraSchema = [],
  preloadHero = false,
  image: imagePath,
  imageAlt = "Corridor at Brown's Hotel, Mayfair, for Mr Wallcover.",
  ogType = 'website',
  author = 'Dorin Burcus',
} = Astro.props;
const reviewBuild = import.meta.env.MW_CONTENT_PREVIEW === '1';
const noindex = requestedNoindex || reviewBuild;
const canonical = new URL(path, SITE_URL).href;
const image = new URL(imagePath ?? '/og.jpg', SITE_URL).href;
const schema = jsonLd([
  businessNode(),
  founderNode(),
  websiteNode(),
  webPageNode({ url: canonical, name: title, description, image }),
  ...extraSchema,
]);
const heroSrcset =
  '/media/hero/corridor-640.webp 640w, /media/hero/corridor-960.webp 960w, /media/hero/corridor-1280.webp 1280w, /media/hero/corridor-1920.webp 1920w';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (localStorage.getItem('mw-effects') === 'plain') document.documentElement.dataset.effects = 'plain';
      } catch (e) {}
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title={`${BRAND_NAME}: guides and case studies`} />
    {/* The Markdown twin scripts/build-ai-layer.mjs writes next to every published page after the build. Noindex pages have none. */}
    {!noindex && <link rel="alternate" type="text/markdown" href={`${canonical}index.md`} title="Markdown version" />}
    <meta name="theme-color" content="#141210" />
    <meta name="author" content={author} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {!imagePath && <meta property="og:image:width" content="1200" />}
    {!imagePath && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href="/media/hero/corridor-960.webp"
          imagesrcset={heroSrcset}
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <script type="application/ld+json" set:html={schema} />
    <!-- Cookie-free analytics placeholder. No script loads, and the site sets no cookies, unless PUBLIC_ANALYTICS_SRC is set at build time. -->
    {ANALYTICS_SRC && <script is:inline defer src={ANALYTICS_SRC}></script>}
  </head>
  <body class:list={[path === '/' && 'is-home']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={Astro.url.pathname} />
    <main id="main">
      {reviewBuild && <div class="review-banner" role="note">Content review preview · Guide drafts await technical review.</div>}
      <slot />
    </main>
    <Footer />
    <MobileDock />
    {CONTACT_PAYLOAD && (
      <script is:inline define:vars={{ payload: CONTACT_PAYLOAD }}>
        (function () {
          let c;
          try { c = JSON.parse(atob(payload).split('').reverse().join('')); } catch (e) { return; }
          document.querySelectorAll('a[data-wa]').forEach((a) => { a.href = c.w; a.rel = 'noopener'; });
          document.addEventListener('click', (event) => {
            const btn = event.target.closest && event.target.closest('[data-phone-reveal]');
            if (!btn) return;
            event.preventDefault();
            const a = document.createElement('a');
            a.href = 'tel:' + c.t;
            a.textContent = (btn.getAttribute('data-prefix') || '') + c.d;
            a.className = btn.className;
            btn.replaceWith(a);
            a.focus();
          });
        })();
      </script>
    )}
    <script is:inline>
      function markReady(img) {
        if (img && img.classList && img.classList.contains('media-img')) img.classList.add('is-ready');
      }
      document.addEventListener('load', (event) => markReady(event.target), true);
      document.querySelectorAll('img.media-img').forEach((img) => {
        if (img.complete && img.naturalWidth > 0) img.classList.add('is-ready');
      });
    </script>
  </body>
</html>
