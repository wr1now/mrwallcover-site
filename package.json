{
  "name": "mrwallcover",
  "type": "module",
  "version": "1.0.0",
  "description": "Mr Wallcover, London wallcovering practice. Static Astro site for www.mrwallcover.com.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/import-credited.mjs --build",
    "build": "astro build",
    "postbuild": "node scripts/build-ai-layer.mjs dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node --experimental-strip-types --test tests/quantity.test.ts tests/enquiry.test.ts tests/leads-api.test.ts tests/content-guards.test.ts tests/phone.test.ts tests/material-advice.test.ts tests/contrast.test.ts",
    "check:dist": "node --experimental-strip-types --test tests/dist-guards.test.ts tests/ai-layer.test.ts tests/glass-system.test.ts",
    "check:phone": "node --experimental-strip-types --test tests/phone-build.test.ts",
    "lead-api": "LEAD_API_ENABLED=1 node --experimental-strip-types server/index.ts",
    "build:review": "npm run prebuild && MW_CONTENT_PREVIEW=1 astro build --outDir dist-review",
    "preview:review": "astro preview --outDir dist-review",
    "check:guides": "node --experimental-strip-types --test tests/guide-build.test.ts",
    "indexnow": "node scripts/indexnow-ping.mjs dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5"
  }
}
