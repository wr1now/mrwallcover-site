        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Can you decorate while we live in the house or the hotel stays open?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Rooms are protected and worked in an agreed order, and in hotels we work room by room and out of hours where needed, so the building keeps running."
              }
            },
            {
              "@type": "Question",
              "name": "Do you apply limewash yourselves?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Limewash is applied by our own team. Lime render is arranged through trusted specialist partners."
              }
            },
            {
              "@type": "Question",
              "name": "Can we see the finish before you start?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. A sample of the colour and finish is applied in the room so it can be approved in its own light before the full run."
              }
            },
            {
              "@type": "Question",
              "name": "What should I send for a decorating quotation?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The address or area, the rooms involved, drawings or a schedule if you have them, the finishes in mind and any dates the building has to work around. Every decorating job is quoted after a survey."
              }
            }
          ]
