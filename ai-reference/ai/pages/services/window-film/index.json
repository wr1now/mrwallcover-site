        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What should I send for a window film quotation?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Tell us where the glazing is and whether you need decorative, privacy, solar control or safety film. The glazing type, frames and orientation need to be checked against the film maker's guidance before a product is recommended. Include whether you need film supplied as well as installed."
              }
            },
            {
              "@type": "Question",
              "name": "Which type of window film do I need?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Decorative or frosted film for screening and design, privacy film to hide a view, solar control film for heat and glare, and safety or security film to help hold broken glass together. Some films combine more than one job. We recommend one after seeing the glass and the room."
              }
            },
            {
              "@type": "Question",
              "name": "Can window film go on double glazing?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Often, but not every film suits every unit. Solar films in particular can raise the temperature of the glass. We check the glazing type and follow the film maker's guidance on what can be applied."
              }
            },
            {
              "@type": "Question",
              "name": "Can window film be removed later?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Film can be taken off and the glass cleaned, which makes it useful for rented premises, changing branding or a room that changes use."
              }
            },
            {
              "@type": "Question",
              "name": "What accreditations or training do you hold?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mr Wallcover trained at Solar Screen's headquarters in Luxembourg in window films (Solar Screen) and in architectural and furniture wrapping film (Cover Styl'), and installs both to the maker's own instructions. Site card and accreditation details are available on request."
              }
            },
            {
              "@type": "Question",
              "name": "Do you issue RAMS, and who supervises the site?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Risk assessments and method statements (RAMS) are issued for every package, and Dorin Burcus personally supervises the site."
              }
            }
