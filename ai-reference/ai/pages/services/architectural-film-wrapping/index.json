          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What should I send for an architectural film quotation?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Identify the doors, joinery, lifts, counters or furniture to be wrapped and the finish you have in mind. The survey checks the condition of the existing surface and plans the edges, corners and returns. A sample on a real door or panel lets the finish, edges and colour be agreed before the full run is ordered."
              }
            },
            {
              "@type": "Question",
              "name": "What can architectural film be applied to?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Most smooth, sound and non-porous surfaces: painted or laminated doors, joinery, MDF, metal, lift interiors, counters and furniture. The surface is checked at the survey. Where it is flaking, damp or very textured, it needs work first, and we say so."
              }
            },
            {
              "@type": "Question",
              "name": "Can film wrapping be done while a hotel or office stays open?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Usually, yes. There is no spraying and little dust or smell, so work can go room by room or floor by floor, and each area can be handed back as it is finished."
              }
            },
            {
              "@type": "Question",
              "name": "Can we see the finish before committing?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. We apply a sample on a real door or panel so the finish, the edges and the colour can be approved in the room's own light before the full run is ordered."
              }
            },
            {
              "@type": "Question",
              "name": "What accreditations or training do you hold?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mr Wallcover trained at Solar Screen's headquarters in Luxembourg in window films (Solar Screen) and in architectural and furniture wrapping film (Cover Styl'), and installs both to the maker's own instructions. Site card and accreditation details are available on request."
              }
            },
            {
              "@type": "Question",
              "name": "Do you issue RAMS, and who supervises the site?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Risk assessments and method statements (RAMS) are issued for every package, and Dorin Burcus personally supervises the site."
              }
            }
